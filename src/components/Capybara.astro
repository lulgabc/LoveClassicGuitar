---
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<svg
  class={`mascot mascot-capy ${className}`}
  viewBox="0 0 380 330"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id="capy-fur" x1="110" y1="40" x2="260" y2="300" gradientUnits="userSpaceOnUse">
      <stop stop-color="#D3A174"></stop>
      <stop offset="1" stop-color="#A96843"></stop>
    </linearGradient>
    <linearGradient id="capy-muzzle" x1="150" y1="105" x2="220" y2="200" gradientUnits="userSpaceOnUse">
      <stop stop-color="#EDC49C"></stop>
      <stop offset="1" stop-color="#D8A276"></stop>
    </linearGradient>
    <linearGradient id="guitar-wood" x1="-55" y1="-60" x2="62" y2="120" gradientUnits="userSpaceOnUse">
      <stop stop-color="#F7C57D"></stop>
      <stop offset="0.55" stop-color="#E49A50"></stop>
      <stop offset="1" stop-color="#BD6E34"></stop>
    </linearGradient>
    <linearGradient id="guitar-neck" x1="-18" y1="-180" x2="20" y2="-70" gradientUnits="userSpaceOnUse">
      <stop stop-color="#805A3A"></stop>
      <stop offset="1" stop-color="#4E3321"></stop>
    </linearGradient>
    <filter id="capy-soft" x="0" y="10" width="380" height="320" filterUnits="userSpaceOnUse">
      <feDropShadow dx="0" dy="10" stdDeviation="10" flood-color="#3A205B" flood-opacity="0.2"></feDropShadow>
    </filter>
  </defs>

  <ellipse cx="194" cy="311" rx="132" ry="15" fill="#3A205B" opacity="0.14"></ellipse>

  <g filter="url(#capy-soft)" class="capy-body">
    <path
      d="M92 250c-16-45 4-75 39-79 8-2 14-6 19-12 10-13 31-19 49-19s42 8 50 23c8 14 20 22 38 28 34 11 49 37 37 76-12 37-47 50-104 50-62 0-113-25-128-67Z"
      fill="url(#capy-fur)"
      stroke="#7E4B31"
      stroke-width="4"
    ></path>
    <path
      d="M116 292c-18-17-30-28-28-42 3-18 27-23 44-12 14 9 22 30 9 52"
      fill="#B97750"
      stroke="#7E4B31"
      stroke-width="4"
    ></path>
    <ellipse cx="278" cy="300" rx="42" ry="16" fill="#A96843" stroke="#7E4B31" stroke-width="4"></ellipse>
    <ellipse cx="144" cy="303" rx="43" ry="16" fill="#B97750" stroke="#7E4B31" stroke-width="4"></ellipse>

    <g class="capy-head">
      <ellipse cx="105" cy="68" rx="24" ry="20" fill="#B97750" stroke="#7E4B31" stroke-width="4"></ellipse>
      <ellipse cx="105" cy="68" rx="12" ry="10" fill="#E8B28B"></ellipse>
      <ellipse cx="274" cy="68" rx="24" ry="20" fill="#B97750" stroke="#7E4B31" stroke-width="4"></ellipse>
      <ellipse cx="274" cy="68" rx="12" ry="10" fill="#E8B28B"></ellipse>

      <rect x="89" y="35" width="202" height="174" rx="82" fill="url(#capy-fur)" stroke="#7E4B31" stroke-width="4"></rect>
      <ellipse cx="190" cy="154" rx="77" ry="52" fill="url(#capy-muzzle)"></ellipse>

      <g class="capy-eye">
        <ellipse cx="153" cy="109" rx="9" ry="11" fill="#3B2A22"></ellipse>
        <circle cx="156" cy="105" r="3.2" fill="#FFF9F1"></circle>
      </g>
      <g class="capy-eye capy-eye-right">
        <ellipse cx="228" cy="109" rx="9" ry="11" fill="#3B2A22"></ellipse>
        <circle cx="231" cy="105" r="3.2" fill="#FFF9F1"></circle>
      </g>

      <path d="M145 128c4-4 10-4 14 0M228 128c4-4 10-4 14 0" stroke="#8C5A3B" stroke-width="3" stroke-linecap="round"></path>
      <ellipse cx="127" cy="146" rx="16" ry="8" fill="#EE9F9E" opacity="0.45"></ellipse>
      <ellipse cx="253" cy="146" rx="16" ry="8" fill="#EE9F9E" opacity="0.45"></ellipse>

      <path
        d="M172 145c0-10 36-10 36 0 0 9-9 15-18 15s-18-6-18-15Z"
        fill="#7A503E"
        stroke="#5E3B2E"
        stroke-width="2.5"
      ></path>
      <path
        d="M190 160v6M190 166c-8 10-19 9-24 2M190 166c8 10 19 9 24 2"
        stroke="#5E3B2E"
        stroke-width="3"
        stroke-linecap="round"
      ></path>

      <path
        d="m258 54 3.5 7.1 7.8 1.1-5.6 5.5 1.3 7.8-7-3.6-7 3.6 1.3-7.8-5.6-5.5 7.8-1.1 3.5-7.1Z"
        fill="#FFD86F"
        stroke="#A86C28"
        stroke-width="2.4"
      ></path>
      <circle cx="270" cy="78" r="4" fill="#FFB2DE"></circle>
      <circle cx="261" cy="83" r="3" fill="#C6B6FF"></circle>
    </g>

    <g transform="translate(206 230) rotate(50)" class="capy-guitar">
      <rect x="-22" y="-158" width="44" height="106" rx="8" fill="url(#guitar-neck)" stroke="#542F1D" stroke-width="3"></rect>
      <rect x="-18" y="-154" width="36" height="96" rx="3" fill="#3F291D"></rect>
      <path d="M-3-188h-20a14 14 0 0 0-14 14v34a14 14 0 0 0 14 14h20" fill="#69442B" stroke="#542F1D" stroke-width="3"></path>
      <path d="M3-188h20a14 14 0 0 1 14 14v34a14 14 0 0 1-14 14H3" fill="#69442B" stroke="#542F1D" stroke-width="3"></path>
      <circle cx="-32" cy="-169" r="6" fill="#F4D79E" stroke="#4B3021" stroke-width="2"></circle>
      <circle cx="-32" cy="-145" r="6" fill="#F4D79E" stroke="#4B3021" stroke-width="2"></circle>
      <circle cx="32" cy="-169" r="6" fill="#F4D79E" stroke="#4B3021" stroke-width="2"></circle>
      <circle cx="32" cy="-145" r="6" fill="#F4D79E" stroke="#4B3021" stroke-width="2"></circle>

      <path
        d="M0-68c35 0 58 23 55 54-2 19-13 32-27 42 24 10 38 31 33 56-6 29-31 45-61 45s-55-16-61-45c-5-25 9-46 33-56-14-10-25-23-27-42-3-31 20-54 55-54Z"
        fill="url(#guitar-wood)"
        stroke="#9B572C"
        stroke-width="4"
      ></path>
      <path
        d="M0-59c30 0 49 19 46 45-2 16-11 26-23 35 20 8 32 26 28 47-5 24-26 38-51 38s-46-14-51-38c-4-21 8-39 28-47-12-9-21-19-23-35-3-26 16-45 46-45Z"
        stroke="#FAD79E"
        stroke-width="2"
        stroke-dasharray="5 7"
        opacity="0.8"
      ></path>
      <circle cx="0" cy="24" r="22" fill="#513026" stroke="#F8D49C" stroke-width="4"></circle>
      <circle cx="0" cy="24" r="13" fill="#2F1C18"></circle>
      <circle cx="0" cy="24" r="26" stroke="#F8D49C" stroke-width="1.5" stroke-dasharray="3 4"></circle>
      <rect x="-27" y="78" width="54" height="13" rx="5" fill="#6E422A" stroke="#4E2E1E" stroke-width="2"></rect>
      <rect x="-20" y="82" width="40" height="4" rx="2" fill="#F0D5A4"></rect>

      <g stroke="#FFF4D7" stroke-width="1.5" opacity="0.9">
        <path d="M-18-205v270"></path>
        <path d="M-10.8-205v270"></path>
        <path d="M-3.6-205v270"></path>
        <path d="M3.6-205v270"></path>
        <path d="M10.8-205v270"></path>
        <path d="M18-205v270"></path>
      </g>
      <g fill="#E9D9B7">
        <rect x="-19" y="-119" width="38" height="3" rx="1"></rect>
        <rect x="-19" y="-95" width="38" height="3" rx="1"></rect>
        <rect x="-19" y="-71" width="38" height="3" rx="1"></rect>
      </g>
      <path
        d="m-28 51 3 6 6.7.8-4.9 4.6 1.2 6.6-6-3.2-6 3.2 1.2-6.6-4.9-4.6 6.7-.8 3-6Z"
        fill="#FFF4D7"
        opacity="0.88"
      ></path>
    </g>

    <path
      d="M124 234c-15 17-13 39 10 54 10 6 20 9 31 10"
      stroke="#B97750"
      stroke-width="30"
      stroke-linecap="round"
    ></path>
    <path
      d="M286 231c15 18 9 38-13 50-9 5-18 7-27 8"
      stroke="#B97750"
      stroke-width="30"
      stroke-linecap="round"
    ></path>
    <ellipse cx="171" cy="297" rx="20" ry="15" fill="#D3A174" stroke="#7E4B31" stroke-width="3"></ellipse>
    <ellipse cx="245" cy="292" rx="19" ry="14" fill="#D3A174" stroke="#7E4B31" stroke-width="3"></ellipse>

    <path d="M318 282c19-9 30 5 23 20-5 10-18 14-30 8" fill="#B97750" stroke="#7E4B31" stroke-width="4"></path>
  </g>

  <g fill="#FFD86F">
    <path d="m47 63 3.2 6.4 7 .9-5.1 4.9 1.3 7-6.4-3.3-6.3 3.3 1.2-7-5.1-4.9 7-.9L47 63Z" opacity="0.9"></path>
    <circle cx="329" cy="145" r="4" fill="#BDEBFF"></circle>
    <circle cx="68" cy="152" r="3" fill="#FFB2DE"></circle>
  </g>
</svg>

<style>
  .mascot-capy {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .capy-head {
    transform-box: fill-box;
    transform-origin: center bottom;
    animation: capy-nod 5.5s ease-in-out infinite;
  }

  .capy-eye {
    transform-box: fill-box;
    transform-origin: center;
    animation: capy-blink 6.8s ease-in-out infinite;
  }

  .capy-eye-right {
    animation-delay: 0.08s;
  }

  @keyframes capy-nod {
    0%,
    100% {
      transform: rotate(0deg);
    }
    50% {
      transform: rotate(-1.2deg);
    }
  }

  @keyframes capy-blink {
    0%,
    91%,
    100% {
      transform: scaleY(1);
    }
    94% {
      transform: scaleY(0.1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .capy-head,
    .capy-eye {
      animation: none;
    }
  }
</style>
