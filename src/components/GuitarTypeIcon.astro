      <circle cx="80" cy="182" r="16" fill="#3A1E16"></circle>
      <circle cx="80" cy="182" r="21" stroke={p.accent} stroke-width="1.5" stroke-dasharray="2 4" opacity="0.8"></circle>
      <rect x="58" y="214" width="44" height="8" rx="3" fill={p.dark}></rect>
      <g stroke="#FFF6E0" stroke-width="1.3" opacity="0.9">
        {strings.map((i) => <path d={`M${74 + i * 2.4} 44L${62 + i * 7.2} 218`} />)}
      </g>
      <circle cx="63" cy="18" r="2.2" fill={p.accent} stroke="none"></circle>
      <circle cx="63" cy="29" r="2.2" fill={p.accent} stroke="none"></circle>
      <circle cx="63" cy="40" r="2.2" fill={p.accent} stroke="none"></circle>
      <circle cx="97" cy="18" r="2.2" fill={p.accent} stroke="none"></circle>
      <circle cx="97" cy="29" r="2.2" fill={p.accent} stroke="none"></circle>
      <circle cx="97" cy="40" r="2.2" fill={p.accent} stroke="none"></circle>
    </g>
  )}

  {type === "acoustic" && (
    <g stroke={p.edge} stroke-width="3" stroke-linejoin="round">
      <rect x="64" y="10" width="32" height="30" rx="5" fill={p.dark}></rect>
      <rect x="72" y="40" width="16" height="56" fill={p.dark}></rect>
      <path d="M80 94C56 94 40 106 36 126C33 142 40 154 52 162C38 172 30 190 33 210C36 228 54 238 80 238C106 238 124 228 127 210C130 190 122 172 108 162C120 154 127 142 124 126C120 106 104 94 80 94Z" fill={p.body}></path>
