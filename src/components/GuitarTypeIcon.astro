---
import type { GuitarType } from "../data/basics";

interface Props {
  type: GuitarType["id"];
}

const { type } = Astro.props;

const palette = {
  classical: { body: "#F4C57B", edge: "#A96832", dark: "#3A2015", accent: "#FFE7A8" },
  acoustic: { body: "#E8A45A", edge: "#95552A", dark: "#2F1A12", accent: "#FFE7A8" },
  electric: { body: "#7C5CFF", edge: "#3C2A99", dark: "#241A4D", accent: "#FFD86F" },
  jazz: { body: "#C05A3A", edge: "#6E2E1E", dark: "#2B1611", accent: "#FFD86F" },
  bass: { body: "#3FBF9F", edge: "#1D6B57", dark: "#102E27", accent: "#FFD86F" },
  flamenco: { body: "#E85A4F", edge: "#8F2F2A", dark: "#2B1210", accent: "#FFE7A8" },
} as const;

const p = palette[type];
const strings = [0, 1, 2, 3, 4, 5];
---

<svg class="guitar-type-icon" viewBox="0 0 160 246" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <ellipse cx="80" cy="238" rx="46" ry="5" fill="#2A1A2F" opacity="0.12"></ellipse>

  {type === "classical" && (
    <g stroke={p.edge} stroke-width="3" stroke-linejoin="round">
      <rect x="68" y="10" width="24" height="34" rx="6" fill={p.dark}></rect>
      <rect x="73" y="14" width="5" height="26" rx="2.5" fill="#1E1210" stroke="none"></rect>
      <rect x="82" y="14" width="5" height="26" rx="2.5" fill="#1E1210" stroke="none"></rect>
      <rect x="72" y="42" width="16" height="54" fill={p.dark}></rect>
