        <circle cx="64" cy="192" r="3"></circle><circle cx="76" cy="192" r="3"></circle><circle cx="88" cy="192" r="3"></circle>
      </g>
      <g stroke="#FFF6E0" stroke-width="1.2" opacity="0.9">
        {strings.map((i) => <path d={`M${74 + i * 2.4} 42L${60 + i * 8} 202`} />)}
      </g>
      <g fill={p.accent} stroke="none">
        <circle cx="58" cy="17" r="2.4"></circle><circle cx="58" cy="29" r="2.4"></circle><circle cx="58" cy="41" r="2.4"></circle>
        <circle cx="102" cy="17" r="2.4"></circle><circle cx="102" cy="29" r="2.4"></circle><circle cx="102" cy="41" r="2.4"></circle>
      </g>
    </g>
  )}

  {type === "jazz" && (
    <g stroke={p.edge} stroke-width="3" stroke-linejoin="round">
      <rect x="64" y="10" width="32" height="30" rx="5" fill={p.dark}></rect>
      <rect x="72" y="40" width="16" height="54" fill={p.dark}></rect>
      <path d="M80 94C56 94 40 106 36 128C33 148 40 162 52 170C38 180 30 198 34 214C38 230 56 238 80 238C104 238 122 230 126 214C130 198 122 180 108 170C120 162 127 148 124 128C120 106 104 94 80 94Z" fill={p.body}></path>
      <ellipse cx="80" cy="170" rx="32" ry="48" fill="#F0B06A" opacity="0.22" stroke="none"></ellipse>
      <path d="M56 148c-7 10-7 27 0 37M104 148c7 10 7 27 0 37" stroke={p.dark} stroke-width="3" fill="none"></path>
      <circle cx="56" cy="148" r="3" fill={p.dark} stroke="none"></circle>
      <circle cx="56" cy="185" r="3" fill={p.dark} stroke="none"></circle>
