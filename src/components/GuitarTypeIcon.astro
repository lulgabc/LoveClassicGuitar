      <g fill={p.accent} stroke="none">
        <circle cx="58" cy="17" r="2.4"></circle><circle cx="58" cy="29" r="2.4"></circle><circle cx="58" cy="41" r="2.4"></circle>
        <circle cx="102" cy="17" r="2.4"></circle><circle cx="102" cy="29" r="2.4"></circle><circle cx="102" cy="41" r="2.4"></circle>
      </g>
    </g>
  )}

  {type === "bass" && (
    <g stroke={p.edge} stroke-width="3" stroke-linejoin="round">
      <rect x="66" y="8" width="28" height="34" rx="5" fill={p.dark}></rect>
      <rect x="72" y="42" width="16" height="86" fill={p.dark}></rect>
      <path d="M80 122C58 122 40 134 36 156C32 178 48 200 68 206C74 208 78 204 80 198C82 204 86 208 92 206C112 200 128 178 124 156C120 134 102 122 80 122Z" fill={p.body}></path>
