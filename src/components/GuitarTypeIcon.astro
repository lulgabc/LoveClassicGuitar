  {type === "flamenco" && (
    <g stroke={p.edge} stroke-width="3" stroke-linejoin="round">
      <rect x="68" y="10" width="24" height="34" rx="6" fill={p.dark}></rect>
      <rect x="73" y="14" width="5" height="26" rx="2.5" fill="#1E1210" stroke="none"></rect>
