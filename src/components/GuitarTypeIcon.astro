      <g stroke="#FFF6E0" stroke-width="2.1" opacity="0.92">
        {[0, 1, 2, 3].map((i) => <path d={`M${74 + i * 4} 44L${60 + i * 13.3} 206`} />)}
      </g>
      <g fill={p.accent} stroke="none">
        <circle cx="58" cy="16" r="2.6"></circle><circle cx="58" cy="29" r="2.6"></circle><circle cx="58" cy="42" r="2.6"></circle><circle cx="58" cy="55" r="2.6"></circle>
      </g>
    </g>
