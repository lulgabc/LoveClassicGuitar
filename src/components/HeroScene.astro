---
import Bat from "./Bat.astro";
import Capybara from "./Capybara.astro";
import Icon from "./Icon.astro";

const stars = [
  { left: 8, top: 18, size: 7, delay: 0 },
  { left: 18, top: 8, size: 4, delay: 1.2 },
  { left: 30, top: 29, size: 5, delay: 2.4 },
  { left: 44, top: 12, size: 8, delay: 0.8 },
  { left: 56, top: 33, size: 4, delay: 1.8 },
  { left: 69, top: 10, size: 5, delay: 2.8 },
  { left: 82, top: 28, size: 8, delay: 0.4 },
  { left: 91, top: 48, size: 4, delay: 1.6 },
  { left: 12, top: 46, size: 4, delay: 2.2 },
  { left: 24, top: 57, size: 6, delay: 0.6 },
  { left: 74, top: 52, size: 5, delay: 2.6 },
  { left: 88, top: 68, size: 7, delay: 1.1 },
  { left: 6, top: 66, size: 5, delay: 1.9 },
  { left: 48, top: 55, size: 3, delay: 0.2 },
];

interface Props {
  lang?: "zh" | "fr";
}
const { lang = "zh" } = Astro.props;
const isFr = lang === "fr";
const tips = isFr
  ? [
      "On commence par une corde à vide, d'accord ?",
      "Pas besoin d'aller vite : les étoiles t'attendent.",
      "Une fausse note n'est pas une erreur, c'est un nouveau chemin.",
      "Écoute d'abord le son, puis laisse tes doigts partir.",
      "Tu veux écouter quel morceau aujourd'hui ?",
    ]
  : [
      "今天也从一根空弦开始，好吗？",
      "慢一点没关系，星星会等你。",
      "弹错不是迷路，是发现了一条新小路。",
      "先听声音，再让手指出发。",
      "今天想听哪一首？我陪你去音乐厅。",
    ];
---

<div class="hero-scene" role="group" aria-label={isFr ? "Momo la chauve-souris et Capi le capybara jouent de la guitare sous les étoiles" : "小蝙蝠 Momo 和水豚 Capi 在星空下弹古典吉他"}>
  <div class="scene-stars" aria-hidden="true">
    {
      stars.map((star) => (
        <span
          class="scene-star"
          style={`left:${star.left}%;top:${star.top}%;width:${star.size}px;height:${star.size}px;animation-delay:${star.delay}s`}
        />
      ))
    }
  </div>

  <div class="moon" aria-hidden="true">
    <span class="moon-crater moon-crater-a"></span>
    <span class="moon-crater moon-crater-b"></span>
    <span class="moon-crater moon-crater-c"></span>
    <span class="moon-blush"></span>
    <span class="moon-eye"></span>
    <span class="moon-eye moon-eye-right"></span>
    <span class="moon-smile"></span>
  </div>

  <span class="twinkle twinkle-a" aria-hidden="true">
    <Icon name="star" size={22} />
  </span>
  <span class="twinkle twinkle-b" aria-hidden="true">
    <Icon name="sparkle" size={18} />
  </span>

  <div class="cloud cloud-a" aria-hidden="true"></div>
  <div class="cloud cloud-b" aria-hidden="true"></div>

  <button class="speech-bubble" type="button" data-tip-bubble data-tips={JSON.stringify(tips)}>
    <span class="speech-name">{isFr ? "Le conseil de Momo" : "Momo 小提示"}</span>
    <span class="speech-text" data-tip-text>{tips[0]}</span>
    <span class="speech-refresh" aria-hidden="true"><Icon name="refresh" size={14} /></span>
    <span class="sr-only">{isFr ? "Afficher un autre conseil" : "点击换一条提示"}</span>
  </button>

  <div class="bat-wrap" aria-hidden="true">
    <Bat />
  </div>

  <div class="capy-stage">
    <div class="cloud-platform" aria-hidden="true"></div>
    <div class="capy-wrap" aria-hidden="true">
      <Capybara />
    </div>
    <div class="string-stars" aria-hidden="true">
      <span></span><span></span><span></span><span></span><span></span>
    </div>
  </div>

  <div class="floating-notes" aria-hidden="true">
    <span class="note note-a">♪</span>
    <span class="note note-b">♫</span>
    <span class="note note-c">♪</span>
    <span class="note note-d">♩</span>
  </div>

  <div class="hero-sticker sticker-left" aria-hidden="true">
    <Icon name="music" size={17} /> {isFr ? "Un petit univers à six cordes" : "六根弦的小宇宙"}
  </div>
  <div class="hero-sticker sticker-right" aria-hidden="true">
    <Icon name="heart" size={16} /> {isFr ? "Tout doucement" : "不着急，慢慢来"}
  </div>
</div>

<style>
  .hero-scene {
    position: relative;
    width: 100%;
    max-width: 620px;
    aspect-ratio: 1 / 1.02;
    min-height: 500px;
    isolation: isolate;
  }

  .hero-scene::before {
    content: "";
    position: absolute;
    inset: 2% -4% 4%;
    z-index: -2;
    border-radius: 46% 54% 42% 58% / 45% 42% 58% 55%;
    background:
      radial-gradient(circle at 62% 22%, rgba(255, 216, 111, 0.18), transparent 23%),
      radial-gradient(circle at 28% 56%, rgba(108, 214, 255, 0.24), transparent 35%),
      linear-gradient(155deg, rgba(99, 72, 224, 0.42), rgba(37, 25, 94, 0.16) 58%, rgba(255, 178, 222, 0.12));
    filter: blur(12px);
    transform: rotate(-4deg);
  }

  .scene-stars {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .scene-star {
    position: absolute;
    display: block;
    border-radius: 50%;
    background: #fff7d2;
    box-shadow: 0 0 10px 3px rgba(255, 239, 167, 0.38);
    animation: star-twinkle 3.8s ease-in-out infinite;
  }

  .moon {
    position: absolute;
    top: 7%;
    right: 6%;
    width: clamp(108px, 17vw, 152px);
    aspect-ratio: 1;
    border-radius: 50%;
    background:
      radial-gradient(circle at 35% 33%, #fffbe0 0 12%, transparent 13%),
      radial-gradient(circle at 66% 61%, #f3d98a 0 7%, transparent 8%),
      linear-gradient(145deg, #fff8c9, #ffd976 64%, #f3b94f);
    box-shadow:
      0 0 0 12px rgba(255, 235, 157, 0.08),
      0 0 55px rgba(255, 219, 107, 0.33),
      inset -16px -18px 26px rgba(215, 137, 50, 0.22);
    animation: moon-float 8s ease-in-out infinite;
  }

  .moon-crater {
    position: absolute;
    border-radius: 50%;
    background: rgba(212, 150, 61, 0.17);
    box-shadow: inset 2px 2px 4px rgba(149, 92, 27, 0.12);
  }

  .moon-crater-a {
    width: 17%;
    height: 17%;
    left: 20%;
    top: 56%;
  }

  .moon-crater-b {
    width: 11%;
    height: 11%;
    left: 64%;
    top: 25%;
  }

  .moon-crater-c {
    width: 8%;
    height: 8%;
    left: 59%;
    top: 70%;
  }

  .moon-blush {
    position: absolute;
    width: 17%;
    height: 8%;
    left: 20%;
    top: 62%;
    border-radius: 50%;
    background: rgba(255, 142, 157, 0.4);
    filter: blur(1px);
  }

  .moon-eye,
  .moon-eye-right {
    position: absolute;
    top: 50%;
    width: 6%;
    height: 8%;
    border-radius: 50%;
    background: #6b4e24;
  }

  .moon-eye {
    left: 36%;
  }

  .moon-eye-right {
    left: 61%;
  }

  .moon-smile {
    position: absolute;
    left: 47%;
    top: 63%;
    width: 13%;
    height: 7%;
    border-bottom: 3px solid #6b4e24;
    border-radius: 50%;
  }

  .twinkle {
    position: absolute;
    z-index: 2;
    color: #ffe58a;
    filter: drop-shadow(0 0 9px rgba(255, 224, 127, 0.6));
    animation: twinkle-spin 7s ease-in-out infinite;
  }

  .twinkle-a {
    left: 6%;
    top: 30%;
  }

  .twinkle-b {
    right: 4%;
    top: 30%;
    color: #c1eaff;
    animation-delay: -2.8s;
  }

  .cloud {
    position: absolute;
    z-index: 0;
    height: 34px;
    border-radius: 999px;
    background: linear-gradient(90deg, rgba(201, 185, 255, 0.12), rgba(201, 185, 255, 0.3));
    filter: blur(1px);
  }

  .cloud::before,
  .cloud::after {
    content: "";
    position: absolute;
    bottom: 10px;
    border-radius: 50%;
    background: inherit;
  }

  .cloud::before {
    left: 18%;
    width: 36%;
    height: 38px;
  }

  .cloud::after {
    right: 11%;
    width: 25%;
    height: 27px;
  }

  .cloud-a {
    width: 33%;
    left: 1%;
    top: 18%;
    opacity: 0.58;
    animation: cloud-drift 18s ease-in-out infinite;
  }

  .cloud-b {
    width: 30%;
    right: -2%;
    top: 42%;
    opacity: 0.4;
    transform: scale(0.8);
    animation: cloud-drift 24s ease-in-out infinite reverse;
  }

  .speech-bubble {
    position: absolute;
    z-index: 6;
    top: 2%;
    left: 2%;
    width: min(210px, 45%);
    padding: 14px 16px 15px;
    text-align: left;
    color: #33255f;
    background: #fffaf1;
    border: 2px solid #4e3b8e;
    border-radius: 20px 20px 20px 6px;
    box-shadow: 0 5px 0 rgba(55, 37, 113, 0.22), 0 15px 30px rgba(43, 27, 95, 0.18);
    transform: rotate(-2deg);
    transition: transform 180ms ease, box-shadow 180ms ease;
    cursor: pointer;
  }

  .speech-bubble::after {
    content: "";
    position: absolute;
    left: 12px;
    bottom: -13px;
    width: 22px;
    height: 16px;
    background: #fffaf1;
    border-right: 2px solid #4e3b8e;
    border-bottom: 2px solid #4e3b8e;
    clip-path: polygon(0 0, 100% 0, 0 100%);
  }

  .speech-bubble:hover {
    transform: rotate(1deg) translateY(-2px);
    box-shadow: 0 7px 0 rgba(55, 37, 113, 0.2), 0 18px 34px rgba(43, 27, 95, 0.2);
  }

  .speech-name {
    display: flex;
    align-items: center;
    gap: 5px;
    margin-bottom: 3px;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.08em;
    color: #7655db;
  }

  .speech-text {
    display: block;
    font-size: clamp(13px, 1.2vw, 15px);
    font-weight: 750;
    line-height: 1.55;
  }

  .speech-refresh {
    position: absolute;
    right: 10px;
    bottom: 9px;
    color: #8a73bf;
    opacity: 0.55;
  }

  .bat-wrap {
    position: absolute;
    z-index: 4;
    left: 2%;
    top: 17%;
    width: clamp(138px, 27vw, 200px);
    animation: bat-float 6.2s ease-in-out infinite;
    filter: drop-shadow(0 16px 25px rgba(28, 14, 70, 0.25));
  }

  .capy-stage {
    position: absolute;
    z-index: 3;
    left: 50%;
    bottom: -2%;
    width: min(88%, 510px);
    transform: translateX(-50%);
  }

  .cloud-platform {
    position: absolute;
    z-index: -1;
    left: 4%;
    right: 4%;
    bottom: 4%;
    height: 29%;
    border-radius: 50% 50% 42% 42% / 55% 55% 45% 45%;
    background:
      radial-gradient(circle at 50% 12%, rgba(255, 255, 255, 0.92), transparent 45%),
      linear-gradient(180deg, #e7dcff, #b8a1ef);
    box-shadow:
      0 -8px 36px rgba(190, 168, 255, 0.32),
      0 26px 40px rgba(32, 18, 82, 0.22);
    opacity: 0.95;
  }

  .capy-wrap {
    position: relative;
    margin: 0 auto;
    width: 100%;
    animation: capy-bob 5.8s ease-in-out infinite;
    filter: drop-shadow(0 22px 23px rgba(31, 16, 77, 0.22));
  }

  .string-stars {
    position: absolute;
    inset: 29% 12% 21%;
    z-index: -1;
    pointer-events: none;
  }

  .string-stars span {
    position: absolute;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #ffe07f;
    box-shadow: 0 0 8px 2px rgba(255, 224, 127, 0.6);
    animation: star-twinkle 4s ease-in-out infinite;
  }

  .string-stars span:nth-child(1) { left: 8%; top: 13%; animation-delay: -1s; }
  .string-stars span:nth-child(2) { right: 12%; top: 27%; animation-delay: -2.5s; }
  .string-stars span:nth-child(3) { left: 4%; bottom: 21%; animation-delay: -0.5s; }
  .string-stars span:nth-child(4) { right: 6%; bottom: 13%; animation-delay: -3s; }
  .string-stars span:nth-child(5) { left: 48%; top: 6%; animation-delay: -1.8s; }

  .floating-notes {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  .note {
    position: absolute;
    color: #ffd86f;
    font-family: Georgia, serif;
    font-weight: 700;
    text-shadow: 0 0 12px rgba(255, 216, 111, 0.55);
    animation: note-float 7s ease-in-out infinite;
  }

  .note-a { left: 33%; top: 28%; font-size: 30px; animation-delay: -1s; }
  .note-b { right: 20%; top: 23%; font-size: 24px; color: #bceaff; animation-delay: -3.2s; }
  .note-c { left: 70%; top: 39%; font-size: 20px; color: #ffb2de; animation-delay: -4.6s; }
  .note-d { left: 18%; top: 48%; font-size: 18px; color: #c9b8ff; animation-delay: -2.1s; }

  .hero-sticker {
    position: absolute;
    z-index: 5;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 11px;
    border: 2px solid var(--ink);
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.02em;
    box-shadow: 0 3px 0 var(--ink);
    animation: sticker-bob 5s ease-in-out infinite;
  }

  :global(html[data-theme="night"]) .hero-sticker {
    border-color: rgba(255, 255, 255, 0.24);
    background: rgba(255, 255, 255, 0.1);
    color: #f4eeff;
    box-shadow: 0 0 14px rgba(183, 156, 255, 0.22);
    backdrop-filter: blur(10px);
  }

  .sticker-left {
    left: 4%;
    bottom: 19%;
  }

  .sticker-right {
    right: 2%;
    bottom: 32%;
    animation-delay: -2s;
  }

  @keyframes star-twinkle {
    0%, 100% { opacity: 0.4; transform: scale(0.8); }
    50% { opacity: 1; transform: scale(1.15); }
  }

  @keyframes twinkle-spin {
    0%, 100% { transform: rotate(0deg) scale(0.9); opacity: 0.7; }
    50% { transform: rotate(18deg) scale(1.15); opacity: 1; }
  }

  @keyframes moon-float {
    0%, 100% { transform: translateY(0) rotate(-2deg); }
    50% { transform: translateY(-7px) rotate(2deg); }
  }

  @keyframes cloud-drift {
    0%, 100% { transform: translateX(0); }
    50% { transform: translateX(16px); }
  }

  @keyframes bat-float {
    0%, 100% { transform: translate(0, 0) rotate(-2deg); }
    35% { transform: translate(16px, -10px) rotate(3deg); }
    68% { transform: translate(7px, 7px) rotate(-1deg); }
  }

  @keyframes capy-bob {
    0%, 100% { transform: translateY(0) rotate(-0.4deg); }
    50% { transform: translateY(-5px) rotate(0.5deg); }
  }

  @keyframes note-float {
    0%, 100% { transform: translateY(0) rotate(-6deg); opacity: 0.45; }
    50% { transform: translateY(-17px) rotate(8deg); opacity: 1; }
  }

  @keyframes sticker-bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-5px); }
  }

  @media (max-width: 860px) {
    .hero-scene {
      min-height: 440px;
      max-width: 540px;
      margin: 0 auto;
    }

    .bat-wrap {
      width: 32%;
      left: 0;
      top: 19%;
    }

    .speech-bubble {
      width: 48%;
      left: 0;
      top: 1%;
    }

    .sticker-left {
      left: 2%;
      bottom: 17%;
    }

    .sticker-right {
      display: none;
    }
  }

  @media (max-width: 540px) {
    .hero-scene {
      min-height: 380px;
      aspect-ratio: 1 / 1.06;
    }

    .moon {
      width: 102px;
      top: 5%;
    }

    .speech-bubble {
      width: 55%;
      padding: 11px 12px 12px;
      border-radius: 16px 16px 16px 5px;
    }

    .speech-text {
      font-size: 12px;
    }

    .bat-wrap {
      width: 35%;
      top: 24%;
    }

    .capy-stage {
      width: 96%;
    }

    .hero-sticker {
      display: none;
    }

    .note-a { font-size: 22px; }
    .note-b { font-size: 18px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .scene-star,
    .moon,
    .twinkle,
    .cloud,
    .bat-wrap,
    .capy-wrap,
    .note,
    .hero-sticker {
      animation: none !important;
    }
  }
</style>
