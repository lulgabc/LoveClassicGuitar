---
import { SCORES, type ScoreEntry, type ScoreFocus, type ScoreLevel } from "../data/scores";
import Icon from "./Icon.astro";

interface Props {
  scores?: ScoreEntry[];
  lang?: "zh" | "fr";
}

const { scores = SCORES, lang = "zh" } = Astro.props;
const isFr = lang === "fr";

const levelLabels: Record<ScoreLevel, string> = isFr
  ? { 1: "Éveil", 2: "Débutant", 3: "Intermédiaire", 4: "Avancé", 5: "Concert" }
  : { 1: "启蒙", 2: "初级", 3: "中级", 4: "进阶", 5: "高级" };

const focusLabels: Record<ScoreFocus, string> = isFr
  ? {
      right: "Main droite",
      left: "Main gauche",
      reading: "Lecture",
      rhythm: "Rythme",
      tone: "Son",
      phrasing: "Phrasé",
      ensemble: "Ensemble",
    }
  : {
      right: "右手",
      left: "左手",
      reading: "读谱",
      rhythm: "节奏",
      tone: "音色",
      phrasing: "乐句",
      ensemble: "合奏",
    };

const t = isFr
  ? {
      searchPlaceholder: "Chercher un titre, un compositeur ou un objectif…",
      searchLabel: "Chercher dans la bibliothèque de partitions",
      levelLabel: "Niveau",
      focusLabel: "Objectif",
      all: "Tous",
      freeOnly: "Seulement les partitions libres",
      count: (shown: number, total: number) => `${shown} / ${total} partitions`,
      more: (step: number) => `Afficher ${step} partitions de plus`,
      empty: "Aucune partition trouvée. Essaie un mot plus court ou enlève un filtre.",
      free: "Libre",
      copyright: "Sous droits",
      tip: "Conseil",
      imslp: "Chercher sur IMSLP",
      library: "Éditeur / bibliothèque",
      open: "Voir la partition",
      close: "Fermer",
      previewNote: "Aperçu de la première page · partition complète sur IMSLP",
      practiceNoteImslp: "Page d'exercice : retrouve la partition complète sur IMSLP avec le bouton ci-dessous.",
      practiceNoteLibrary: "Page d'exercice : la partition complète est disponible chez un éditeur ou dans une bibliothèque.",
      practiceCaption: "Page d'exercice · pas la partition complète",
      previewArea: "Aperçu de la partition",
      imslpFull: "Voir la partition complète sur IMSLP",
      libraryFull: "Éditeur / bibliothèque",
      imageAlt: "Aperçu de la première page de la partition",
      practicePage: "Page d'exercice",
      note: "Ce site n'héberge pas de PDF. Certaines œuvres du domaine public ont un aperçu de la première page ; la partition complète renvoie vers IMSLP. Les œuvres protégées renvoient vers WorldCat, un éditeur ou une bibliothèque. Le statut des droits varie selon les pays.",
    }
  : {
      searchPlaceholder: "搜曲名、作曲家或练习重点…",
      searchLabel: "在乐谱库中搜索",
      levelLabel: "难度",
      focusLabel: "练习重点",
      all: "全部",
      freeOnly: "只看免费乐谱",
      count: (shown: number, total: number) => `显示 ${shown} / ${total} 首`,
      more: (step: number) => `再看 ${step} 首`,
      empty: "没有找到。换个短一点的词，或者去掉一个筛选条件。",
      free: "免费",
      copyright: "版权作品",
      tip: "练习提示",
      imslp: "在 IMSLP 找乐谱",
      library: "出版社 / 图书馆",
      open: "查看乐谱",
      close: "关闭",
      previewNote: "第一页预览 · 完整乐谱请在 IMSLP 查看",
      practiceNoteImslp: "这是练习页示例；完整乐谱请用下方按钮在 IMSLP 查看。",
      practiceNoteLibrary: "这是练习页示例；完整版请通过出版社或图书馆获取。",
      practiceCaption: "练习页示例 · 不是原曲完整乐谱",
      previewArea: "乐谱预览",
      imslpFull: "在 IMSLP 查看完整版",
      libraryFull: "出版社 / 图书馆",
      imageAlt: "乐谱第一页预览",
      practicePage: "练习页示例",
      note: "本站不托管 PDF。部分公共领域作品提供第一页预览，完整乐谱链接到 IMSLP；现代版权作品链接到 WorldCat、出版社或图书馆。版权状态因国家而异，请家长或老师确认。",
    };

const step = 24;
const focusKeys = Object.keys(focusLabels) as ScoreFocus[];
---

<div class="scores" data-scores data-lang={lang} data-step={step}>
  <div class="score-toolbar">
    <label class="score-search">
      <Icon name="search" size={17} />
      <span class="sr-only">{t.searchLabel}</span>
      <input type="search" placeholder={t.searchPlaceholder} data-score-search />
    </label>
    <label class="score-free-toggle">
      <input type="checkbox" data-score-free />
      <span class="score-check" aria-hidden="true"></span>
      <span>{t.freeOnly}</span>
    </label>
    <span class="score-count" data-score-count>{t.count(scores.length, scores.length)}</span>
  </div>

  <div class="score-filters">
    <div class="score-filter-row" role="group" aria-label={t.levelLabel}>
      <span class="score-filter-label">{t.levelLabel}</span>
      <button type="button" class="score-chip is-active" data-score-level="all" aria-pressed="true">{t.all}</button>
      {([1, 2, 3, 4, 5] as ScoreLevel[]).map((level) => (
        <button type="button" class="score-chip" data-score-level={level} aria-pressed="false">{level} · {levelLabels[level]}</button>
      ))}
    </div>
    <div class="score-filter-row" role="group" aria-label={t.focusLabel}>
      <span class="score-filter-label">{t.focusLabel}</span>
      <button type="button" class="score-chip is-active" data-score-focus="all" aria-pressed="true">{t.all}</button>
      {focusKeys.map((focus) => (
        <button type="button" class="score-chip" data-score-focus={focus} aria-pressed="false">{focusLabels[focus]}</button>
      ))}
    </div>
  </div>

  <div class="score-grid">
    {
      scores.map((score) => (
        <article
          class:list={["score-card", "card", `level-${score.level}`]}
          data-score-item
          data-level={score.level}
          data-focus={score.focus}
          data-free={score.free ? "true" : "false"}
          data-search={`${score.title} ${score.titleZh ?? ""} ${score.composer} ${focusLabels[score.focus]} ${levelLabels[score.level]}`.toLowerCase()}
        >
          <div class="score-top">
            <span class="score-level">{score.level} · {levelLabels[score.level]}</span>
            <span class:list={["score-price", score.free ? "is-free" : "is-paid"]}>{score.free ? t.free : t.copyright}</span>
          </div>
          <h3>{isFr ? score.title : score.titleZh ?? score.title}</h3>
          {!isFr && score.titleZh && <p class="score-original">{score.title}</p>}
          <p class="score-composer">{score.composer}</p>
          <div class="score-meta">
            <span class="score-focus">{focusLabels[score.focus]}</span>
            <span class="score-era">{score.era}</span>
          </div>
          <p class="score-tip"><strong>{t.tip}:</strong> {isFr ? score.tipFr : score.tipZh}</p>
          <button
            type="button"
            class="score-open"
            data-score-open
            data-title={isFr ? score.title : score.titleZh ?? score.title}
            data-composer={score.composer}
            data-level={`${score.level} · ${levelLabels[score.level]}`}
            data-focus={focusLabels[score.focus]}
            data-focus-key={score.focus}
            data-tip={isFr ? score.tipFr : score.tipZh}
            data-preview={score.previewUrl ?? ""}
            data-url={score.url}
            data-source={score.source}
          >
            <Icon name="book" size={11} /> {t.open}
          </button>
        </article>
      ))
    }
  </div>

  <p class="score-empty" data-score-empty hidden>{t.empty}</p>
  <div class="score-more-wrap" data-score-more-wrap>
    <button type="button" class="btn btn-secondary btn-sm" data-score-more>{t.more(step)}</button>
  </div>
  <p class="score-note"><Icon name="info" size={13} /> {t.note}</p>

  <dialog class="score-modal" data-score-modal aria-labelledby="score-modal-title">
    <div class="score-modal-panel">
      <div class="score-modal-head">
        <span class="score-modal-kicker" data-score-modal-kicker></span>
        <button type="button" class="score-modal-close" data-score-close aria-label={t.close}>×</button>
      </div>
      <h2 id="score-modal-title" data-score-modal-title></h2>
      <p class="score-modal-meta" data-score-modal-meta></p>
      <div class="score-modal-stage" tabindex="0" aria-label={t.previewArea}>
        <img data-score-modal-image alt="" hidden />
        <div class="score-modal-placeholder" data-score-modal-placeholder hidden>
          <div class="score-placeholder-sheet" aria-hidden="true">
            <span class="score-placeholder-label" data-score-practice-label>{t.practicePage}</span>
            <div class="score-practice-render" data-score-practice-render></div>
          </div>
          <p class="score-placeholder-caption">{t.practiceCaption}</p>
          <p data-score-modal-placeholder-text>{t.practiceNoteLibrary}</p>
        </div>
      </div>
      <p class="score-modal-preview-note" data-score-modal-preview-note hidden>{t.previewNote}</p>
      <p class="score-modal-tip" data-score-modal-tip></p>
      <div class="score-modal-actions">
        <a class="btn btn-primary btn-sm" data-score-modal-external target="_blank" rel="noopener noreferrer" href="#"></a>
        <button class="btn btn-ghost btn-sm" type="button" data-score-close>{t.close}</button>
      </div>
    </div>
  </dialog>
</div>

<noscript>
  <style>[data-score-more-wrap] { display: none; }</style>
</noscript>

<script>
  const root = document.querySelector<HTMLElement>("[data-scores]");
  if (root) {
    const items = Array.from(root.querySelectorAll<HTMLElement>("[data-score-item]"));
    const search = root.querySelector<HTMLInputElement>("[data-score-search]");
    const free = root.querySelector<HTMLInputElement>("[data-score-free]");
    const count = root.querySelector<HTMLElement>("[data-score-count]");
    const empty = root.querySelector<HTMLElement>("[data-score-empty]");
    const moreWrap = root.querySelector<HTMLElement>("[data-score-more-wrap]");
    const more = root.querySelector<HTMLButtonElement>("[data-score-more]");
    const levelButtons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-score-level]"));
    const focusButtons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-score-focus]"));
    const isFr = root.dataset.lang === "fr";
    const step = Number(root.dataset.step || 24);
    let level = "all";
    let focus = "all";
    let limit = step;

    const countLabel = (shown: number, total: number) => isFr ? `${shown} / ${total} partitions` : `显示 ${shown} / ${total} 首`;
    const moreLabel = (n: number) => isFr ? `Afficher ${n} partitions de plus` : `再看 ${n} 首`;

    function apply(reset = false): void {
      if (reset) limit = step;
      const query = (search?.value ?? "").trim().toLowerCase();
      const onlyFree = free?.checked ?? false;
      let matching = 0;
      items.forEach((item) => {
        const matches =
          (level === "all" || item.dataset.level === level) &&
          (focus === "all" || item.dataset.focus === focus) &&
          (!onlyFree || item.dataset.free === "true") &&
          (!query || (item.dataset.search ?? "").includes(query));
        const show = matches && matching < limit;
        if (matches) matching += 1;
        item.hidden = !show;
      });
      if (count) count.textContent = countLabel(Math.min(matching, limit), matching);
      if (empty) empty.hidden = matching !== 0;
      if (moreWrap) moreWrap.hidden = matching <= limit;
      if (more) more.textContent = moreLabel(Math.min(step, Math.max(0, matching - limit)));
    }

    function selectChip(buttons: HTMLButtonElement[], activeButton: HTMLButtonElement): void {
      buttons.forEach((button) => {
        const active = button === activeButton;
        button.classList.toggle("is-active", active);
        button.setAttribute("aria-pressed", String(active));
      });
    }

    levelButtons.forEach((button) => {
      button.addEventListener("click", () => {
        level = button.dataset.scoreLevel ?? "all";
        selectChip(levelButtons, button);
        apply(true);
      });
    });
    focusButtons.forEach((button) => {
      button.addEventListener("click", () => {
        focus = button.dataset.scoreFocus ?? "all";
        selectChip(focusButtons, button);
        apply(true);
      });
    });
    search?.addEventListener("input", () => apply(true));
    free?.addEventListener("change", () => apply(true));
    more?.addEventListener("click", () => {
      limit += step;
      apply();
    });

    const modal = root.querySelector<HTMLDialogElement>("[data-score-modal]");
    const modalTitle = root.querySelector<HTMLElement>("[data-score-modal-title]");
    const modalKicker = root.querySelector<HTMLElement>("[data-score-modal-kicker]");
    const modalMeta = root.querySelector<HTMLElement>("[data-score-modal-meta]");
    const modalTip = root.querySelector<HTMLElement>("[data-score-modal-tip]");
    const modalImage = root.querySelector<HTMLImageElement>("[data-score-modal-image]");
    const modalPlaceholder = root.querySelector<HTMLElement>("[data-score-modal-placeholder]");
    const modalPlaceholderText = root.querySelector<HTMLElement>("[data-score-modal-placeholder-text]");
    const modalPreviewNote = root.querySelector<HTMLElement>("[data-score-modal-preview-note]");
    const modalExternal = root.querySelector<HTMLAnchorElement>("[data-score-modal-external]");
    const labels = isFr
      ? {
          practiceNoteImslp: "Page d'exercice : retrouve la partition complète sur IMSLP avec le bouton ci-dessous.",
          practiceNoteLibrary: "Page d'exercice : la partition complète est disponible chez un éditeur ou dans une bibliothèque.",
          previewNote: "Aperçu de la première page · partition complète sur IMSLP",
          imslpFull: "Voir la partition complète sur IMSLP",
          libraryFull: "Éditeur / bibliothèque",
          imageAlt: "Aperçu de la première page de la partition",
          practicePage: "Page d'exercice",
        }
      : {
          practiceNoteImslp: "这是练习页示例；完整乐谱请用下方按钮在 IMSLP 查看。",
          practiceNoteLibrary: "这是练习页示例；完整版请通过出版社或图书馆获取。",
          previewNote: "第一页预览 · 完整乐谱请在 IMSLP 查看",
          imslpFull: "在 IMSLP 查看完整版",
          libraryFull: "出版社 / 图书馆",
          imageAlt: "乐谱第一页预览",
          practicePage: "练习页",
        };
    const practiceRender = root.querySelector<HTMLElement>("[data-score-practice-render]");
    const practiceLabel = root.querySelector<HTMLElement>("[data-score-practice-label]");
    let lastFocus: HTMLElement | null = null;

    function practiceSvg(focus: string, level: number, seedText: string): string {
      const patterns: Record<string, number[]> = {
        right: [84, 75, 66, 75, 84, 93, 102, 93],
        left: [84, 84, 75, 75, 66, 66, 75, 75],
        reading: [84, 75, 66, 75, 84, 93, 84, 75],
        rhythm: [84, 84, 75, 75, 66, 66, 75, 75],
        tone: [84, 75, 66, 75],
        phrasing: [84, 75, 66, 75, 84, 75, 66, 75],
        ensemble: [84, 75, 66, 75, 102, 93, 84, 93],
      };
      const base = patterns[focus] ?? patterns.reading;
      const count = Math.min(base.length, 4 + Math.min(level, 4));
      const notes = base.slice(0, count);
      const seed = [...seedText].reduce((sum, char) => sum + char.charCodeAt(0), 0);
      const shift = (seed % 3) * 3;
      const heads = notes
        .map((y, index) => {
          const x = 158 + index * 52;
          const yy = y + shift;
          return `<g><ellipse cx="${x}" cy="${yy}" rx="8" ry="6" transform="rotate(-18 ${x} ${yy})"></ellipse><line x1="${x + 6}" y1="${yy}" x2="${x + 6}" y2="${yy - 36}"></line></g>`;
        })
        .join("");
      return `<svg viewBox="0 0 560 180" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <g stroke="currentColor" stroke-width="1" opacity="0.35">
          <line x1="18" y1="48" x2="542" y2="48"></line>
          <line x1="18" y1="66" x2="542" y2="66"></line>
          <line x1="18" y1="84" x2="542" y2="84"></line>
          <line x1="18" y1="102" x2="542" y2="102"></line>
          <line x1="18" y1="120" x2="542" y2="120"></line>
        </g>
        <g stroke="currentColor" stroke-width="1" opacity="0.4">
          <line x1="140" y1="48" x2="140" y2="120"></line>
          <line x1="348" y1="48" x2="348" y2="120"></line>
          <line x1="540" y1="48" x2="540" y2="120"></line>
        </g>
        <text x="24" y="110" fill="currentColor" opacity="0.6" font-family="Georgia, serif" font-size="58">𝄞</text>
        <text x="94" y="88" fill="currentColor" opacity="0.55" font-family="Georgia, serif" font-size="16">4/4</text>
        <g fill="currentColor" stroke="currentColor" opacity="0.72">${heads}</g>
      </svg>`;
    }

    function closeModal(): void {
      if (!modal || !modal.open) return;
      modal.close();
    }

    function openModal(button: HTMLButtonElement): void {
      if (!modal) return;
      const title = button.dataset.title ?? "";
      const composer = button.dataset.composer ?? "";
      const levelText = button.dataset.level ?? "";
      const focusText = button.dataset.focus ?? "";
      const tip = button.dataset.tip ?? "";
      const preview = button.dataset.preview ?? "";
      const source = button.dataset.source ?? "IMSLP";
      if (modalTitle) modalTitle.textContent = title;
      if (modalKicker) modalKicker.textContent = `${levelText} · ${focusText}`;
      if (modalMeta) modalMeta.textContent = composer;
      if (modalTip) modalTip.textContent = tip;
      if (modalExternal) {
        modalExternal.href = button.dataset.url ?? "#";
        modalExternal.textContent = source === "IMSLP" ? labels.imslpFull : labels.libraryFull;
      }
      if (modalImage && modalPlaceholder && modalPreviewNote) {
        if (preview) {
          modalImage.onerror = () => {
            modalImage.hidden = true;
            modalPlaceholder.hidden = false;
            modalPreviewNote.hidden = true;
          };
          modalImage.src = preview;
          modalImage.alt = `${title} — ${labels.imageAlt}`;
          modalImage.hidden = false;
          modalPlaceholder.hidden = true;
          modalPreviewNote.hidden = false;
        } else {
          modalImage.hidden = true;
          modalImage.removeAttribute("src");
          modalPlaceholder.hidden = false;
          modalPreviewNote.hidden = true;
          if (practiceRender) {
            practiceRender.innerHTML = practiceSvg(button.dataset.focusKey ?? "reading", Number.parseInt(levelText, 10) || 3, title);
          }
          if (practiceLabel) practiceLabel.textContent = `${labels.practicePage} · ${focusText}`;
          if (modalPlaceholderText) modalPlaceholderText.textContent = source === "IMSLP" ? labels.practiceNoteImslp : labels.practiceNoteLibrary;
        }
      }
      lastFocus = button;
      if (!modal.open) modal.showModal();
      document.body.classList.add("score-modal-open");
      modal.querySelector<HTMLButtonElement>("[data-score-close]")?.focus();
    }

    root.querySelectorAll<HTMLButtonElement>("[data-score-open]").forEach((button) => {
      button.addEventListener("click", () => openModal(button));
    });
    root.querySelectorAll<HTMLElement>("[data-score-close]").forEach((button) => {
      button.addEventListener("click", closeModal);
    });
    modal?.addEventListener("close", () => {
      document.body.classList.remove("score-modal-open");
      lastFocus?.focus();
    });
    modal?.addEventListener("click", (event) => {
      if (event.target === modal) modal.close();
    });

    apply();
  }
</script>

<style>
  .score-toolbar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 9px;
    margin-bottom: 11px;
  }

  .score-search {
    display: flex;
    align-items: center;
    gap: 7px;
    flex: 1 1 280px;
    min-width: 0;
    min-height: 43px;
    padding: 0 13px;
    color: var(--muted);
    border: 1.5px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
  }

  .score-search:focus-within {
    border-color: var(--violet-500);
    box-shadow: 0 0 0 3px var(--violet-wash);
  }

  .score-search input {
    flex: 1;
    min-width: 0;
    min-height: 39px;
    padding: 0;
    color: var(--ink);
    border: 0;
    outline: 0;
    background: transparent;
    font-size: 12px;
  }

  .score-search input::placeholder {
    color: var(--faint);
  }

  .score-free-toggle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--muted);
    font-size: 9px;
    font-weight: 700;
    cursor: pointer;
  }

  .score-free-toggle input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .score-check {
    position: relative;
    pointer-events: none;
    width: 18px;
    height: 18px;
    border: 1.5px solid var(--line-strong);
    border-radius: 6px;
    background: var(--surface);
    transition: background 150ms ease, border-color 150ms ease;
  }

  .score-free-toggle input:checked + .score-check {
    border-color: var(--violet-600);
    background: var(--violet-600);
  }

  .score-free-toggle input:checked + .score-check::after {
    content: "";
    position: absolute;
    left: 5px;
    top: 2px;
    width: 4px;
    height: 8px;
    border: solid #fff;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  .score-free-toggle input:focus-visible + .score-check {
    outline: 3px solid var(--sun-500);
    outline-offset: 2px;
  }

  .score-count {
    margin-left: auto;
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 8.5px;
    white-space: nowrap;
  }

  .score-filters {
    display: grid;
    gap: 6px;
    margin-bottom: 14px;
  }

  .score-filter-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 4px;
  }

  .score-filter-label {
    flex: 0 0 54px;
    color: var(--violet-700);
    font-family: var(--font-mono);
    font-size: 8px;
    font-weight: 800;
  }

  .score-chip {
    min-height: 28px;
    padding: 4px 8px;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    font-size: 8.5px;
    font-weight: 750;
    white-space: nowrap;
  }

  .score-chip.is-active {
    color: #fff;
    border-color: #5b3fd4;
    background: #5b3fd4;
  }

  .score-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
  }

  .score-card {
    display: flex;
    flex-direction: column;
