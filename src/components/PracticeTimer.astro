---
import { PRACTICE_PRESETS } from "../data/practice";
import Icon from "./Icon.astro";
---

<div class="practice-timer card" data-timer>
  <div class="timer-head">
    <div>
      <span class="timer-kicker">Practice timer · 小小练习钟</span>
      <h3>选一个长度，开始今天的 15 分钟</h3>
      <p>不用一次做完所有事。钟响了就休息，星星会记得你来过。</p>
    </div>
    <div class="preset-switch" role="group" aria-label="选择练习时长">
      {
        PRACTICE_PRESETS.map((preset, index) => (
          <button type="button" class:list={["preset-btn", { "is-active": index === 1 }]} data-preset={preset.minutes} aria-pressed={index === 1 ? "true" : "false"}>
            <strong>{preset.label}</strong>
            <span>{preset.sub}</span>
          </button>
        ))
      }
    </div>
  </div>

  <div class="timer-main">
    <div class="timer-clock-wrap">
      <div class="timer-clock" data-clock style="--progress:0">
        <div class="clock-inner">
          <span class="clock-label" data-clock-label>准备开始</span>
          <strong data-clock-time>15:00</strong>
          <span class="clock-step" data-clock-step>共 4 个小步骤</span>
        </div>
        <span class="clock-orbit orbit-a" aria-hidden="true"></span>
        <span class="clock-orbit orbit-b" aria-hidden="true"></span>
        <span class="clock-star" aria-hidden="true">✦</span>
      </div>

      <div class="timer-controls">
        <button class="timer-main-btn" type="button" data-timer-start>
          <Icon name="play" size={18} /> <span>开始</span>
        </button>
        <button class="timer-icon-btn" type="button" data-timer-reset aria-label="重置计时器" title="重置">
          <Icon name="refresh" size={17} />
        </button>
        <button class="timer-icon-btn" type="button" data-timer-skip aria-label="跳到下一步" title="下一步">
          <Icon name="chevron-right" size={18} />
        </button>
        <span class="timer-sound"><Icon name="volume" size={14} /> 轻柔提示音</span>
      </div>
      <p class="timer-live sr-only" aria-live="polite" data-timer-live></p>
    </div>

    <div class="timer-steps">
      <div class="timer-steps-head">
        <span>今天的路线</span>
        <span data-timer-total>15 分钟</span>
      </div>
      <ol data-timer-steps></ol>
      <div class="timer-progress-text"><span data-timer-overall>0%</span> 完成</div>
    </div>
  </div>

  <div class="timer-complete" data-timer-complete hidden>
    <div class="complete-star"><Icon name="star" size={27} /></div>
    <div>
      <span class="complete-kicker">Practice complete</span>
      <h4>今天的练习完成了！</h4>
      <p>你刚刚为六根弦付出了真实的时间。星星已经收好，去休息一下，或者弹一首喜欢的曲子作为奖励。</p>
    </div>
    <button class="btn btn-sun btn-sm" type="button" data-timer-again><Icon name="refresh" size={14} /> 再练一次</button>
  </div>

  <div class="timer-footer">
    <div class="timer-sessions">
      <span class="sessions-label"><Icon name="star" size={13} /> 最近 7 天</span>
      <div class="sessions-days" data-sessions-days></div>
    </div>
    <span class="sessions-total"><strong data-session-total>0</strong> 次练习记录 · 只保存在这台设备</span>
  </div>
</div>

<script>
  import { PRACTICE_PRESETS } from "../data/practice";
  import { readProgress, addPracticeSession } from "../lib/progress";
  import { celebrate } from "../lib/celebrate";
  import { playChime } from "../lib/audio";
  import { copyScope } from "../lib/scope";

  const root = document.querySelector<HTMLElement>("[data-timer]")!;
  if (root) {
    const clock = root.querySelector<HTMLElement>("[data-clock]");
    const clockTime = root.querySelector<HTMLElement>("[data-clock-time]");
    const clockLabel = root.querySelector<HTMLElement>("[data-clock-label]");
    const clockStep = root.querySelector<HTMLElement>("[data-clock-step]");
    const stepsList = root.querySelector<HTMLOListElement>("[data-timer-steps]");
    const startBtn = root.querySelector<HTMLButtonElement>("[data-timer-start]");
    const resetBtn = root.querySelector<HTMLButtonElement>("[data-timer-reset]");
    const skipBtn = root.querySelector<HTMLButtonElement>("[data-timer-skip]");
    const completePanel = root.querySelector<HTMLElement>("[data-timer-complete]");
    const againBtn = root.querySelector<HTMLButtonElement>("[data-timer-again]");
    const totalEl = root.querySelector<HTMLElement>("[data-timer-total]");
    const overallEl = root.querySelector<HTMLElement>("[data-timer-overall]");
    const liveEl = root.querySelector<HTMLElement>("[data-timer-live]");
    const sessionTotal = root.querySelector<HTMLElement>("[data-session-total]");
    const daysEl = root.querySelector<HTMLElement>("[data-sessions-days]");
    const presetButtons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-preset]"));

    let preset = PRACTICE_PRESETS[1]!;
    let stepIndex = 0;
    let remaining = preset.steps[0]!.minutes * 60;
    let totalSeconds = preset.steps.reduce((sum, step) => sum + step.minutes * 60, 0);
    let completedSeconds = 0;
    let running = false;
    let finished = false;
    let targetEnd = 0;
    let interval: number | null = null;
    let rewarded = false;


    function format(seconds: number): string {
      const safe = Math.max(0, Math.ceil(seconds));
      const minutes = Math.floor(safe / 60);
      const secs = safe % 60;
      return `${String(minutes).padStart(2, "0")}:${String(secs).padStart(2, "0")}`;
    }

    function renderSteps(): void {
      if (!stepsList) return;
      stepsList.replaceChildren();
      preset.steps.forEach((step, index) => {
        const item = document.createElement("li");
        item.className = "timer-step";
        if (index === stepIndex && !finished) item.classList.add("is-active");
        if (index < stepIndex || finished) item.classList.add("is-done");
        item.innerHTML = `
          <span class="step-index">${String(index + 1).padStart(2, "0")}</span>
          <span class="step-copy"><strong>${step.title}</strong><small>${step.minutes} 分钟 · ${step.instruction}</small></span>
          <span class="step-dot">${index < stepIndex || finished ? "✓" : step.minutes + "′"}</span>
        `;
        copyScope(root, item);
        stepsList.appendChild(item);
      });
    }

    function updateClock(): void {
      if (!clock) return;
      const stepSeconds = (preset.steps[stepIndex]?.minutes ?? 1) * 60;
      const stepProgress = 1 - remaining / stepSeconds;
      const overall = Math.min(100, Math.round(((completedSeconds + (stepSeconds - remaining)) / totalSeconds) * 100));
      clock.style.setProperty("--progress", String(Math.max(0, Math.min(100, stepProgress * 100))));
      clock.classList.toggle("is-running", running);
      if (clockTime) clockTime.textContent = format(remaining);
      if (clockLabel) clockLabel.textContent = finished ? "完成！" : running ? "正在练习" : stepIndex === 0 && remaining === stepSeconds ? "准备开始" : "暂停中";
      if (clockStep) clockStep.textContent = finished ? "今天的小星星已点亮" : `第 ${stepIndex + 1} / ${preset.steps.length} 步 · ${preset.steps[stepIndex]?.title ?? ""}`;
      if (overallEl) overallEl.textContent = `${overall}%`;
      if (totalEl) totalEl.textContent = `${preset.minutes} 分钟`;
    }

    function stopInterval(): void {
      if (interval !== null) {
        window.clearInterval(interval);
        interval = null;
      }
    }

    function startInterval(): void {
      stopInterval();
      targetEnd = performance.now() + remaining * 1000;
      interval = window.setInterval(tick, 250);
    }

    function tick(): void {
      if (!running) return;
      const nextRemaining = Math.max(0, (targetEnd - performance.now()) / 1000);
      remaining = Math.ceil(nextRemaining);
      if (nextRemaining <= 0.05) {
        advanceStep();
        return;
      }
      updateClock();
    }

    function advanceStep(): void {
      const current = preset.steps[stepIndex];
      if (current) completedSeconds += current.minutes * 60;
      if (stepIndex >= preset.steps.length - 1) {
        finish();
        return;
      }
      stepIndex += 1;
      remaining = preset.steps[stepIndex]!.minutes * 60;
      targetEnd = performance.now() + remaining * 1000;
      playChime();
      liveEl && (liveEl.textContent = `下一步：${preset.steps[stepIndex]?.title}`);
      renderSteps();
      updateClock();
    }

    function finish(): void {
      running = false;
      finished = true;
      stopInterval();
      remaining = 0;
      completedSeconds = totalSeconds;
      updateClock();
      renderSteps();
      completePanel?.removeAttribute("hidden");
      if (!rewarded) {
        rewarded = true;
        addPracticeSession(preset.minutes);
        playChime();
        celebrate(32);
        renderSessions();
      }
      liveEl && (liveEl.textContent = "练习完成，星星已经收好。");
      if (startBtn) {
        startBtn.innerHTML = `<span class="btn-icon"><svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 11a8 8 0 1 0-2 6"/><path d="M20 4v7h-7"/></svg></span><span>重新开始</span>`;
        startBtn.setAttribute("aria-label", "重新开始练习");
        copyScope(root, startBtn);
      }
    }

    function toggle(): void {
      if (finished) {
        reset();
        return;
      }
      if (running) {
        running = false;
        stopInterval();
        remaining = Math.max(1, Math.ceil((targetEnd - performance.now()) / 1000));
        updateClock();
        if (startBtn) {
          startBtn.innerHTML = `<span class="btn-icon"><svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.2v13.6L19 12 8 5.2Z"/></svg></span><span>继续</span>`;
          copyScope(root, startBtn);
        }
        liveEl && (liveEl.textContent = "计时已暂停。");
        return;
      }
      running = true;
      completePanel?.setAttribute("hidden", "");
      if (startBtn) {
        startBtn.innerHTML = `<span class="btn-icon"><svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M9 5v14M15 5v14"/></svg></span><span>暂停</span>`;
        copyScope(root, startBtn);
      }
      startup();
      liveEl && (liveEl.textContent = `开始：${preset.steps[stepIndex]?.title}`);
    }

    function startup(): void {
      completePanel?.setAttribute("hidden", "");
      startInterval();
      updateClock();
      renderSteps();
    }

    function reset(): void {
      running = false;
      finished = false;
      rewarded = false;
      stopInterval();
      stepIndex = 0;
      completedSeconds = 0;
      remaining = preset.steps[0]!.minutes * 60;
      totalSeconds = preset.steps.reduce((sum, step) => sum + step.minutes * 60, 0);
      completePanel?.setAttribute("hidden", "");
      if (startBtn) {
        startBtn.innerHTML = `<span class="btn-icon"><svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.2v13.6L19 12 8 5.2Z"/></svg></span><span>开始</span>`;
        copyScope(root, startBtn);
      }
      updateClock();
      renderSteps();
      liveEl && (liveEl.textContent = "计时器已重置。");
    }

    function skip(): void {
      if (finished) return;
      if (!running) {
        running = true;
        startup();
      }
      advanceStep();
    }

    function selectPreset(minutes: number): void {
      const next = PRACTICE_PRESETS.find((item) => item.minutes === minutes);
      if (!next) return;
      preset = next;
      presetButtons.forEach((button) => {
        const active = Number(button.dataset.preset) === minutes;
        button.classList.toggle("is-active", active);
        button.setAttribute("aria-pressed", String(active));
      });
      reset();
    }

    function renderSessions(): void {
      const progress = readProgress();
      if (sessionTotal) sessionTotal.textContent = String(progress.sessions.length);
      if (!daysEl) return;
      const days = Array.from({ length: 7 }, (_, index) => {
        const date = new Date();
        date.setDate(date.getDate() - (6 - index));
        return {
          date,
          key: `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, "0")}-${String(date.getDate()).padStart(2, "0")}`,
          label: ["日", "一", "二", "三", "四", "五", "六"][date.getDay()],
        };
      });
      const set = new Set(progress.sessions.map((session) => session.date));
      daysEl.replaceChildren();
      days.forEach((day) => {
        const el = document.createElement("span");
        el.className = "session-day";
        if (set.has(day.key)) el.classList.add("has-practice");
        el.innerHTML = `<small>${day.label}</small><b>${set.has(day.key) ? "★" : "·"}</b>`;
        copyScope(root, el);
        el.title = set.has(day.key) ? `${day.key} 有练习` : day.key;
        daysEl.appendChild(el);
      });
    }

    presetButtons.forEach((button) => {
      button.addEventListener("click", () => {
        if (running) {
          const ok = window.confirm("练习正在进行，要切换时长并重新开始吗？");
          if (!ok) return;
        }
        selectPreset(Number(button.dataset.preset));
      });
    });
    startBtn?.addEventListener("click", toggle);
    resetBtn?.addEventListener("click", reset);
    skipBtn?.addEventListener("click", skip);
    againBtn?.addEventListener("click", reset);

    window.addEventListener("pagehide", stopInterval);
    totalSeconds = preset.steps.reduce((sum, step) => sum + step.minutes * 60, 0);
    remaining = preset.steps[0]!.minutes * 60;
    renderSteps();
    updateClock();
    renderSessions();
  }
</script>

<style>
  .practice-timer {
    padding: clamp(20px, 3.4vw, 32px);
    overflow: hidden;
    background:
      radial-gradient(circle at 96% 0%, rgba(255, 216, 111, 0.16), transparent 25%),
      var(--surface);
  }

  .timer-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    padding-bottom: 17px;
    border-bottom: 1px dashed var(--line);
  }

  .timer-kicker {
    display: block;
    color: var(--violet-700);
    font-family: var(--font-mono);
    font-size: 8.5px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .timer-head h3 {
    margin: 4px 0 4px;
    color: var(--ink);
    font-size: clamp(21px, 2.6vw, 28px);
  }

  .timer-head p {
    margin: 0;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.6;
  }

  .preset-switch {
    display: flex;
    gap: 5px;
    flex: 0 0 auto;
    padding: 4px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface-2);
  }

  .preset-btn {
    min-width: 76px;
    padding: 7px 9px;
    color: var(--muted);
    border: 1px solid transparent;
    border-radius: 9px;
    background: transparent;
    text-align: left;
    transition: background 150ms ease, color 150ms ease;
  }

  .preset-btn strong {
    display: block;
    color: inherit;
    font-family: var(--font-display);
    font-size: 12px;
    line-height: 1.2;
  }

  .preset-btn span {
    display: block;
    overflow: hidden;
    margin-top: 2px;
    font-size: 7px;
    line-height: 1.3;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .preset-btn:hover {
    color: var(--violet-700);
    background: var(--surface);
  }

  .preset-btn.is-active {
    color: #fff;
    background: #5b3fd4;
    box-shadow: 0 2px 0 rgba(56, 32, 130, 0.2);
  }

  .timer-main {
    display: grid;
    grid-template-columns: minmax(240px, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(22px, 4vw, 42px);
    padding-top: 22px;
    align-items: center;
  }

  .timer-clock-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .timer-clock {
    position: relative;
    display: grid;
    place-items: center;
    width: min(100%, 255px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: conic-gradient(var(--violet-500) calc(var(--progress) * 1%), var(--surface-3) 0);
    transition: background 300ms linear;
  }

  .timer-clock::before {
    content: "";
    position: absolute;
    inset: 10px;
    border-radius: 50%;
    background:
      radial-gradient(circle at 38% 27%, rgba(255, 255, 255, 0.9), transparent 26%),
      linear-gradient(145deg, var(--surface), var(--surface-2));
    border: 1px solid var(--line);
  }

  .timer-clock.is-running {
    box-shadow: 0 0 0 8px var(--violet-wash);
  }

  .clock-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .clock-label {
    color: var(--violet-700);
    font-size: 8px;
    font-weight: 850;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .clock-inner strong {
    margin-top: 4px;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: clamp(40px, 5vw, 53px);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  .clock-step {
    max-width: 190px;
    margin-top: 6px;
    color: var(--muted);
    font-size: 10px;
    line-height: 1.45;
  }

  .clock-orbit {
    position: absolute;
    z-index: 0;
    border: 1px dashed var(--line);
    border-radius: 50%;
  }

  .orbit-a {
    inset: -10px;
    animation: orbit-spin 36s linear infinite;
  }

  .orbit-b {
    inset: 24px;
    border-color: rgba(255, 216, 111, 0.35);
    animation: orbit-spin 50s linear infinite reverse;
  }

  .clock-star {
    position: absolute;
    z-index: 2;
    right: 18px;
    top: 22px;
    color: var(--sun-700);
    font-size: 17px;
    animation: clock-star 4s ease-in-out infinite;
  }

  .timer-controls {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 19px;
  }

  .timer-main-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 43px;
    padding: 8px 17px;
    color: #fff;
    border: 1.5px solid rgba(255, 255, 255, 0.18);
    border-radius: 999px;
    background: linear-gradient(135deg, var(--violet-600), #5b3ed1);
    box-shadow: 0 4px 0 #4a31b4;
    font-size: 11px;
    font-weight: 850;
  }

  .timer-main-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 5px 0 #4a31b4;
  }

  .timer-icon-btn {
    display: grid;
    place-items: center;
    width: 37px;
    height: 37px;
    padding: 0;
    color: var(--ink-soft);
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--surface-2);
  }

  .timer-icon-btn:hover {
    color: var(--violet-700);
    background: var(--violet-wash);
  }

  .timer-sound {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    margin-left: 2px;
    color: var(--faint);
    font-size: 9px;
  }

  .timer-steps {
    min-width: 0;
    padding: 12px 15px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--surface-2);
  }

  .timer-steps-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 8px;
    border-bottom: 1px dashed var(--line);
    color: var(--violet-700);
    font-size: 8px;
    font-weight: 850;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .timer-steps ol {
    display: grid;
    gap: 2px;
    margin: 8px 0 5px;
    padding: 0;
    list-style: none;
  }

  .timer-step {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 8px;
    border: 1px solid transparent;
    border-radius: 9px;
    color: var(--muted);
    transition: background 150ms ease, border-color 150ms ease;
  }

  .timer-step.is-active {
    border-color: var(--violet-300);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }

  .timer-step.is-done {
    opacity: 0.55;
  }

  .step-index {
    color: var(--violet-700);
    font-family: var(--font-mono);
    font-size: 8px;
    font-weight: 800;
  }

  .step-copy {
    flex: 1;
    min-width: 0;
  }

  .step-copy strong {
    display: block;
    color: var(--ink);
    font-size: 13px;
    font-weight: 750;
    line-height: 1.4;
  }

  .step-copy small {
    display: block;
    margin-top: 2px;
    color: var(--ink-soft);
    font-size: 10.5px;
    line-height: 1.5;
    white-space: normal;
  }

  .step-dot {
    display: grid;
    place-items: center;
    flex: 0 0 25px;
    width: 25px;
    height: 25px;
    color: var(--violet-700);
    border-radius: 50%;
    background: var(--violet-wash);
    font-family: var(--font-mono);
    font-size: 8px;
    font-weight: 800;
  }

  .timer-step.is-done .step-dot {
    color: #fff;
    background: var(--mint-500);
  }

  .timer-progress-text {
    padding-top: 6px;
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 8px;
    text-align: right;
  }

  .timer-progress-text span {
    color: var(--violet-700);
    font-weight: 800;
  }

  .timer-complete {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 16px;
    padding: 14px 16px;
    border: 1px solid rgba(219, 169, 54, 0.3);
    border-radius: 14px;
    background: var(--sun-wash);
  }

  .complete-star {
    display: grid;
    place-items: center;
    flex: 0 0 43px;
    width: 43px;
    height: 43px;
    color: #80580c;
    border-radius: 14px;
    background: var(--sun-500);
    box-shadow: 0 3px 0 rgba(183, 129, 28, 0.3);
    transform: rotate(-5deg);
  }

  .timer-complete > div:nth-child(2) {
    flex: 1;
  }

  .complete-kicker {
