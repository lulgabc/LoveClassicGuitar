---
import { SCORE_LIBRARY, type ScoreLibraryEntry, type ScoreLibraryFocus } from "../data/score-library";
import Icon from "./Icon.astro";

interface Props {
  scores?: ScoreLibraryEntry[];
  lang?: "zh" | "fr";
}

const { scores = SCORE_LIBRARY, lang = "zh" } = Astro.props;
const isFr = lang === "fr";

const levelLabels: Record<number, string> = isFr
  ? { 1: "Éveil", 2: "Débutant", 3: "Intermédiaire", 4: "Avancé", 5: "Concert" }
  : { 1: "启蒙", 2: "初级", 3: "中级", 4: "进阶", 5: "高级" };

const focusLabels: Record<ScoreLibraryFocus, string> = isFr
  ? {
      right: "Main droite",
      left: "Main gauche",
      reading: "Lecture",
      rhythm: "Rythme",
      tone: "Son",
      phrasing: "Phrasé",
      ensemble: "Ensemble",
    }
  : {
      right: "右手",
      left: "左手",
      reading: "读谱",
      rhythm: "节奏",
      tone: "音色",
      phrasing: "乐句",
      ensemble: "合奏",
    };

const eraLabels: Record<string, string> = isFr
  ? { renaissance: "Renaissance", baroque: "Baroque", classical: "Classique", romantic: "Romantique", modern: "Moderne", unknown: "Inconnu" }
  : { renaissance: "文艺复兴", baroque: "巴洛克", classical: "古典", romantic: "浪漫", modern: "现代", unknown: "未知" };

const t = isFr
  ? {
      searchPlaceholder: "Chercher un titre, un compositeur ou un objectif…",
      searchLabel: "Chercher dans la bibliothèque de partitions",
      levelLabel: "Niveau",
      focusLabel: "Objectif",
      all: "Tous",
      count: (shown: number, total: number) => `${shown} / ${total} partitions`,
      more: (step: number) => `Afficher ${step} partitions de plus`,
      empty: "Aucune partition trouvée. Essaie un mot plus court ou enlève un filtre.",
      open: "Voir la partition complète",
      close: "Fermer",
      loading: "Rendu de la partition…",
      error: "Le rendu a échoué. Télécharge le MusicXML et ouvre-le dans MuseScore.",
      zoomIn: "Agrandir",
      zoomOut: "Réduire",
      source: "Source",
      download: "Télécharger le MusicXML",
      tip: "Conseil",
      note: "Les 200 partitions viennent des arrangements GuitarLoot, utilisés avec sa permission de réutilisation avec attribution. Le site héberge les fichiers MusicXML et les rend avec OpenSheetMusicDisplay.",
      scoreArea: "Partition rendue",
      staff: "Portée",
      jianpu: "Jianpu",
      viewLabel: "Choisir le type de partition",
      jianpuLoading: "Conversion du jianpu…",
      jianpuError: "Échec de la conversion jianpu. Regarde la portée ou télécharge le MusicXML.",
      jianpuHint: "Le jianpu affiche la mélodie principale ; la portée montre toutes les voix et les accords.",
      lineLabel: (start: number, end: number) => `Mesures ${start}–${end}`,
    }
  : {
      searchPlaceholder: "搜曲名、作曲家或练习重点…",
      searchLabel: "在乐谱库中搜索",
      levelLabel: "难度",
      focusLabel: "练习重点",
      all: "全部",
      count: (shown: number, total: number) => `显示 ${shown} / ${total} 首`,
      more: (step: number) => `再看 ${step} 首`,
      empty: "没有找到。换个短一点的词，或者去掉一个筛选条件。",
      open: "查看完整乐谱",
      close: "关闭",
      loading: "正在渲染乐谱…",
      error: "乐谱渲染失败。可以下载 MusicXML，用 MuseScore 打开。",
      zoomIn: "放大",
      zoomOut: "缩小",
      source: "来源",
      download: "下载 MusicXML",
      tip: "练习提示",
      note: "200 首乐谱来自 GuitarLoot 的许可编配，按来源署名要求使用。本站托管 MusicXML 文件，并用 OpenSheetMusicDisplay 在页面内渲染。",
      scoreArea: "乐谱渲染区域",
      staff: "五线谱",
      jianpu: "简谱",
      viewLabel: "选择乐谱显示方式",
      jianpuLoading: "正在转换简谱…",
      jianpuError: "简谱转换失败。可以先看五线谱，或下载 MusicXML。",
      jianpuHint: "简谱显示主旋律；完整和弦与声部请看五线谱。",
      lineLabel: (start: number, end: number) => `第 ${start}–${end} 小节`,
    };

const step = 24;
const focusKeys = Object.keys(focusLabels) as ScoreLibraryFocus[];
const levelCounts = [1, 2, 3, 4, 5].map((level) => scores.filter((score) => score.level === level).length);
---

<div class="full-scores" data-full-scores data-lang={lang} data-step={step} data-base={import.meta.env.BASE_URL}>
  <div class="score-toolbar">
    <label class="score-search">
      <Icon name="search" size={17} />
      <span class="sr-only">{t.searchLabel}</span>
      <input type="search" placeholder={t.searchPlaceholder} data-score-search />
    </label>
    <span class="score-count" data-score-count>{t.count(scores.length, scores.length)}</span>
  </div>

  <div class="score-filters">
    <div class="score-filter-row" role="group" aria-label={t.levelLabel}>
      <span class="score-filter-label">{t.levelLabel}</span>
      <button type="button" class="score-chip is-active" data-score-level="all" aria-pressed="true">{t.all}</button>
      {([1, 2, 3, 4, 5] as const).map((level) => (
        <button type="button" class="score-chip" data-score-level={level} aria-pressed="false">{level} · {levelLabels[level]} ({levelCounts[level - 1]})</button>
      ))}
    </div>
    <div class="score-filter-row" role="group" aria-label={t.focusLabel}>
      <span class="score-filter-label">{t.focusLabel}</span>
      <button type="button" class="score-chip is-active" data-score-focus="all" aria-pressed="true">{t.all}</button>
      {focusKeys.map((focus) => (
        <button type="button" class="score-chip" data-score-focus={focus} aria-pressed="false">{focusLabels[focus]}</button>
      ))}
    </div>
  </div>

  <div class="score-grid">
    {
      scores.map((score) => (
        <article
          class:list={["score-card", "card", `level-${score.level}`]}
          data-score-item
          data-level={score.level}
          data-focus={score.focus}
          data-search={`${score.title} ${score.composer} ${focusLabels[score.focus]} ${levelLabels[score.level]} ${eraLabels[score.era] ?? score.era}`.toLowerCase()}
        >
          <div class="score-top">
            <span class="score-level">{score.level} · {levelLabels[score.level]}</span>
            <span class="score-grade">G{score.grade}</span>
          </div>
          <h3>{score.title}</h3>
          <p class="score-composer">{score.composer}</p>
          <div class="score-meta">
            <span class="score-focus">{focusLabels[score.focus]}</span>
            <span class="score-era">{eraLabels[score.era] ?? score.era}</span>
          </div>
          <p class="score-tip"><strong>{t.tip}:</strong> {isFr ? score.tipFr : score.tipZh}</p>
          <button
            type="button"
            class="score-open"
            data-score-open
            data-file={score.file}
            data-title={score.title}
            data-composer={score.composer}
            data-level={`${score.level} · ${levelLabels[score.level]}`}
            data-focus={focusLabels[score.focus]}
            data-tip={isFr ? score.tipFr : score.tipZh}
            data-source={score.source}
            data-source-url={score.sourceUrl}
          >
            <Icon name="book" size={11} /> {t.open}
          </button>
        </article>
      ))
    }
  </div>

  <p class="score-empty" data-score-empty hidden>{t.empty}</p>
  <div class="score-more-wrap" data-score-more-wrap>
    <button type="button" class="btn btn-secondary btn-sm" data-score-more>{t.more(step)}</button>
  </div>
  <p class="score-note"><Icon name="info" size={13} /> {t.note}</p>

  <dialog class="full-score-modal" data-score-modal aria-labelledby="full-score-modal-title">
    <div class="full-score-panel">
      <div class="full-score-head">
        <span class="full-score-kicker" data-score-modal-kicker></span>
        <button type="button" class="full-score-close" data-score-close aria-label={t.close}>×</button>
      </div>
      <h2 id="full-score-modal-title" data-score-modal-title></h2>
      <p class="full-score-meta" data-score-modal-meta></p>
      <div class="full-score-toolbar">
        <div class="score-view-switch" role="group" aria-label={t.viewLabel}>
          <button type="button" class="is-active" data-score-view="staff" aria-pressed="true">{t.staff}</button>
          <button type="button" data-score-view="jianpu" aria-pressed="false">{t.jianpu}</button>
        </div>
        <button type="button" data-score-zoom-out data-staff-control aria-label={t.zoomOut}>−</button>
        <button type="button" data-score-zoom-in data-staff-control aria-label={t.zoomIn}>+</button>
        <a data-score-source-link target="_blank" rel="noopener noreferrer">{t.source} <Icon name="external" size={11} /></a>
        <a data-score-download download>{t.download}</a>
      </div>
      <div class="full-score-stage" data-staff-stage role="region" tabindex="0" aria-label={t.scoreArea}>
        <div class="full-score-render" data-score-render></div>
      </div>
      <div class="full-score-stage jianpu-stage" data-jianpu-stage role="region" tabindex="0" aria-label={t.jianpu} hidden>
        <p class="jianpu-hint">{t.jianpuHint}</p>
        <div class="jianpu-lines" data-jianpu-render></div>
      </div>
      <p class="full-score-tip" data-score-modal-tip></p>
      <div class="full-score-actions">
        <button class="btn btn-ghost btn-sm" type="button" data-score-close>{t.close}</button>
      </div>
    </div>
  </dialog>
</div>

<noscript>
  <style>[data-score-more-wrap] { display: none; }</style>
</noscript>

<script>
  const root = document.querySelector<HTMLElement>("[data-full-scores]");
  if (root) {
    const items = Array.from(root.querySelectorAll<HTMLElement>("[data-score-item]"));
    const search = root.querySelector<HTMLInputElement>("[data-score-search]");
    const count = root.querySelector<HTMLElement>("[data-score-count]");
    const empty = root.querySelector<HTMLElement>("[data-score-empty]");
    const moreWrap = root.querySelector<HTMLElement>("[data-score-more-wrap]");
    const more = root.querySelector<HTMLButtonElement>("[data-score-more]");
    const levelButtons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-score-level]"));
    const focusButtons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-score-focus]"));
    const modal = root.querySelector<HTMLDialogElement>("[data-score-modal]");
    const modalTitle = root.querySelector<HTMLElement>("[data-score-modal-title]");
    const modalKicker = root.querySelector<HTMLElement>("[data-score-modal-kicker]");
    const modalMeta = root.querySelector<HTMLElement>("[data-score-modal-meta]");
    const modalTip = root.querySelector<HTMLElement>("[data-score-modal-tip]");
    const renderEl = root.querySelector<HTMLElement>("[data-score-render]");
    const staffStage = root.querySelector<HTMLElement>("[data-staff-stage]");
    const jianpuStage = root.querySelector<HTMLElement>("[data-jianpu-stage]");
    const jianpuRender = root.querySelector<HTMLElement>("[data-jianpu-render]");
    const viewButtons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-score-view]"));
    const staffControls = Array.from(root.querySelectorAll<HTMLElement>("[data-staff-control]"));
    const sourceLink = root.querySelector<HTMLAnchorElement>("[data-score-source-link]");
    const downloadLink = root.querySelector<HTMLAnchorElement>("[data-score-download]");
    const zoomIn = root.querySelector<HTMLButtonElement>("[data-score-zoom-in]");
    const zoomOut = root.querySelector<HTMLButtonElement>("[data-score-zoom-out]");
    const isFr = root.dataset.lang === "fr";
    const base = root.dataset.base ?? "/";
    const step = Number(root.dataset.step || 24);
    let level = "all";
    let focus = "all";
    let limit = step;
    let lastFocus: HTMLElement | null = null;
    let osmd: any = null;
    let osmdCtor: any = null;
    let jianpuCtor: any = null;
    let jszipCtor: any = null;
    let currentFile = "";
    let currentXml = "";
    let currentXmlFile = "";
    let jianpuRenderers: any[] = [];

    const labels = isFr
      ? {
          loading: "Rendu de la partition…",
          error: "Le rendu a échoué. Télécharge le MusicXML et ouvre-le dans MuseScore.",
          jianpuLoading: "Conversion du jianpu…",
          jianpuError: "Échec de la conversion jianpu. Regarde la portée ou télécharge le MusicXML.",
          lineLabel: (start: number, end: number) => `Mesures ${start}–${end}`,
        }
      : {
          loading: "正在渲染乐谱…",
          error: "乐谱渲染失败。可以下载 MusicXML，用 MuseScore 打开。",
          jianpuLoading: "正在转换简谱…",
          jianpuError: "简谱转换失败。可以先看五线谱，或下载 MusicXML。",
          lineLabel: (start: number, end: number) => `第 ${start}–${end} 小节`,
        };

    const countLabel = (shown: number, total: number) => isFr ? `${shown} / ${total} partitions` : `显示 ${shown} / ${total} 首`;
    const moreLabel = (n: number) => isFr ? `Afficher ${n} partitions de plus` : `再看 ${n} 首`;

    function apply(reset = false): void {
      if (reset) limit = step;
      const query = (search?.value ?? "").trim().toLowerCase();
      let matching = 0;
      items.forEach((item) => {
        const matches =
          (level === "all" || item.dataset.level === level) &&
          (focus === "all" || item.dataset.focus === focus) &&
          (!query || (item.dataset.search ?? "").includes(query));
        const show = matches && matching < limit;
        if (matches) matching += 1;
        item.hidden = !show;
      });
      if (count) count.textContent = countLabel(Math.min(matching, limit), matching);
      if (empty) empty.hidden = matching !== 0;
      if (moreWrap) moreWrap.hidden = matching <= limit;
      if (more) more.textContent = moreLabel(Math.min(step, Math.max(0, matching - limit)));
    }

    function selectChip(buttons: HTMLButtonElement[], activeButton: HTMLButtonElement): void {
      buttons.forEach((button) => {
        const active = button === activeButton;
        button.classList.toggle("is-active", active);
        button.setAttribute("aria-pressed", String(active));
      });
    }

    levelButtons.forEach((button) => {
      button.addEventListener("click", () => {
        level = button.dataset.scoreLevel ?? "all";
        selectChip(levelButtons, button);
        apply(true);
      });
    });
    focusButtons.forEach((button) => {
      button.addEventListener("click", () => {
        focus = button.dataset.scoreFocus ?? "all";
        selectChip(focusButtons, button);
        apply(true);
      });
    });
    search?.addEventListener("input", () => apply(true));
    more?.addEventListener("click", () => {
      limit += step;
      apply();
    });

    async function renderScore(file: string): Promise<void> {
      if (!renderEl) return;
      renderEl.innerHTML = `<p class="score-loading">${labels.loading}</p>`;
      try {
        if (!osmdCtor) {
          const module = await import("opensheetmusicdisplay");
          osmdCtor = module.OpenSheetMusicDisplay;
        }
        renderEl.innerHTML = "";
        osmd = new osmdCtor(renderEl, {
          autoResize: true,
          drawingParameters: "compacttight",
          backend: "svg",
        });
        await osmd.load(`${base}scores/${file}`);
        osmd.Zoom = window.innerWidth < 640 ? 0.72 : 1;
        osmd.render();
      } catch (error) {
        renderEl.innerHTML = `<p class="score-error">${labels.error}</p>`;
      }
    }

    function clearJianpu(): void {
      jianpuRenderers.forEach((renderer) => {
        try {
          renderer.destroy();
        } catch {
          // ignore a renderer that was already destroyed
        }
      });
      jianpuRenderers = [];
      if (jianpuRender) jianpuRender.innerHTML = "";
    }

    async function getXml(file: string): Promise<string> {
      if (currentXml && currentXmlFile === file) return currentXml;
      const response = await fetch(`${base}scores/${file}`);
      if (!response.ok) throw new Error("score fetch failed");
      const buffer = await response.arrayBuffer();
      if (!jszipCtor) {
        const module = await import("jszip");
        jszipCtor = module.default ?? module;
      }
      const zip = await jszipCtor.loadAsync(buffer);
      const containerFile = zip.file("META-INF/container.xml");
      if (containerFile) {
        const containerXml = await containerFile.async("string");
        const match = containerXml.match(/full-path="([^"]+)"/);
        const scoreFile = match?.[1] ? zip.file(match[1]) : null;
        if (scoreFile) {
          const xml = await scoreFile.async("string");
          currentXml = xml;
          currentXmlFile = file;
          return xml;
        }
      }
      const name = Object.keys(zip.files).find(
        (entry) => /\.(xml|musicxml)$/i.test(entry) && !entry.startsWith("META-INF/"),
      );
      if (!name) throw new Error("musicxml missing");
      const xml = await zip.file(name)!.async("string");
      currentXml = xml;
      currentXmlFile = file;
      return xml;
    }

    async function renderJianpu(file: string): Promise<void> {
      if (!jianpuRender || !file) return;
      jianpuRender.innerHTML = `<p class="score-loading">${labels.jianpuLoading}</p>`;
      try {
        const [xml, jianpuModule] = await Promise.all([
          getXml(file),
          jianpuCtor ? Promise.resolve({ JianpuSVGRender: jianpuCtor }) : import("jianpurender"),
        ]);
        jianpuCtor = jianpuModule.JianpuSVGRender;
        const { buildJianpuLines, parseMusicXml, selectMelody } = await import("../lib/jianpu");
        const measures = selectMelody(parseMusicXml(xml));
        const perLine = window.innerWidth < 640 ? 2 : 4;
        const lines = buildJianpuLines(measures, perLine);
        if (!lines.length) throw new Error("empty jianpu");
        clearJianpu();
        lines.forEach((line, index) => {
          const section = document.createElement("section");
          section.className = "jianpu-line";
          const label = document.createElement("p");
          label.className = "jianpu-line-label";
          label.textContent = labels.lineLabel(line.startMeasure, line.endMeasure);
          const holder = document.createElement("div");
          holder.className = "jianpu-line-svg";
          section.append(label, holder);
          jianpuRender.appendChild(section);
          const renderer = new jianpuCtor(
            {
              notes: line.notes,
              keySignatures: line.keySignatures,
              timeSignatures: line.timeSignatures,
              tempos: line.tempos,
            },
            {
              noteHeight: window.innerWidth < 640 ? 22 : 26,
              showBarNumbers: false,
              showTempoMarking: index === 0,
              noteSpacingFactor: 1.25,
              noteColor: "#1b1247",
              fontFamily: "sans-serif",
            },
            holder,
          );
          jianpuRenderers.push(renderer);
        });
      } catch (error) {
        jianpuRender.innerHTML = `<p class="score-error">${labels.jianpuError}</p>`;
      }
    }

    function setView(view: "staff" | "jianpu"): void {
      viewButtons.forEach((button) => {
        const active = button.dataset.scoreView === view;
        button.classList.toggle("is-active", active);
        button.setAttribute("aria-pressed", String(active));
      });
      staffControls.forEach((control) => {
        control.hidden = view !== "staff";
      });
      if (staffStage) staffStage.hidden = view !== "staff";
      if (jianpuStage) jianpuStage.hidden = view !== "jianpu";
      if (view === "jianpu" && currentFile) void renderJianpu(currentFile);
    }

    function openModal(button: HTMLButtonElement): void {
      if (!modal) return;
      if (modalTitle) modalTitle.textContent = button.dataset.title ?? "";
      if (modalKicker) modalKicker.textContent = `${button.dataset.level ?? ""} · ${button.dataset.focus ?? ""}`;
      if (modalMeta) modalMeta.textContent = button.dataset.composer ?? "";
      if (modalTip) modalTip.textContent = button.dataset.tip ?? "";
      if (sourceLink) sourceLink.href = button.dataset.sourceUrl ?? "https://guitarloot.org.uk/";
      if (downloadLink) {
        downloadLink.href = `${base}scores/${button.dataset.file ?? ""}`;
        downloadLink.setAttribute("download", button.dataset.file ?? "score.mxl");
      }
      currentFile = button.dataset.file ?? "";
      currentXml = "";
      currentXmlFile = "";
      clearJianpu();
      setView("staff");
      lastFocus = button;
      if (!modal.open) modal.showModal();
      document.body.classList.add("score-modal-open");
      modal.querySelector<HTMLButtonElement>("[data-score-close]")?.focus();
      void renderScore(currentFile);
    }

    function closeModal(): void {
      if (modal?.open) modal.close();
    }

    root.querySelectorAll<HTMLButtonElement>("[data-score-open]").forEach((button) => {
      button.addEventListener("click", () => openModal(button));
    });
    root.querySelectorAll<HTMLElement>("[data-score-close]").forEach((button) => {
      button.addEventListener("click", closeModal);
    });
    modal?.addEventListener("close", () => {
      document.body.classList.remove("score-modal-open");
      clearJianpu();
      lastFocus?.focus();
    });
    modal?.addEventListener("click", (event) => {
      if (event.target === modal) modal.close();
    });

    viewButtons.forEach((button) => {
      button.addEventListener("click", () => {
        setView(button.dataset.scoreView === "jianpu" ? "jianpu" : "staff");
      });
    });

    zoomIn?.addEventListener("click", () => {
      if (!osmd) return;
      osmd.Zoom = Math.min(2, Number(osmd.Zoom || 1) + 0.1);
      osmd.render();
    });
    zoomOut?.addEventListener("click", () => {
      if (!osmd) return;
      osmd.Zoom = Math.max(0.4, Number(osmd.Zoom || 1) - 0.1);
      osmd.render();
    });

    apply();
  }
</script>

<style>
  .score-toolbar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 9px;
    margin-bottom: 11px;
  }

  .score-search {
    display: flex;
    align-items: center;
    gap: 7px;
    flex: 1 1 280px;
    min-width: 0;
    min-height: 43px;
    padding: 0 13px;
    color: var(--muted);
    border: 1.5px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
  }

  .score-search:focus-within {
    border-color: var(--violet-500);
    box-shadow: 0 0 0 3px var(--violet-wash);
  }

  .score-search input {
    flex: 1;
    min-width: 0;
    min-height: 39px;
    padding: 0;
    color: var(--ink);
    border: 0;
    outline: 0;
    background: transparent;
    font-size: 12px;
  }

  .score-search input::placeholder {
    color: var(--faint);
  }

  .score-count {
    margin-left: auto;
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 8.5px;
    white-space: nowrap;
  }

  .score-filters {
    display: grid;
    gap: 6px;
    margin-bottom: 14px;
  }

  .score-filter-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 4px;
  }

  .score-filter-label {
    flex: 0 0 54px;
    color: var(--violet-700);
    font-family: var(--font-mono);
    font-size: 8px;
    font-weight: 800;
  }

  .score-chip {
