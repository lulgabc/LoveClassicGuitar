---
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<svg
  class={`mascot mascot-bat ${className}`}
  viewBox="0 0 240 210"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id="bat-body" x1="82" y1="36" x2="164" y2="180" gradientUnits="userSpaceOnUse">
      <stop stop-color="#9B7BFF"></stop>
      <stop offset="1" stop-color="#6544C8"></stop>
    </linearGradient>
    <linearGradient id="bat-wing" x1="22" y1="50" x2="106" y2="120" gradientUnits="userSpaceOnUse">
      <stop stop-color="#7D5BE6"></stop>
      <stop offset="1" stop-color="#4D348F"></stop>
    </linearGradient>
    <linearGradient id="bat-ear" x1="83" y1="18" x2="103" y2="58" gradientUnits="userSpaceOnUse">
      <stop stop-color="#8C6CF0"></stop>
      <stop offset="1" stop-color="#6746C9"></stop>
    </linearGradient>
    <filter id="bat-soft" x="8" y="0" width="224" height="210" filterUnits="userSpaceOnUse">
      <feDropShadow dx="0" dy="8" stdDeviation="8" flood-color="#2A176A" flood-opacity="0.22"></feDropShadow>
    </filter>
  </defs>

  <g filter="url(#bat-soft)">
    <g class="bat-wing wing-left">
      <path
        d="M84 88C68 62 42 46 14 53c15 10 20 24 14 39 15-5 25 4 24 20 12-10 22-6 29 8 4-13 9-23 16-29"
        fill="url(#bat-wing)"
        stroke="#3F2A7B"
        stroke-width="4"
        stroke-linejoin="round"
      ></path>
      <path
        d="M76 85C61 68 43 59 26 60M39 91c5-5 12-4 17 3M31 74c12 4 22 13 27 25"
        stroke="#B6A2FF"
        stroke-opacity="0.45"
        stroke-width="2.4"
        stroke-linecap="round"
      ></path>
    </g>

    <g class="bat-wing wing-right">
      <g transform="translate(240 0) scale(-1 1)">
        <path
          d="M84 88C68 62 42 46 14 53c15 10 20 24 14 39 15-5 25 4 24 20 12-10 22-6 29 8 4-13 9-23 16-29"
          fill="url(#bat-wing)"
          stroke="#3F2A7B"
          stroke-width="4"
          stroke-linejoin="round"
        ></path>
        <path
          d="M76 85C61 68 43 59 26 60M39 91c5-5 12-4 17 3M31 74c12 4 22 13 27 25"
          stroke="#B6A2FF"
          stroke-opacity="0.45"
          stroke-width="2.4"
          stroke-linecap="round"
        ></path>
      </g>
    </g>

    <path
      d="M120 117c-31 0-50 21-50 49 0 27 21 39 50 39s50-12 50-39c0-28-19-49-50-49Z"
      fill="url(#bat-body)"
      stroke="#3F2A7B"
      stroke-width="4"
    ></path>
    <ellipse cx="120" cy="159" rx="28" ry="34" fill="#C1AEFF" opacity="0.38"></ellipse>

    <path
      d="M84 58 70 13c0-4 5-6 8-3l31 24M156 58l14-45c0-4-5-6-8-3l-31 24"
      fill="url(#bat-ear)"
      stroke="#3F2A7B"
      stroke-width="4"
      stroke-linejoin="round"
    ></path>
    <path d="m84 47-8-24 20 16M156 47l8-24-20 16" fill="#FFB2DE"></path>

    <circle cx="120" cy="74" r="52" fill="url(#bat-body)" stroke="#3F2A7B" stroke-width="4"></circle>
    <path
      d="M96 30c8-8 20-10 29-4 8-6 18-4 22 4-9-2-13 4-17 9-7-7-18-8-34-9Z"
      fill="#8D6DF1"
      stroke="#3F2A7B"
      stroke-width="3.2"
      stroke-linejoin="round"
    ></path>

    <g class="bat-eye">
      <ellipse cx="101" cy="73" rx="15" ry="17" fill="#FFF9FF"></ellipse>
      <ellipse cx="104" cy="76" rx="8" ry="10" fill="#30205F"></ellipse>
      <circle cx="107" cy="72" r="3.2" fill="#FFFFFF"></circle>
    </g>
    <g class="bat-eye bat-eye-right">
      <ellipse cx="139" cy="73" rx="15" ry="17" fill="#FFF9FF"></ellipse>
      <ellipse cx="136" cy="76" rx="8" ry="10" fill="#30205F"></ellipse>
      <circle cx="139" cy="72" r="3.2" fill="#FFFFFF"></circle>
    </g>

    <ellipse cx="91" cy="92" rx="8" ry="4.5" fill="#FFA8D8" opacity="0.72"></ellipse>
    <ellipse cx="149" cy="92" rx="8" ry="4.5" fill="#FFA8D8" opacity="0.72"></ellipse>
    <path d="M112 91h16" stroke="#3F2A7B" stroke-width="3" stroke-linecap="round"></path>
    <path
      d="M105 96c4 7 10 10 15 10s11-3 15-10"
      stroke="#3F2A7B"
      stroke-width="3"
      stroke-linecap="round"
    ></path>
    <path d="m112 99 3 8 3-7M125 99l3 8 3-7" fill="#FFF9E8"></path>

    <ellipse cx="104" cy="202" rx="12" ry="7" fill="#4A318B"></ellipse>
    <ellipse cx="136" cy="202" rx="12" ry="7" fill="#4A318B"></ellipse>

    <path
      d="m120 116 3.3 6.7 7.4 1.1-5.4 5.2 1.3 7.4-6.6-3.5-6.6 3.5 1.3-7.4-5.4-5.2 7.4-1.1 3.3-6.7Z"
      fill="#FFD86F"
      stroke="#9C6A22"
      stroke-width="2"
    ></path>
    <circle cx="54" cy="45" r="3.5" fill="#FFD86F"></circle>
    <path d="m190 38 2 4.5 4.5 2-4.5 2-2 4.5-2-4.5-4.5-2 4.5-2 2-4.5Z" fill="#BDEBFF"></path>
  </g>
</svg>

<style>
  .mascot-bat {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .bat-wing {
    transform-box: view-box;
    animation: bat-flutter 2.2s ease-in-out infinite;
    will-change: transform;
  }

  .wing-left {
    transform-origin: 86px 87px;
  }

  .wing-right {
    transform-origin: 154px 87px;
    animation-delay: -0.12s;
  }

  .bat-eye {
    transform-box: fill-box;
    transform-origin: center;
    animation: bat-blink 6.2s ease-in-out infinite;
  }

  .bat-eye-right {
    animation-delay: 0.08s;
  }

  @keyframes bat-flutter {
    0%,
    100% {
      transform: rotate(0deg);
    }
    50% {
      transform: rotate(-8deg);
    }
  }

  @keyframes bat-blink {
    0%,
    92%,
    100% {
      transform: scaleY(1);
    }
    95% {
      transform: scaleY(0.08);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bat-wing,
    .bat-eye {
      animation: none;
    }
  }
</style>
