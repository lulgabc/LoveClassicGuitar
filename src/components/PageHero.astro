---
import Icon from "./Icon.astro";
import Capybara from "./Capybara.astro";
import Bat from "./Bat.astro";

interface Props {
  kicker?: string;
  title: string;
  lead?: string;
  compact?: boolean;
}

const { kicker, title, lead, compact = false } = Astro.props;
---

<section class:list={["page-hero", { compact }]}>
  <div class="page-hero-stars" aria-hidden="true">
    <span></span><span></span><span></span><span></span><span></span><span></span>
  </div>
  <div class="container page-hero-grid">
    <div class="page-hero-copy">
      {kicker && <span class="page-hero-kicker">{kicker}</span>}
      <h1 set:html={title} />
      {lead && <p class="page-hero-lead">{lead}</p>}
      <slot />
    </div>

    <div class="page-hero-art" aria-hidden="true">
      <slot name="art">
        <div class="art-orbit">
          <span class="orbit orbit-a"></span>
          <span class="orbit orbit-b"></span>
          <span class="orbit orbit-c"></span>
          <svg class="constellation-guitar" viewBox="0 0 300 340" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M150 22 164 60 151 94 150 118" stroke="#C7B6FF" stroke-width="1.4" stroke-dasharray="4 7"></path>
            <path d="M112 116 86 176 73 254 126 290 172 286 217 246 198 168 170 114" stroke="#C7B6FF" stroke-width="1.4" stroke-dasharray="4 7"></path>
            <path d="M112 116c25-14 46-14 58-2" stroke="#C7B6FF" stroke-width="1.4" stroke-dasharray="4 7"></path>
            <path d="M150 118v-24" stroke="#FFD86F" stroke-width="2"></path>
            <circle cx="150" cy="22" r="4" fill="#FFD86F"></circle>
            <circle cx="164" cy="60" r="3" fill="#C7B6FF"></circle>
            <circle cx="151" cy="94" r="3" fill="#C7B6FF"></circle>
            <circle cx="112" cy="116" r="3.5" fill="#FFD86F"></circle>
            <circle cx="170" cy="114" r="3.5" fill="#FFD86F"></circle>
            <circle cx="86" cy="176" r="3.5" fill="#BEEBFF"></circle>
            <circle cx="198" cy="168" r="3.5" fill="#BEEBFF"></circle>
            <circle cx="73" cy="254" r="3.5" fill="#FFB0DE"></circle>
            <circle cx="217" cy="246" r="3.5" fill="#FFB0DE"></circle>
            <circle cx="126" cy="290" r="4" fill="#FFD86F"></circle>
            <circle cx="172" cy="286" r="4" fill="#FFD86F"></circle>
            <circle cx="150" cy="192" r="20" stroke="#FFD86F" stroke-width="1.5" stroke-dasharray="3 5"></circle>
            <circle cx="150" cy="192" r="8" fill="#FFD86F" fill-opacity="0.9"></circle>
            <path d="M143 208h14M139 216h22" stroke="#FFD86F" stroke-width="2" stroke-linecap="round"></path>
            <path d="m252 62 3 7 7 1-5 5 1 7-6-3-7 3 1-7-5-5 7-1 3-7Z" fill="#FFD86F"></path>
            <path d="m50 92 2 4.5 4.5 2-4.5 2-2 4.5-2-4.5-4.5-2 4.5-2 2-4.5Z" fill="#BEEBFF"></path>
          </svg>
          <span class="art-star art-star-a"><Icon name="star" size={24} /></span>
          <span class="art-star art-star-b"><Icon name="sparkle" size={20} /></span>
          <div class="art-mascot art-capy"><Capybara /></div>
          <div class="art-mascot art-bat"><Bat /></div>
        </div>
      </slot>
    </div>
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    margin-bottom: clamp(18px, 2.4vw, 28px);
    padding-block: clamp(32px, 4.2vw, 50px) clamp(28px, 3.6vw, 44px);
    color: #f8f1ff;
    background:
      radial-gradient(circle at 84% 15%, rgba(255, 216, 111, 0.14), transparent 25%),
      radial-gradient(circle at 16% 0%, rgba(116, 87, 242, 0.55), transparent 35%),
      radial-gradient(circle at 75% 85%, rgba(93, 202, 250, 0.16), transparent 32%),
      linear-gradient(135deg, #25175c 0%, #1a1146 62%, #120c32 100%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .page-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      radial-gradient(1.2px 1.2px at 12% 22%, rgba(255, 246, 205, 0.8), transparent),
      radial-gradient(1px 1px at 42% 17%, rgba(206, 237, 255, 0.7), transparent),
      radial-gradient(1px 1px at 66% 33%, rgba(255, 246, 205, 0.55), transparent),
      radial-gradient(1.4px 1.4px at 88% 18%, rgba(255, 246, 205, 0.6), transparent),
      radial-gradient(1px 1px at 77% 72%, rgba(206, 237, 255, 0.55), transparent);
    opacity: 0.8;
  }

  .page-hero.compact {
    padding-block: 28px 30px;
  }

  .page-hero-stars {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .page-hero-stars span {
    position: absolute;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #ffe083;
    box-shadow: 0 0 10px 3px rgba(255, 224, 131, 0.24);
    animation: hero-page-twinkle 4.6s ease-in-out infinite;
  }

  .page-hero-stars span:nth-child(1) { left: 8%; top: 21%; }
  .page-hero-stars span:nth-child(2) { left: 27%; top: 12%; animation-delay: -1.2s; }
  .page-hero-stars span:nth-child(3) { left: 53%; top: 18%; animation-delay: -2.4s; }
  .page-hero-stars span:nth-child(4) { left: 73%; top: 9%; animation-delay: -0.8s; }
  .page-hero-stars span:nth-child(5) { left: 91%; top: 31%; animation-delay: -3.1s; }
  .page-hero-stars span:nth-child(6) { left: 37%; top: 43%; animation-delay: -1.8s; }

  .page-hero-grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(260px, 0.65fr);
    align-items: center;
    gap: clamp(20px, 4vw, 42px);
  }

  .page-hero-copy {
    max-width: 720px;
  }

  .page-hero-kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
    color: #ffd86f;
    font-size: 10.5px;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .page-hero-kicker::before {
    content: "✦";
    font-size: 13px;
  }

  .page-hero h1 {
    margin: 0;
    color: #fffaf0;
    font-size: clamp(30px, 4.2vw, 46px);
    line-height: 1.15;
    letter-spacing: -0.025em;
    text-shadow: 0 2px 0 rgba(20, 10, 55, 0.28);
  }

  .page-hero h1 :global(em) {
    font-style: normal;
    color: #ffdc80;
    background: linear-gradient(180deg, transparent 68%, rgba(255, 216, 111, 0.25) 68%);
  }

  .page-hero-lead {
    max-width: 640px;
    margin-top: 10px;
    color: #cfc3ed;
    font-size: clamp(14px, 1.35vw, 15.5px);
    line-height: 1.65;
  }

  .page-hero-copy :global(.slug) {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 14px;
  }

  .art-orbit {
    position: relative;
    width: min(100%, 330px);
    margin-inline: auto;
    aspect-ratio: 1;
  }

  .orbit {
    position: absolute;
    border: 1px solid rgba(199, 182, 255, 0.18);
    border-radius: 50%;
  }

  .orbit-a {
    inset: 5%;
  }

  .orbit-b {
    inset: 19%;
    border-style: dashed;
    border-color: rgba(255, 216, 111, 0.2);
    animation: orbit-spin 36s linear infinite;
  }

  .orbit-c {
    inset: 32%;
    border-color: rgba(190, 235, 255, 0.24);
  }

  .constellation-guitar {
    position: absolute;
    inset: 12% 14% 4%;
    width: 72%;
    height: 84%;
    filter: drop-shadow(0 0 18px rgba(255, 216, 111, 0.18));
  }

  .art-star {
    position: absolute;
    color: #ffd86f;
    filter: drop-shadow(0 0 8px rgba(255, 216, 111, 0.6));
  }

  .art-star-a {
    left: 1%;
    top: 19%;
    animation: page-star-float 5s ease-in-out infinite;
  }

  .art-star-b {
    right: 0;
    top: 35%;
    color: #bceaff;
    animation: page-star-float 6s ease-in-out infinite reverse;
  }

  .art-mascot {
    position: absolute;
    z-index: 3;
  }

  .art-capy {
    right: -3%;
    bottom: 0;
    width: 56%;
    filter: drop-shadow(0 14px 20px rgba(0, 0, 0, 0.24));
    animation: art-bob 6s ease-in-out infinite;
  }

  .art-bat {
    left: 2%;
    top: 20%;
    width: 33%;
    transform: rotate(-7deg);
    filter: drop-shadow(0 10px 15px rgba(0, 0, 0, 0.24));
    animation: art-bat-float 7s ease-in-out infinite;
  }

  @keyframes hero-page-twinkle {
    0%, 100% { opacity: 0.35; transform: scale(0.8); }
    50% { opacity: 1; transform: scale(1.15); }
  }

  @keyframes orbit-spin {
    to { transform: rotate(360deg); }
  }

  @keyframes page-star-float {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-9px) rotate(14deg); }
  }

  @keyframes art-bob {
    0%, 100% { transform: translateY(0) rotate(-1deg); }
    50% { transform: translateY(-6px) rotate(1deg); }
  }

  @keyframes art-bat-float {
    0%, 100% { transform: translate(0, 0) rotate(-7deg); }
    50% { transform: translate(7px, -8px) rotate(-2deg); }
  }

  @media (max-width: 820px) {
    .page-hero-grid {
      grid-template-columns: 1fr;
    }

    .page-hero-art {
      display: none;
    }

    .page-hero-lead {
      max-width: 620px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-hero-stars span,
    .orbit-b,
    .art-star,
    .art-capy,
    .art-bat {
      animation: none;
    }
  }
</style>
