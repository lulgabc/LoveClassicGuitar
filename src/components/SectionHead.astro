---
interface Props {
  kicker?: string;
  title: string;
  lead?: string;
  center?: boolean;
}
const { kicker, title, lead, center = false } = Astro.props;
---

<div class:list={["section-head", { center }]}>
  {kicker && <span class="kicker">{kicker}</span>}
  <h2 set:html={title} />
  {lead && <p class="lead">{lead}</p>}
</div>
