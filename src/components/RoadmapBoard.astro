---
import { STAGES, type Stage } from "../data/roadmap";
import { getTutorial } from "../data/videos";
import { url } from "../lib/url";
import Icon from "./Icon.astro";
import Bat from "./Bat.astro";

interface Props {
  stages?: Stage[];
  lang?: "zh" | "fr";
  printPath?: string;
  concertPath?: string;
  watchTitles?: Record<string, string>;
}

const {
  stages: stageSource = STAGES,
  lang = "zh",
  printPath = "/print/weekly/",
  concertPath = "/concert/",
  watchTitles = {},
} = Astro.props;
const isFr = lang === "fr";
const stages = stageSource.map((stage) => ({
  ...stage,
  watchItems: stage.watch
    .map((id) => getTutorial(id))
    .filter((item): item is NonNullable<typeof item> => Boolean(item))
    .map((item) => ({ ...item, displayTitle: isFr ? watchTitles[item.id] ?? item.title : item.zhTitle })),
}));
const totalQuests = stages.reduce((sum, stage) => sum + stage.quests.length, 0);
const t = isFr
  ? {
      mascotNote: "On y va",
      eyebrow: "Ma carte des étoiles",
      greeting: "Bonjour, jeune guitariste",
      lead: "Chaque petite mission allume une étoile. Pas besoin de courir.",
      nameLabel: "Ton prénom (seulement sur cet appareil)",
      namePlaceholder: "par exemple : Lila",
      print: "Imprimer la fiche de la semaine",
      restart: "Recommencer",
      ringLabel: "progression",
      missions: "missions",
      stages: "étapes",
      practices: "séances",
      startFrom: "Tu peux commencer ici",
      startValue: "Préparation · Faire connaissance avec la guitare",
      seeStages: "Voir les six étapes",
      suggested: "conseillé",
      taskCount: "missions",
      completePill: "Allumée",
      stageWatch: "À regarder",
      stagePieces: "Pièces et jeux",
      parentWord: "Un mot pour les adultes",
      checkpoint: "Quand cette étape est terminée, je peux…",
      allLit: "Toutes les étoiles sont allumées",
      completeTitle: "Ta carte du ciel est toute illuminée.",
      completeText: "Ce n'est pas une fin, juste le début de la prochaine aventure musicale. Va jouer pour quelqu'un que tu aimes.",
      concert: "Fêter ça à la salle de concert",
    }
  : {
      mascotNote: "一起走",
      eyebrow: "My star map",
      greeting: "你好，小音乐家",
      lead: "每完成一个小任务，就点亮一颗星。不用赶路，慢慢来。",
      nameLabel: "写下你的名字（只保存在这台设备）",
      namePlaceholder: "例如：小星星",
      print: "打印本周练习卡",
      restart: "重新开始",
      ringLabel: "星星进度",
      missions: "个小任务",
      stages: "站",
      practices: "次练习",
      startFrom: "现在可以从这里出发",
      startValue: "准备站 · 先和吉他做朋友",
      seeStages: "看全部六站",
      suggested: "建议",
      taskCount: "个任务",
      completePill: "已点亮",
      stageWatch: "推荐观看",
      stagePieces: "本站曲目与游戏",
      parentWord: "给大人的一句话",
      checkpoint: "这一站通关时，我能……",
      allLit: "All stars lit",
      completeTitle: "你的星空地图，全部点亮了。",
      completeText: "这不是终点，只是下一段音乐旅程的起点。去弹给一个你喜欢的人听吧。",
      concert: "去音乐厅庆祝",
    };
---

<div class="roadmap-board" data-roadmap data-lang={lang}>
  <div class="progress-panel" data-progress-panel>
    <div class="progress-mascot" aria-hidden="true">
      <span class="mascot-orbit"></span>
      <Bat />
      <span class="mascot-note">{t.mascotNote}</span>
    </div>

    <div class="progress-main">
      <span class="progress-eyebrow">{t.eyebrow}</span>
      <h2 data-greeting>{t.greeting}</h2>
      <p class="progress-lead" data-progress-lead>{t.lead}</p>
      <div class="name-row">
        <label for="star-name">{t.nameLabel}</label>
        <input id="star-name" type="text" maxlength="24" placeholder={t.namePlaceholder} data-name-input autocomplete="off" />
      </div>
      <div class="progress-actions">
        <a class="btn btn-primary btn-sm" href={url(printPath)}><Icon name="printer" size={14} /> {t.print}</a>
        <button class="btn btn-ghost btn-sm" type="button" data-reset-progress><Icon name="refresh" size={13} /> {t.restart}</button>
      </div>
    </div>

    <div class="progress-ring-wrap">
      <div class="progress-ring" data-progress-ring style="--progress: 0">
        <div class="ring-inner">
          <strong><span data-progress-percent>0</span><small>%</small></strong>
          <span>{t.ringLabel}</span>
        </div>
      </div>
      <div class="ring-caption">
        <span><Icon name="star" size={13} /> <strong data-quest-count>0</strong> / {totalQuests} {t.missions}</span>
        <span><Icon name="check" size={13} /> <strong data-stage-count>0</strong> / {stages.length} {t.stages}</span>
        <span><Icon name="music" size={13} /> <strong data-practice-count>0</strong> {t.practices}</span>
      </div>
    </div>
  </div>

  <div class="current-stage" data-current-stage-card>
    <div class="current-stage-icon"><Icon name="compass" size={19} /></div>
    <div>
      <span>{t.startFrom}</span>
      <strong data-current-stage>{t.startValue}</strong>
    </div>
    <a href="#stage-list">{t.seeStages} <Icon name="arrow-right" size={13} /></a>
  </div>

  <div class="stage-list" id="stage-list">
    {
      stages.map((stage) => (
        <details class:list={["stage-card", `stage-${stage.color}`]} id={stage.id} data-stage data-stage-id={stage.id} open={stage.n === 0}>
          <summary>
            <span class="stage-number">{stage.n === 0 ? "✦" : String(stage.n).padStart(2, "0")}</span>
            <span class="stage-title-wrap">
              <span class="stage-mini">{stage.level} · {t.suggested} {stage.weeks}</span>
              <strong>{stage.title}</strong>
              <small>{stage.subtitle}</small>
            </span>
            <span class="stage-summary-meta">
              <span class="stage-badge"><Icon name="star" size={12} /> {stage.badge}</span>
              <span class="stage-count" data-stage-progress>0 / {stage.quests.length} {t.taskCount}</span>
            </span>
            <span class="stage-complete-pill" data-stage-complete hidden><Icon name="check" size={11} /> {t.completePill}</span>
            <span class="stage-chevron"><Icon name="chevron-down" size={18} /></span>
          </summary>

          <div class="stage-body">
            <div class="stage-intro">
              <p class="stage-description">{stage.description}</p>
              <div class="stage-bigidea"><Icon name="lightbulb" size={15} /> {stage.bigIdea}</div>
            </div>

            <div class="quest-list">
              {
                stage.quests.map((quest, questIndex) => (
                  <label class="quest-item" data-quest-item>
                    <input type="checkbox" data-quest={quest.id} aria-label={isFr ? `Terminer : ${quest.title}` : `完成任务：${quest.title}`} />
                    <span class="quest-check" aria-hidden="true"><Icon name="check" size={13} /></span>
                    <span class="quest-body">
                      <span class="quest-head"><strong>{quest.title}</strong><span class="quest-minutes"><Icon name="clock" size={11} /> {quest.minutes} {isFr ? "min" : "分钟"}</span></span>
                      <span class="quest-task">{quest.task}</span>
                      {quest.tip && <span class="quest-tip"><Icon name="sparkle" size={11} /> {quest.tip}</span>}
                      <span class="quest-index">{String(questIndex + 1).padStart(2, "0")}</span>
                    </span>
                  </label>
                ))
              }
            </div>

            <div class="stage-details-grid">
              <div class="stage-box">
                <span class="stage-box-label"><Icon name="music" size={14} /> {t.stagePieces}</span>
                <ul>
                  {stage.pieces.map((piece) => <li><strong>{piece.title}</strong><span>{piece.note}</span></li>)}
                </ul>
              </div>
              <div class="stage-box">
                <span class="stage-box-label"><Icon name="play" size={14} /> {t.stageWatch}</span>
                <ul class="watch-list">
                  {
                    stage.watchItems.map((tutorial) => (
                      <li>
                        <a href={`https://www.youtube.com/watch?v=${tutorial.youtubeId}`} target="_blank" rel="noopener noreferrer">
                          <span>{tutorial.displayTitle}</span>
                          <small>{tutorial.channel} · {tutorial.duration}</small>
                        </a>
                      </li>
                    ))
                  }
                </ul>
              </div>
            </div>

            <div class="stage-parent-tip">
              <span><Icon name="heart" size={14} /> {t.parentWord}</span>
              <p>{stage.parentTip}</p>
            </div>

            <div class="stage-checkpoint">
              <span class="checkpoint-icon"><Icon name="trophy" size={19} /></span>
              <div><span class="stage-box-label">{t.checkpoint}</span><p>{stage.checkpoint}</p></div>
            </div>
          </div>
        </details>
      ))
    }
  </div>

  <div class="roadmap-complete" data-roadmap-complete hidden>
    <div class="complete-burst" aria-hidden="true">✦</div>
    <div>
      <span class="mini-kicker">{t.allLit}</span>
      <h2>{t.completeTitle}</h2>
      <p>{t.completeText}</p>
    </div>
    <a class="btn btn-sun" href={url(concertPath)}><Icon name="headphones" size={15} /> {t.concert}</a>
  </div>
</div>

<script>
  import { readProgress, resetProgress, saveName, setQuestDone, completedQuestCount } from "../lib/progress";
  import { celebrate } from "../lib/celebrate";
  import { playChime } from "../lib/audio";

  const root = document.querySelector<HTMLElement>("[data-roadmap]")!;
  if (root) {
    const isFr = root.dataset.lang === "fr";
    const txt = isFr
      ? {
          greeting: (name: string) => (name ? `Bonjour, ${name}` : "Bonjour, jeune guitariste"),
          taskLabel: (done: number, total: number) => `${done} / ${total} missions`,
          leadStart: "Chaque petite mission allume une étoile. Pas besoin de courir.",
          leadDone: "Toutes les étoiles sont allumées. Tu peux maintenant jouer pour le monde.",
          leadSome: (done: number) => `Tu as déjà allumé ${done} étoiles. La prochaine demande juste un petit geste.`,
          allDone: "Tout est allumé · va fêter ça à la salle de concert",
          confirm: "Effacer toutes les étoiles et le prénom ? Cette action est définitive.",
        }
      : {
          greeting: (name: string) => (name ? `你好，${name}` : "你好，小音乐家"),
          taskLabel: (done: number, total: number) => `${done} / ${total} 个任务`,
          leadStart: "每完成一个小任务，就点亮一颗星。不用赶路，慢慢来。",
          leadDone: "全部星星都亮了。现在的你，已经可以弹给世界听了。",
          leadSome: (done: number) => `你已经点亮了 ${done} 颗星。下一颗，不用很用力，只要轻轻拨响。`,
          allDone: "全部点亮 · 去音乐厅庆祝吧",
          confirm: "要把所有星星和名字都清空吗？这个操作不能撤销。",
        };
    const stageEls = Array.from(root.querySelectorAll<HTMLDetailsElement>("[data-stage]"));
    const checkboxes = Array.from(root.querySelectorAll<HTMLInputElement>("[data-quest]"));
    const ring = root.querySelector<HTMLElement>("[data-progress-ring]");
    const percentEl = root.querySelector<HTMLElement>("[data-progress-percent]");
    const questCountEl = root.querySelector<HTMLElement>("[data-quest-count]");
    const stageCountEl = root.querySelector<HTMLElement>("[data-stage-count]");
    const practiceCountEl = root.querySelector<HTMLElement>("[data-practice-count]");
    const greeting = root.querySelector<HTMLElement>("[data-greeting]");
    const lead = root.querySelector<HTMLElement>("[data-progress-lead]");
    const currentStageEl = root.querySelector<HTMLElement>("[data-current-stage]");
    const nameInput = root.querySelector<HTMLInputElement>("[data-name-input]");
    const resetBtn = root.querySelector<HTMLButtonElement>("[data-reset-progress]");
    const completePanel = root.querySelector<HTMLElement>("[data-roadmap-complete]");
    const total = checkboxes.length;
    let previousCompleted = -1;
    let previousStages = -1;

    function stageDone(stage: HTMLElement): { done: number; total: number } {
      const inputs = Array.from(stage.querySelectorAll<HTMLInputElement>("[data-quest]"));
      return { done: inputs.filter((input) => input.checked).length, total: inputs.length };
    }

    function updateUI(celebrateChange = false): void {
      const progress = readProgress();
      const done = Math.min(completedQuestCount(), total);
      const percent = total ? Math.round((done / total) * 100) : 0;
      let stagesDone = 0;

      stageEls.forEach((stage) => {
        const { done: stageDoneCount, total: stageTotal } = stageDone(stage);
        stage.querySelector<HTMLElement>("[data-stage-progress]")!.textContent = txt.taskLabel(stageDoneCount, stageTotal);
        if (stageDoneCount === stageTotal) {
          stagesDone += 1;
          stage.classList.add("is-complete");
          stage.querySelector<HTMLElement>("[data-stage-complete]")?.removeAttribute("hidden");
        } else {
          stage.classList.remove("is-complete");
          stage.querySelector<HTMLElement>("[data-stage-complete]")?.setAttribute("hidden", "");
        }
      });

      if (ring) {
        ring.style.setProperty("--progress", String(percent));
        ring.classList.toggle("is-complete", percent === 100);
      }
      if (percentEl) percentEl.textContent = String(percent);
      if (questCountEl) questCountEl.textContent = String(done);
      if (stageCountEl) stageCountEl.textContent = String(stagesDone);
      if (practiceCountEl) practiceCountEl.textContent = String(progress.sessions.length);

      const name = progress.name.trim();
      if (greeting) greeting.textContent = txt.greeting(name);
      if (lead) {
        lead.textContent =
          done === 0
            ? txt.leadStart
            : done === total
              ? txt.leadDone
              : txt.leadSome(done);
      }

      const firstIncomplete = stageEls.find((stage) => {
        const { done: stageDoneCount, total: stageTotal } = stageDone(stage);
        return stageDoneCount < stageTotal;
      });
      if (currentStageEl && firstIncomplete) {
        const title = firstIncomplete.querySelector(".stage-title-wrap strong")?.textContent ?? "";
        const subtitle = firstIncomplete.querySelector(".stage-title-wrap small")?.textContent ?? "";
        currentStageEl.textContent = `${title} · ${subtitle}`;
      } else if (currentStageEl) {
        currentStageEl.textContent = txt.allDone;
      }

      if (nameInput && nameInput.value !== name) nameInput.value = name;
      if (completePanel) completePanel.hidden = done !== total;

      if (celebrateChange && done > previousCompleted && previousCompleted >= 0) {
        if (stagesDone > previousStages) {
          playChime();
          celebrate(30);
        } else {
          playChime();
        }
      }
      if (celebrateChange && done === total && previousCompleted < total) {
        celebrate(70);
      }
      previousCompleted = done;
      previousStages = stagesDone;
    }

    const progress = readProgress();
    checkboxes.forEach((checkbox) => {
      const id = checkbox.dataset.quest;
      if (id) checkbox.checked = progress.quests.includes(id);
    });
    if (nameInput) nameInput.value = progress.name;

    // Name is only stored locally, never sent anywhere.
    nameInput?.addEventListener("input", () => {
      saveName(nameInput.value);
      const name = nameInput.value.trim();
      if (greeting) greeting.textContent = txt.greeting(name);
    });

    checkboxes.forEach((checkbox) => {
      checkbox.addEventListener("change", () => {
        const id = checkbox.dataset.quest;
        if (id) setQuestDone(id, checkbox.checked);
        updateUI(true);
      });
    });

    resetBtn?.addEventListener("click", () => {
      const confirmed = window.confirm(txt.confirm);
      if (!confirmed) return;
      resetProgress();
      checkboxes.forEach((checkbox) => (checkbox.checked = false));
      if (nameInput) nameInput.value = "";
      updateUI(false);
    });

    updateUI(false);

    // Open the first unfinished stage so the next step is easy to find.
    const firstIncomplete = stageEls.find((stage) => {
      const inputs = Array.from(stage.querySelectorAll<HTMLInputElement>("[data-quest]"));
      return inputs.some((input) => !input.checked);
    });
    if (firstIncomplete) {
      stageEls.forEach((stage) => (stage.open = stage === firstIncomplete));
    }
  }
</script>

<style>
  .roadmap-board {
    position: relative;
  }

  .progress-panel {
    position: relative;
    display: grid;
    grid-template-columns: 160px minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(20px, 3.5vw, 40px);
    overflow: hidden;
    padding: clamp(26px, 4vw, 42px);
    color: #f7f1ff;
    border-radius: var(--radius-xl);
    background:
      radial-gradient(circle at 88% 12%, rgba(255, 216, 111, 0.17), transparent 25%),
      radial-gradient(circle at 9% 95%, rgba(93, 202, 250, 0.14), transparent 28%),
      linear-gradient(135deg, #2b1a67, #160f3d 72%);
    box-shadow: var(--shadow-lg);
  }

  .progress-panel::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      radial-gradient(1px 1px at 17% 21%, #fff0b9, transparent),
      radial-gradient(1.4px 1.4px at 54% 12%, #d5f1ff, transparent),
      radial-gradient(1px 1px at 75% 55%, #fff0b9, transparent),
      radial-gradient(1px 1px at 92% 26%, #d5f1ff, transparent);
    opacity: 0.6;
  }

  .progress-mascot {
    position: relative;
    z-index: 1;
    width: 150px;
    height: 150px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .progress-mascot :global(.mascot-bat) {
    position: relative;
    z-index: 1;
    width: 145px;
    animation: roadmap-bat 6s ease-in-out infinite;
    filter: drop-shadow(0 16px 22px rgba(5, 2, 20, 0.25));
  }

  .mascot-orbit {
    position: absolute;
    inset: 2%;
    border: 1px dashed rgba(255, 255, 255, 0.19);
    border-radius: 50%;
    animation: orbit-spin 32s linear infinite;
  }

  .mascot-orbit::before {
    content: "";
    position: absolute;
    inset: 15%;
    border: 1px solid rgba(255, 216, 111, 0.22);
    border-radius: 50%;
  }

  .mascot-note {
    position: absolute;
    z-index: 2;
    right: -2px;
    bottom: 5px;
    padding: 4px 8px;
    color: #3f2c0c;
    border-radius: 999px;
    background: #ffe28d;
    font-size: 8px;
    font-weight: 850;
    transform: rotate(5deg);
    box-shadow: 0 3px 0 rgba(0, 0, 0, 0.13);
  }

  .progress-main {
    position: relative;
    z-index: 1;
    max-width: 620px;
  }

  .progress-eyebrow {
    display: block;
    color: #ffd86f;
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .progress-main h2 {
    margin: 5px 0 6px;
    color: #fff9eb;
    font-size: clamp(27px, 3.8vw, 40px);
    line-height: 1.2;
  }

  .progress-lead {
    max-width: 560px;
    margin: 0;
    color: #cabdec;
    font-size: 14px;
    line-height: 1.75;
  }

  .name-row {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-top: 15px;
  }

  .name-row label {
    color: #a99acb;
    font-size: 10px;
    line-height: 1.5;
  }

  .name-row input {
    width: min(190px, 45%);
    min-height: 34px;
    padding: 6px 10px;
    color: #fff9eb;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 9px;
    background: rgba(255, 255, 255, 0.08);
    font-size: 12px;
    outline: none;
  }

  .name-row input::placeholder {
    color: rgba(255, 255, 255, 0.35);
  }

  .name-row input:focus {
    border-color: #ffd86f;
  }

  .progress-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 14px;
  }

  .progress-actions .btn-ghost {
    color: #b9a8de;
  }

  .progress-actions .btn-ghost:hover {
    color: #ffe28d;
    background: rgba(255, 255, 255, 0.08);
  }

  .progress-ring-wrap {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 13px;
  }

  .progress-ring {
    position: relative;
    display: grid;
    place-items: center;
    width: 164px;
    height: 164px;
    border-radius: 50%;
    background: conic-gradient(#ffd86f calc(var(--progress) * 1%), rgba(255, 255, 255, 0.1) 0);
    box-shadow: 0 0 0 8px rgba(255, 255, 255, 0.04);
    transition: background 700ms var(--ease);
  }

  .progress-ring::before {
    content: "";
    position: absolute;
    inset: 8px;
    border-radius: 50%;
    background: linear-gradient(145deg, #2b1a67, #190f43);
    border: 1px solid rgba(255, 255, 255, 0.11);
  }

  .progress-ring.is-complete {
    animation: ring-glow 2.4s ease-in-out infinite;
  }

  .ring-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .ring-inner strong {
    color: #fff9eb;
    font-family: var(--font-display);
    font-size: 38px;
    font-weight: 900;
    line-height: 1;
  }

  .ring-inner strong small {
    color: #ffd86f;
    font-size: 13px;
  }

  .ring-inner span {
    margin-top: 4px;
    color: #a99acb;
    font-size: 8px;
    font-weight: 750;
    letter-spacing: 0.08em;
  }

  .ring-caption {
    display: grid;
    gap: 3px;
    width: 186px;
    color: #a99acb;
    font-size: 10.5px;
  }

  .ring-caption span {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .ring-caption .icon {
    color: #ffd86f;
  }

  .ring-caption strong {
    color: #fff3d1;
  }

  .current-stage {
    display: flex;
    align-items: center;
    gap: 11px;
    margin-top: 15px;
    padding: 12px 15px;
    border: 1.5px dashed var(--line-strong);
    border-radius: 14px;
    background: var(--surface-2);
  }

  .current-stage-icon {
    display: grid;
    place-items: center;
    flex: 0 0 36px;
    width: 36px;
    height: 36px;
    color: var(--violet-700);
    border-radius: 12px;
    background: var(--violet-wash);
  }

  .current-stage div {
    flex: 1;
    min-width: 0;
  }

  .current-stage span {
    display: block;
    color: var(--faint);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.06em;
