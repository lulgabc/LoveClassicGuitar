---
import type { Performance } from "../data/concert";
import Icon from "./Icon.astro";

interface Props {
  performance: Performance;
}

const { performance } = Astro.props;
const link = `https://www.youtube.com/watch?v=${performance.youtubeId}`;
---

<div class="yt-panel" data-yt-panel data-youtube-id={performance.youtubeId}>
  <button class="yt-poster" type="button" data-yt-play>
    <span class="poster-stars" aria-hidden="true"></span>
    <span class="poster-disc" aria-hidden="true"></span>
    <span class="poster-kicker">今晚的音乐厅 · Featured</span>
    <span class="poster-title">{performance.title}</span>
    <span class="poster-meta">{performance.performer} · {performance.duration}</span>
    <span class="poster-play" aria-hidden="true"><Icon name="play" size={26} /></span>
    <span class="poster-note">点击后才会加载 YouTube 视频</span>
  </button>
  <noscript>
    <a class="button-fallback" href={link} target="_blank" rel="noopener noreferrer">在 YouTube 观看 <Icon name="external" size={13} /></a>
  </noscript>
</div>
<script>
  document.querySelectorAll<HTMLElement>("[data-yt-panel]").forEach((panel) => {
    const button = panel.querySelector<HTMLButtonElement>("[data-yt-play]");
    const id = panel.dataset.youtubeId;
    if (!button || !id) return;

    button.addEventListener("click", () => {
      const iframe = document.createElement("iframe");
      iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(id)}?autoplay=1&rel=0&modestbranding=1&playsinline=1`;
      iframe.title = button.getAttribute("aria-label")?.replace("加载并播放 ", "") ?? "YouTube 古典吉他演奏";
      iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
      iframe.referrerPolicy = "strict-origin-when-cross-origin";
      iframe.allowFullscreen = true;
      iframe.className = "yt-iframe";
      button.replaceWith(iframe);
      iframe.focus();
    });
  });
</script>

<style>
  .yt-panel {
    position: relative;
    width: 100%;
    min-width: 0;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1.5px solid rgba(255, 255, 255, 0.14);
    border-radius: 24px;
    background: #120a32;
    box-shadow: 0 24px 60px rgba(14, 7, 43, 0.28);
  }

  .yt-poster {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    text-align: left;
    color: #fff;
    border: 0;
    background:
      radial-gradient(circle at 80% 24%, rgba(255, 216, 111, 0.18), transparent 24%),
      radial-gradient(circle at 25% 80%, rgba(93, 202, 250, 0.18), transparent 30%),
      linear-gradient(135deg, #3c258e, #1a1044 68%, #120a32);
    isolation: isolate;
  }

  .poster-stars {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(1px 1px at 12% 20%, #fff1b9, transparent),
      radial-gradient(1.5px 1.5px at 62% 12%, #d9f4ff, transparent),
      radial-gradient(1px 1px at 87% 68%, #fff1b9, transparent),
      radial-gradient(1px 1px at 32% 74%, #d9f4ff, transparent);
    background-size: 280px 240px;
    opacity: 0.7;
  }

  .poster-disc {
    position: absolute;
    z-index: -1;
    right: -7%;
    top: -22%;
    width: 55%;
    aspect-ratio: 1;
    border-radius: 50%;
    background:
      repeating-radial-gradient(circle at center, transparent 0 9px, rgba(255, 255, 255, 0.055) 10px 11px),
      radial-gradient(circle at 34% 30%, #5e43a3, #1b1039 72%);
    border: 1px solid rgba(255, 255, 255, 0.13);
    box-shadow: 0 24px 50px rgba(0, 0, 0, 0.3);
    animation: yt-disc-spin 34s linear infinite;
  }

  .poster-kicker {
    position: absolute;
    left: clamp(22px, 5vw, 52px);
    top: clamp(20px, 4.5vw, 46px);
    color: #ffd86f;
    font-size: clamp(8px, 1vw, 11px);
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .poster-title {
    position: absolute;
    left: clamp(22px, 5vw, 52px);
    bottom: clamp(60px, 11vw, 112px);
    max-width: 68%;
    color: #fff9eb;
    font-family: var(--font-display);
    font-size: clamp(25px, 4.6vw, 52px);
    font-weight: 900;
    line-height: 1.15;
    letter-spacing: -0.02em;
    text-shadow: 0 2px 3px rgba(9, 4, 29, 0.35);
    text-wrap: balance;
  }

  .poster-meta {
    position: absolute;
    left: clamp(22px, 5vw, 52px);
    bottom: clamp(30px, 6vw, 64px);
    max-width: 62%;
    color: rgba(255, 255, 255, 0.68);
    font-size: clamp(9px, 1.2vw, 13px);
    line-height: 1.5;
  }

  .poster-play {
    position: absolute;
    right: clamp(22px, 4.5vw, 48px);
    bottom: clamp(22px, 4.5vw, 48px);
    display: grid;
    place-items: center;
    width: clamp(52px, 7vw, 76px);
    height: clamp(52px, 7vw, 76px);
    padding-left: 4px;
    color: #2b1857;
    background: #ffe28d;
    border-radius: 50%;
    box-shadow: 0 7px 0 rgba(36, 17, 83, 0.5), 0 0 0 8px rgba(255, 226, 141, 0.1);
    transition: transform 180ms var(--ease), background 180ms ease;
  }

  .yt-poster:hover .poster-play {
    transform: scale(1.08) rotate(-3deg);
    background: #fff0b1;
  }

  .poster-note {
    position: absolute;
    right: clamp(22px, 4.5vw, 48px);
    top: clamp(20px, 4vw, 42px);
    color: rgba(255, 255, 255, 0.42);
    font-size: 8px;
    letter-spacing: 0.03em;
    text-align: right;
  }

  .yt-iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .button-fallback {
    position: absolute;
    inset: auto 20px 20px auto;
    padding: 10px 15px;
    color: #2b1857;
    background: #ffe28d;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 850;
    text-decoration: none;
  }

  @keyframes yt-disc-spin {
    to { transform: rotate(360deg); }
  }

  @media (max-width: 620px) {
    .yt-panel {
      aspect-ratio: 4 / 3;
      border-radius: 18px;
    }

    .poster-disc {
      width: 68%;
      right: -18%;
      top: -8%;
    }

    .poster-title {
      max-width: 82%;
      bottom: 72px;
    }

    .poster-meta {
      bottom: 28px;
      max-width: 72%;
    }

    .poster-play {
      right: 18px;
      bottom: 18px;
    }

    .poster-note {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .poster-disc {
      animation: none;
    }
  }
</style>
