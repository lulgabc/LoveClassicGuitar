---
import { GUITAR_STRINGS, STRING_CHANT } from "../data/basics";
import Icon from "./Icon.astro";
---

<div class="string-board">
  <div class="string-board-head">
    <div>
      <span class="board-kicker">Six strings · 六弦歌</span>
      <h3>点一下，听听每根弦的声音</h3>
      <p>六根弦从粗到细：E–A–D–G–B–E。第 6 弦最低，第 1 弦最高。</p>
    </div>
    <span class="sound-note"><Icon name="volume" size={15} /> 点击播放参考音</span>
  </div>

  <div class="string-rows">
    {
      GUITAR_STRINGS.map((string) => (
        <button
          class="string-row"
          type="button"
          data-tone-frequency={string.frequency}
          style={`--string-color:${string.color};--string-size:${2.4 - (string.number - 1) * 0.25}px`}
        >
          <span class="sr-only">播放参考音：</span>
          <span class="string-number">{string.number}</span>
          <span class="string-line" aria-hidden="true"></span>
          <span class="string-name">{string.note} <small>{string.solfege}</small></span>
          <span class="string-nickname">{string.nickname}</span>
          <span class="string-detail">{string.detail}</span>
          <span class="string-play" aria-hidden="true"><Icon name="play" size={12} /></span>
        </button>
      ))
    }
  </div>

  <div class="string-chant">
    <span class="chant-label">六弦歌</span>
    <div>
      {STRING_CHANT.map((line) => <p>{line}</p>)}
    </div>
  </div>

  <p class="string-foot"><Icon name="info" size={13} /> 这些是标准音参考，不是自动调音器。调音请用调音器 App 或请大人帮忙，慢慢转弦轴。</p>
</div>

<style>
  .string-board {
    padding: clamp(22px, 3.4vw, 32px);
    border: 1.5px solid var(--line);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(circle at 100% 0%, rgba(255, 216, 111, 0.18), transparent 26%),
      var(--surface);
    box-shadow: var(--shadow);
  }

  .string-board-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 18px;
    padding-bottom: 18px;
    border-bottom: 1px dashed var(--line);
  }

  .board-kicker {
    display: block;
    margin-bottom: 2px;
    color: var(--violet-700);
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .string-board-head h3 {
    margin: 0;
    color: var(--ink);
    font-size: clamp(22px, 2.7vw, 30px);
  }

  .string-board-head p {
    max-width: 560px;
    margin: 5px 0 0;
    color: var(--ink-soft);
    font-size: 13.5px;
    line-height: 1.7;
  }

  .sound-note {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    flex: 0 0 auto;
    padding: 5px 8px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    background: var(--surface-2);
    font-size: 8.5px;
    font-weight: 750;
    white-space: nowrap;
  }

  .string-rows {
    display: grid;
    gap: 4px;
    padding: 14px 0 9px;
  }

  .string-row {
    display: grid;
    grid-template-columns: 27px minmax(70px, 1fr) 62px 78px minmax(120px, 1.3fr) 25px;
    align-items: center;
    gap: 10px;
    width: 100%;
    min-height: 45px;
    padding: 5px 8px;
    color: var(--ink);
    border: 1px solid transparent;
    border-radius: 11px;
    background: transparent;
    text-align: left;
    transition: background 150ms ease, border-color 150ms ease, transform 150ms ease;
  }

  .string-row:hover {
    border-color: var(--line);
    background: var(--surface-2);
    transform: translateX(3px);
  }

  .string-number {
    display: grid;
    place-items: center;
    width: 25px;
    height: 25px;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--muted);
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 800;
  }

  .string-line {
    display: block;
    width: 100%;
    height: var(--string-size);
    border-radius: 99px;
    background: var(--string-color);
    box-shadow: 0 1px 0 rgba(46, 25, 85, 0.12);
    transition: transform 160ms ease;
  }

  .string-row:hover .string-line {
    transform: scaleY(1.5);
  }

  .string-name {
    color: var(--violet-700);
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 900;
    line-height: 1;
  }

  .string-name small {
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 8px;
    font-weight: 700;
  }

  .string-nickname {
    color: var(--ink);
    font-size: 12px;
    font-weight: 750;
    white-space: nowrap;
  }

  .string-detail {
    color: var(--muted);
    font-size: 11px;
    line-height: 1.5;
  }

  .string-play {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    padding-left: 1px;
    color: var(--violet-700);
    border-radius: 50%;
    background: var(--violet-wash);
    opacity: 0;
    transition: opacity 150ms ease;
  }

  .string-row:hover .string-play,
  .string-row:focus-visible .string-play {
    opacity: 1;
  }

  .string-chant {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    margin-top: 11px;
    padding: 13px 16px;
    border-radius: 14px;
    background: var(--sun-wash);
  }

  .chant-label {
    flex: 0 0 auto;
    padding: 2px 8px;
    border-radius: 999px;
    color: #7a5108;
    background: var(--sun-200);
    font-size: 9px;
    font-weight: 850;
    letter-spacing: 0.04em;
  }

  .string-chant div {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2px 18px;
    flex: 1;
  }

  .string-chant p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 11px;
    line-height: 1.7;
    white-space: nowrap;
  }

  html[data-theme="night"] .chant-label {
    color: var(--sun-700);
  }

  .string-foot {
    display: flex;
    align-items: flex-start;
    gap: 5px;
    margin: 13px 0 0;
    color: var(--faint);
    font-size: 10px;
    line-height: 1.55;
  }

  .string-foot .icon {
    margin-top: 1px;
  }

  .string-row.tone-playing .string-line {
    animation: string-vibrate 400ms ease;
  }

  @keyframes string-vibrate {
    0%, 100% { transform: scaleY(1); }
    25% { transform: scaleY(2.8); }
    55% { transform: scaleY(0.7); }
    75% { transform: scaleY(1.8); }
  }

  @media (max-width: 850px) {
    .string-row {
      grid-template-columns: 25px 52px 58px 75px minmax(0, 1fr) 20px;
      gap: 7px;
    }

    .string-detail {
      font-size: 9px;
    }

    .string-chant div {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .string-board-head {
      flex-direction: column;
      gap: 7px;
    }

    .sound-note {
      display: none;
    }

    .string-row {
      grid-template-columns: 24px 42px 48px minmax(0, 1fr) 20px;
    }

    .string-detail {
      display: none;
    }

    .string-chant {
      flex-direction: column;
      gap: 7px;
    }

    .string-chant p {
      white-space: normal;
    }
  }

  @media (max-width: 420px) {
    .string-nickname {
      display: none;
    }

    .string-row {
      grid-template-columns: 23px 1fr 45px 20px;
    }

    .string-line {
      order: 2;
    }

    .string-name {
      order: 3;
    }

    .string-play {
      order: 4;
    }
  }
</style>
