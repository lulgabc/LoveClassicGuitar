---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE } from "../data/site";
import { langFromPath, otherLanguagePath, type Lang } from "../lib/i18n";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  bodyClass?: string;
  lang?: Lang;
}

const {
  title,
  description,
  noindex = false,
  bodyClass = "",
  lang: langProp,
} = Astro.props;

const lang = langProp ?? langFromPath(Astro.url.pathname);
const isFr = lang === "fr";
const image = Astro.props.image ?? `${SITE.url}/${isFr ? "og-fr.png" : "og.png"}`;
const siteName = isFr ? SITE.nameFr : SITE.nameZh;
const defaultDescription = isFr ? SITE.descriptionFr : SITE.description;
const pageTitle = title
  ? `${title} · ${siteName}`
  : isFr
    ? `${SITE.nameFr} · ${SITE.taglineFr}`
    : `${SITE.nameZh} · ${SITE.tagline}`;
const metaDescription = description ?? defaultDescription;
const canonical = new URL(Astro.url.pathname, "https://lulgabc.github.io").toString();
const alternatePath = otherLanguagePath(Astro.url.pathname);
const alternateUrl = `${SITE.url}${alternatePath === "/" ? "/" : alternatePath}`;
const ogType = title ? "article" : "website";
const skipLabel = isFr ? "Aller au contenu principal" : "跳到主要内容";
---

<!doctype html>
<html lang={isFr ? "fr" : "zh-CN"} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="author" content={SITE.author} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#1b1247" />
    <meta name="color-scheme" content="light dark" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="zh-CN" href={isFr ? alternateUrl : canonical} />
    <link rel="alternate" hreflang="fr-FR" href={isFr ? canonical : alternateUrl} />
    <link rel="alternate" hreflang="x-default" href={isFr ? alternateUrl : canonical} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={isFr ? "Momo la petite chauve-souris et Capi le capybara jouent de la guitare classique sous les étoiles" : "小蝙蝠 Momo 和水豚 Capi 在星空下弹古典吉他"}
    />
    <meta property="og:locale" content={isFr ? "fr_FR" : "zh_CN"} />
    <meta property="og:locale:alternate" content={isFr ? "zh_CN" : "fr_FR"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={image} />

    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />
    <link rel="manifest" href={`${import.meta.env.BASE_URL}site.webmanifest`} />
    <link rel="sitemap" href={`${import.meta.env.BASE_URL}sitemap-index.xml`} />

    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.remove("no-js");
        root.classList.add("js");
        try {
          var saved = localStorage.getItem("lcg-theme");
          var prefersDark = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
          root.dataset.theme = saved === "night" || saved === "day" ? saved : prefersDark ? "night" : "day";
        } catch (error) {
          root.dataset.theme = "day";
        }
      })();
    </script>
  </head>
  <body id="top" class={bodyClass} data-lang={lang}>
    <a class="skip-link" href="#main">{skipLabel}</a>
    <div class="scroll-progress" aria-hidden="true" data-scroll-progress></div>
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      import "../scripts/site";
    </script>
  </body>
</html>
