---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  bodyClass?: string;
}

const {
  title,
  description = SITE.description,
  image = `${SITE.url}/og.png`,
  noindex = false,
  bodyClass = "",
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE.nameZh}` : `${SITE.nameZh} · ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, "https://lulgabc.github.io").toString();
const ogType = title ? "article" : "website";
---

<!doctype html>
<html lang="zh-CN" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#1b1247" />
    <meta name="color-scheme" content="light dark" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.nameZh} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="小蝙蝠 Momo 和水豚 Capi 在星空下弹古典吉他" />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />
    <link rel="manifest" href={`${import.meta.env.BASE_URL}site.webmanifest`} />
    <link rel="sitemap" href={`${import.meta.env.BASE_URL}sitemap-index.xml`} />

    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.remove("no-js");
        root.classList.add("js");
        try {
          var saved = localStorage.getItem("lcg-theme");
          var prefersDark = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
          root.dataset.theme = saved === "night" || saved === "day" ? saved : prefersDark ? "night" : "day";
        } catch (error) {
          root.dataset.theme = "day";
        }
      })();
    </script>
  </head>
  <body id="top" class={bodyClass}>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <div class="scroll-progress" aria-hidden="true" data-scroll-progress></div>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import "../scripts/site";
    </script>
  </body>
</html>
