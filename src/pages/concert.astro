---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SectionHead from "../components/SectionHead.astro";
import Jukebox from "../components/Jukebox.astro";
import RepertoireLibrary from "../components/RepertoireLibrary.astro";
import MascotBubble from "../components/MascotBubble.astro";
import Icon from "../components/Icon.astro";
import { COMPOSERS, CONCERT_ETIQUETTE, LISTENING_GAMES, MASTERS, PERFORMANCES } from "../data/concert";
import { REPERTOIRE } from "../data/repertoire";
import { url } from "../lib/url";

const gameIcons: Record<string, "book" | "ear" | "sun" | "compass" | "wand" | "refresh"> = {
  story: "book",
  radar: "ear",
  temperature: "sun",
  steps: "compass",
  draw: "wand",
  repeat: "refresh",
};

const artistAccents: Record<string, string> = {
  violet: "var(--violet-500)",
  sky: "var(--sky-500)",
  pink: "var(--pink-500)",
  mint: "var(--mint-500)",
  sun: "var(--sun-500)",
  coral: "var(--coral-500)",
};
const shortGames = LISTENING_GAMES.slice(0, 4);
---

<BaseLayout
  title="音乐厅"
  description="给孩子的古典吉他音乐厅：18 首页面内可播放的精选演奏、200 首可按时期和难度筛选的曲库、听音任务和演奏家小档案。"
>
  <PageHero
    kicker="Listening room · 星空音乐厅"
    title="点一下，<br />让音乐<em>直接开始</em>。"
    lead="不用跳转，也不用先读一大段介绍。选一首，按下播放，让耳朵先去旅行。"
  >
  </PageHero>

  <section class="section" id="listen">
    <div class="container">
      <div class="listen-modes" role="group" aria-label="选择听音乐的方式">
        <button class="listen-mode is-active" type="button" data-listen-mode="now" aria-pressed="true">
          <Icon name="play" size={18} />
          <span><strong>现在听</strong><small>18 首 · 点开就响</small></span>
        </button>
        <button class="listen-mode" type="button" data-listen-mode="library" aria-pressed="false">
          <Icon name="book" size={18} />
          <span><strong>逛 200 首曲库</strong><small>按时期、难度、关键词</small></span>
        </button>
      </div>

      <div class="listen-panel" id="jukebox" data-listen-panel="now">
        <div class="section-head-row">
          <SectionHead
            kicker="Listening room · 今晚推荐"
            title="今晚的<em>曲目单</em>"
            lead={`每天从 ${PERFORMANCES.length} 首曲目里挑出 6 首“今晚推荐”。点“换一批”再抽一次，也可以打开全部曲目。`}
          />
          <a class="btn btn-ghost" href="#masters">认识演奏家 <Icon name="chevron-down" size={14} /></a>
        </div>
        <Jukebox items={PERFORMANCES} lang="zh" daily dailySize={6} />
        <div class="rep-jump-row">
          <button class="btn btn-ghost btn-sm" type="button" data-open-library><Icon name="book" size={14} /> 去 200 首曲库慢慢逛 <Icon name="arrow-right" size={13} /></button>
        </div>
      </div>

      <div class="listen-panel" id="repertoire" data-listen-panel="library" hidden>
        <div class="section-head-row">
          <SectionHead
            kicker="Répertoire · 200 首"
            title="一座可以慢慢逛的<em>曲库</em>。"
            lead="从文艺复兴到当代，按时期、难度或关键词找一首。带播放标记的 18 首可以直接回到“现在听”；其余一键去 YouTube 找演奏。"
          />
          <button class="btn btn-ghost" type="button" data-open-now>回到现在听 <Icon name="arrow-up" size={13} /></button>
        </div>
        <RepertoireLibrary pieces={REPERTOIRE} lang="zh" />
      </div>
    </div>
  </section>

  <section class="section section-wash">
    <div class="container">
      <div class="section-head-row">
        <SectionHead
          kicker="Petites missions d'écoute"
          title="听音乐，也可以像<em>玩游戏</em>"
          lead="不用分析曲式。挑一个听法，听两分钟，就已经在做很棒的耳朵训练。"
        />
        <button class="btn btn-sun btn-sm" type="button" data-pick-game><Icon name="wand" size={15} /> 抽一张听法卡</button>
      </div>
      <p class="picked-game" data-picked-game aria-live="polite">今天可以试试：先听整体，再只听低音。</p>
      <div class="listening-games">
        {
          shortGames.map((game, index) => (
            <article class="listening-game card" data-listening-game={game.title}>
              <span class="game-number">{String(index + 1).padStart(2, "0")}</span>
              <span class="game-icon"><Icon name={gameIcons[game.icon] ?? "ear"} size={21} /></span>
              <h3>{game.title}</h3>
              <p>{game.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="masters">
    <div class="container">
      <SectionHead
        kicker="Les guitaristes"
        title="他们的手指，<em>在讲什么故事？</em>"
        lead="点开一个人，读一小段故事；也可以直接去听他的演奏。"
      />
      <div class="artist-grid">
        {
          MASTERS.map((master) => (
            <article
              class:list={["artist-card", "card", { "has-photo": Boolean(master.photo) }]}
              style={master.photo ? `--artist-photo:url(${url(master.photo)}); --artist-accent:${artistAccents[master.color]}` : undefined}
            >
              <div class="artist-top">
                {!master.photo && <span class:list={["artist-avatar", `artist-${master.color}`]}>{master.initials}</span>}
                <span class="artist-country">{master.country}</span>
              </div>
              <h3>{master.zhName}</h3>
              <p class="artist-en">{master.name}</p>
              <p class="artist-keyword">“{master.keyword}”</p>
              <details>
                <summary>点开小故事 <Icon name="chevron-down" size={14} /></summary>
                <p>{master.bio}</p>
                <p class="artist-fun"><Icon name="sparkle" size={12} /> {master.funFact}</p>
              </details>
              <a class="artist-listen" href={`https://www.youtube.com/watch?v=${master.videoId}`} target="_blank" rel="noopener noreferrer">
                <Icon name="headphones" size={13} /> 去听：{master.piece}
              </a>
            </article>
          ))
        }
      </div>
      <div class="masters-note">
        <MascotBubble who="capi" text="你不需要成为他们。你可以成为第一个“你自己”。" tone="pink" />
        <a class="btn btn-ghost" href="#top">回到播放器 <Icon name="arrow-up" size={13} /></a>
      </div>
      <details class="artist-credits">
        <summary>照片来源与署名</summary>
        <ul>
          {MASTERS.map((master) => (
            <li>
              <strong>{master.zhName}</strong>：
              <a href={master.photoUrl} target="_blank" rel="noopener noreferrer">{master.photoCredit}</a>
              （{master.photoLicense}）
            </li>
          ))}
        </ul>
        <p>演奏家照片用于介绍与识别。部分来自 Wikimedia Commons，部分来自对应演奏视频封面；视频封面版权归原频道所有。</p>
      </details>
    </div>
  </section>

  <section class="section section-wash">
    <div class="container">
      <div class="fold-grid">
        <details class="fold-card card">
          <summary><span><Icon name="book" size={18} /> 作曲家小档案</span><span class="fold-hint">8 位 · 点开</span><Icon name="chevron-down" size={17} /></summary>
          <div class="composer-grid">
            {
              COMPOSERS.map((composer) => (
                <article class="composer-card">
                  <div class="composer-head"><h3>{composer.name}</h3><span>{composer.years} · {composer.country}</span></div>
                  <p>{composer.fact}</p>
                  <div class="composer-listen"><Icon name="headphones" size={13} /> {composer.listening}</div>
                </article>
              ))
            }
          </div>
        </details>

        <details class="fold-card card">
          <summary><span><Icon name="heart" size={18} /> 去听真正的音乐会</span><span class="fold-hint">6 个小礼仪</span><Icon name="chevron-down" size={17} /></summary>
          <div class="etiquette-list">
            {CONCERT_ETIQUETTE.map((tip, index) => <div class="etiquette-item"><span>{String(index + 1).padStart(2, "0")}</span><p>{tip}</p></div>)}
          </div>
        </details>
      </div>
      <div class="concert-parent-note">
        <Icon name="shield" size={17} />
        <p><strong>给家长：</strong>视频通过 YouTube 隐私增强播放器直接嵌入。YouTube 可能显示广告或推荐内容，建议先预览并与孩子一起听。音量以舒服为准。</p>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container concert-bottom">
      <div><span class="eyebrow"><Icon name="guitar" size={13} /> 听完之后</span><h2>现在，轮到你的手指<br />去讲一个故事了。</h2></div>
      <div class="btn-row">
        <a class="btn btn-primary" href={url("/practice/")}>去练习室 <Icon name="arrow-right" size={14} /></a>
        <a class="btn btn-ghost" href={url("/library/")}>找免费曲谱</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const listenSection = document.querySelector<HTMLElement>("#listen");
  const modeButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-listen-mode]"));
  const listenPanels = Array.from(document.querySelectorAll<HTMLElement>("[data-listen-panel]"));

  function setListenMode(mode: string, scroll = false): void {
    modeButtons.forEach((button) => {
      const active = button.dataset.listenMode === mode;
      button.classList.toggle("is-active", active);
      button.setAttribute("aria-pressed", String(active));
    });
    listenPanels.forEach((panel) => {
      panel.hidden = panel.dataset.listenPanel !== mode;
    });
    if (scroll) listenSection?.scrollIntoView({ behavior: "smooth", block: "start" });
  }

  modeButtons.forEach((button) => {
    button.addEventListener("click", () => setListenMode(button.dataset.listenMode ?? "now", true));
  });

  document.querySelectorAll<HTMLButtonElement>("[data-open-library]").forEach((button) => {
    button.addEventListener("click", () => setListenMode("library", true));
  });

  document.querySelectorAll<HTMLButtonElement>("[data-open-now]").forEach((button) => {
    button.addEventListener("click", () => setListenMode("now", true));
  });

  function applyListenHash(): void {
    if (location.hash === "#repertoire") {
      setListenMode("library");
      requestAnimationFrame(() => listenSection?.scrollIntoView({ block: "start" }));
    } else if (location.hash === "#jukebox" || location.hash === "#listen") {
      setListenMode("now");
      requestAnimationFrame(() => listenSection?.scrollIntoView({ block: "start" }));
    }
  }

  applyListenHash();
  window.addEventListener("hashchange", applyListenHash);
  document.addEventListener("concert:listen", () => setListenMode("now"));

  const games = Array.from(document.querySelectorAll<HTMLElement>("[data-listening-game]"));
  const pickButton = document.querySelector<HTMLButtonElement>("[data-pick-game]");
  const picked = document.querySelector<HTMLElement>("[data-picked-game]");
  let lastPicked = -1;

  pickButton?.addEventListener("click", () => {
    if (!games.length) return;
    let next = Math.floor(Math.random() * games.length);
    if (games.length > 1 && next === lastPicked) next = (next + 1) % games.length;
    lastPicked = next;
    games.forEach((game, index) => game.classList.toggle("is-picked", index === next));
    const game = games[next];
    const title = game?.getAttribute("data-listening-game") ?? "听一首";
    if (picked) {
      picked.textContent = `今天可以试试：${title}。听完说说你发现了什么。`;
      picked.animate(
        [
          { opacity: 0, transform: "translateY(5px)" },
          { opacity: 1, transform: "translateY(0)" },
        ],
        { duration: 280, easing: "ease-out" },
      );
    }
    game?.scrollIntoView({ behavior: "smooth", block: "center" });
  });
</script>

<style>
  .slug {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 20px;
  }

  .slug span {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 5px 9px;
    color: #d7caf4;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    font-size: 9.5px;
    font-weight: 700;
  }

  .slug .icon {
    color: #ffd86f;
  }

  #listen {
    scroll-margin-top: calc(var(--header-h) + 18px);
  }

  .listen-modes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin-bottom: 26px;
  }

  .listen-mode {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 64px;
    padding: 12px 16px;
    color: var(--muted);
    border: 2px solid var(--ink);
    border-radius: var(--radius);
    background: var(--surface);
    text-align: left;
    cursor: pointer;
    transition: border-color 160ms ease, background 160ms ease, color 160ms ease;
  }

  .listen-mode .icon {
    flex: 0 0 auto;
    color: var(--violet-700);
  }

  .listen-mode span {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .listen-mode strong {
    color: var(--ink);
    font-size: 16px;
    line-height: 1.3;
  }

  .listen-mode small {
    color: var(--faint);
    font-size: 11px;
    line-height: 1.4;
  }

  .listen-mode:hover {
    border-color: var(--ink);
    background: var(--sun-wash);
  }

  .listen-mode.is-active {
    color: var(--ink);
    border-color: var(--ink);
    background: var(--sun-200);
    box-shadow: 0 3px 0 var(--ink);
  }

  .listen-mode.is-active .icon {
    color: var(--violet-700);
  }

  .listening-games {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 11px;
  }

  .picked-game {
    margin: -20px 0 18px;
    color: var(--violet-700);
    font-size: 12px;
    font-weight: 700;
  }

  .listening-game {
    position: relative;
    padding: 18px;
    transition: transform 180ms var(--ease), border-color 180ms ease, background 180ms ease;
  }

  .listening-game.is-picked {
    border-color: var(--sun-500);
    background: var(--sun-wash);
    transform: translateY(-3px);
  }

  .game-number {
    position: absolute;
    right: 12px;
    top: 11px;
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 9.5px;
  }

  .game-icon {
    display: grid;
    place-items: center;
    width: 35px;
    height: 35px;
    margin-bottom: 10px;
    color: var(--violet-700);
    border-radius: 11px;
    background: var(--violet-wash);
  }

  .listening-game h3 {
    margin: 0 0 4px;
    color: var(--ink);
    font-size: 17px;
  }

  .listening-game p {
    margin: 0;
    color: var(--muted);
    font-size: 12.5px;
    line-height: 1.6;
  }

  .artist-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }

  .artist-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 280px;
    padding: 18px;
    overflow: hidden;
    border-top: 3px solid var(--artist-accent, var(--violet-500));
    background: var(--surface);
  }

  .artist-card.has-photo::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: var(--artist-photo);
    background-position: center;
    background-size: cover;
    transform: scale(1.02);
    transition: transform 500ms ease;
    pointer-events: none;
  }

  .artist-card.has-photo:hover::before {
    transform: scale(1.06);
  }

  .artist-card.has-photo::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(10, 7, 28, 0.28) 0%, rgba(10, 7, 28, 0.62) 45%, rgba(10, 7, 28, 0.96) 100%),
      linear-gradient(90deg, rgba(10, 7, 28, 0.55) 0%, rgba(10, 7, 28, 0.12) 72%);
    pointer-events: none;
  }

  .artist-card > * {
    position: relative;
    z-index: 1;
  }

  .artist-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 8px;
  }

  .artist-card.has-photo .artist-top {
    justify-content: flex-end;
  }

  .artist-avatar {
    display: grid;
    place-items: center;
    width: 47px;
    height: 47px;
    color: #fff;
    border-radius: 15px;
    background: linear-gradient(145deg, #8b72ff, #4b2ab4);
    box-shadow: 0 4px 0 rgba(83, 51, 186, 0.2);
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 900;
    transform: rotate(-3deg);
  }

  .artist-sky { background: linear-gradient(145deg, #67d0fa, #216fa8); color: #08243a; }
  .artist-pink { background: linear-gradient(145deg, #ff9fda, #b43c83); }
  .artist-mint { background: linear-gradient(145deg, #7be9c4, #218a72); color: #052e27; }
  .artist-sun { background: linear-gradient(145deg, #ffe28d, #d18a2f); color: #40280b; }
  .artist-coral { background: linear-gradient(145deg, #ff9d90, #bf4b4b); }

  .artist-country {
    padding: 3px 8px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    background: var(--surface-2);
    font-size: 10px;
    white-space: nowrap;
  }

  .artist-card.has-photo .artist-country {
    color: #fffaf0;
    border-color: rgba(255, 255, 255, 0.3);
    background: rgba(10, 7, 28, 0.45);
  }

  .artist-card h3 {
    margin: 11px 0 1px;
    color: var(--ink);
    font-size: 19px;
    line-height: 1.35;
  }

  .artist-card.has-photo h3 {
    color: #fffaf0;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.65);
  }

  .artist-en {
    margin: 0;
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 9px;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .artist-card.has-photo .artist-en {
    color: rgba(255, 245, 230, 0.7);
  }

  .artist-keyword {
    margin: 6px 0 0;
    color: var(--violet-700);
    font-size: 12px;
    font-weight: 800;
    line-height: 1.5;
  }

  .artist-card.has-photo .artist-keyword {
    color: #ffe7a8;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.6);
  }

  .artist-card details {
    margin-top: 8px;
    border: 0;
    border-top: 1px dashed var(--line);
    border-radius: 0;
    background: transparent;
  }

  .artist-card.has-photo details {
    border-top-color: rgba(255, 255, 255, 0.25);
  }

  .artist-card summary {
    display: flex;
    align-items: center;
    gap: 3px;
    min-height: 32px;
    padding: 8px 0 2px;
    color: var(--muted);
    font-size: 11px;
    font-weight: 750;
    list-style: none;
  }

  .artist-card.has-photo summary {
    color: rgba(255, 245, 230, 0.88);
  }

  .artist-card summary::-webkit-details-marker {
    display: none;
  }

  .artist-card summary .icon {
    margin-left: auto;
    transition: transform 150ms ease;
  }

  .artist-card details[open] summary .icon {
    transform: rotate(180deg);
  }

  .artist-card details p {
    margin: 7px 0 0;
    color: var(--ink-soft);
    font-size: 12px;
    line-height: 1.65;
  }

  .artist-card.has-photo details p {
    color: rgba(255, 245, 230, 0.92);
  }

  .artist-fun {
    display: flex;
    align-items: flex-start;
    gap: 4px;
    color: var(--muted) !important;
  }

  .artist-fun .icon {
    margin-top: 1px;
    color: var(--sun-700);
  }

  .artist-card.has-photo .artist-fun {
    color: rgba(255, 245, 230, 0.75) !important;
  }

  .artist-listen {
    display: flex;
    align-items: flex-start;
    gap: 4px;
    min-height: 32px;
    margin-top: auto;
    padding-top: 10px;
    color: var(--violet-700);
    font-size: 11.5px;
    font-weight: 800;
    line-height: 1.45;
    text-decoration: none;
  }

  .artist-card.has-photo .artist-listen {
    color: #ffd86f;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.65);
  }

  .artist-listen:hover {
    color: var(--violet-800);
  }

  .artist-card.has-photo .artist-listen:hover {
    color: #fff;
  }

  .artist-credits {
    margin-top: 16px;
    color: var(--muted);
    font-size: 10.5px;
    line-height: 1.55;
  }

  .artist-credits summary {
    cursor: pointer;
    color: var(--violet-700);
    font-weight: 800;
  }

  .artist-credits ul {
    display: grid;
    gap: 4px;
    margin: 8px 0 0;
    padding-left: 18px;
  }

  .artist-credits li {
    line-height: 1.5;
  }

  .artist-credits a {
    color: var(--violet-700);
    text-decoration: underline;
  }

  .artist-credits p {
    margin: 8px 0 0;
  }

  #jukebox,
  #repertoire {
    scroll-margin-top: calc(var(--header-h) + 18px);
  }

  .rep-jump-row {
    display: flex;
    justify-content: flex-end;
    margin-top: 10px;
  }

  .rep-fold-body {
    padding: 0 18px 18px;
  }

