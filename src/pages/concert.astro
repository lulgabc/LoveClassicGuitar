---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SectionHead from "../components/SectionHead.astro";
import Jukebox from "../components/Jukebox.astro";
import MascotBubble from "../components/MascotBubble.astro";
import Icon from "../components/Icon.astro";
import { COMPOSERS, CONCERT_ETIQUETTE, LISTENING_GAMES, MASTERS, PERFORMANCES } from "../data/concert";
import { url } from "../lib/url";

const gameIcons: Record<string, "book" | "ear" | "sun" | "compass" | "wand" | "refresh"> = {
  story: "book",
  radar: "ear",
  temperature: "sun",
  steps: "compass",
  draw: "wand",
  repeat: "refresh",
};
const shortGames = LISTENING_GAMES.slice(0, 4);
---

<BaseLayout
  title="音乐厅"
  description="给孩子的古典吉他音乐厅：页面内直接播放 Ana Vidović、Pepe Romero、杨雪霏等演奏家的精选曲目，附简短听音任务和演奏家小档案。"
>
  <PageHero
    kicker="Listening room · 星空音乐厅"
    title="点一下，<br />让音乐<em>直接开始</em>。"
    lead="不用跳转，也不用先读一大段介绍。选一首，按下播放，让耳朵先去旅行。"
  >
    <div class="slug">
      <span><Icon name="play" size={12} /> 页面内直接播放</span>
      <span><Icon name="headphones" size={12} /> {PERFORMANCES.length} 首精选</span>
      <span><Icon name="users" size={12} /> {MASTERS.length} 位演奏家</span>
      <span><Icon name="youtube" size={12} /> YouTube 嵌入</span>
    </div>
  </PageHero>

  <section class="section">
    <div class="container">
      <div class="section-head-row">
        <SectionHead
          kicker="Listening room · 今晚推荐"
          title="今晚的<em>曲目单</em>"
          lead={`每天从 ${PERFORMANCES.length} 首曲目里挑出 6 首“今晚推荐”。点“换一批”再抽一次，也可以打开全部曲目。`}
        />
        <a class="btn btn-ghost" href="#masters">认识演奏家 <Icon name="chevron-down" size={14} /></a>
      </div>
      <Jukebox items={PERFORMANCES} lang="zh" daily dailySize={6} />
    </div>
  </section>

  <section class="section section-wash">
    <div class="container">
      <div class="section-head-row">
        <SectionHead
          kicker="Petites missions d'écoute"
          title="听音乐，也可以像<em>玩游戏</em>"
          lead="不用分析曲式。挑一个听法，听两分钟，就已经在做很棒的耳朵训练。"
        />
        <button class="btn btn-sun btn-sm" type="button" data-pick-game><Icon name="wand" size={15} /> 抽一张听法卡</button>
      </div>
      <p class="picked-game" data-picked-game aria-live="polite">今天可以试试：先听整体，再只听低音。</p>
      <div class="listening-games">
        {
          shortGames.map((game, index) => (
            <article class="listening-game card" data-listening-game={game.title}>
              <span class="game-number">{String(index + 1).padStart(2, "0")}</span>
              <span class="game-icon"><Icon name={gameIcons[game.icon] ?? "ear"} size={21} /></span>
              <h3>{game.title}</h3>
              <p>{game.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="masters">
    <div class="container">
      <SectionHead
        kicker="Les guitaristes"
        title="他们的手指，<em>在讲什么故事？</em>"
        lead="点开一个人，读一小段故事；也可以直接去听他的演奏。"
      />
      <div class="artist-grid">
        {
          MASTERS.map((master) => (
            <article class="artist-card card">
              <div class="artist-top">
                <span class:list={["artist-avatar", `artist-${master.color}`]}>{master.initials}</span>
                <span class="artist-country">{master.country}</span>
              </div>
              <h3>{master.zhName}</h3>
              <p class="artist-en">{master.name}</p>
              <p class="artist-keyword">“{master.keyword}”</p>
              <details>
                <summary>点开小故事 <Icon name="chevron-down" size={14} /></summary>
                <p>{master.bio}</p>
                <p class="artist-fun"><Icon name="sparkle" size={12} /> {master.funFact}</p>
              </details>
              <a class="artist-listen" href={`https://www.youtube.com/watch?v=${master.videoId}`} target="_blank" rel="noopener noreferrer">
                <Icon name="headphones" size={13} /> 去听：{master.piece}
              </a>
            </article>
          ))
        }
      </div>
      <div class="masters-note">
        <MascotBubble who="capi" text="你不需要成为他们。你可以成为第一个“你自己”。" tone="pink" />
        <a class="btn btn-ghost" href="#top">回到播放器 <Icon name="arrow-up" size={13} /></a>
      </div>
    </div>
  </section>

  <section class="section section-wash">
    <div class="container">
      <div class="fold-grid">
        <details class="fold-card card">
          <summary><span><Icon name="book" size={18} /> 作曲家小档案</span><span class="fold-hint">8 位 · 点开</span><Icon name="chevron-down" size={17} /></summary>
          <div class="composer-grid">
            {
              COMPOSERS.map((composer) => (
                <article class="composer-card">
                  <div class="composer-head"><h3>{composer.name}</h3><span>{composer.years} · {composer.country}</span></div>
                  <p>{composer.fact}</p>
                  <div class="composer-listen"><Icon name="headphones" size={13} /> {composer.listening}</div>
                </article>
              ))
            }
          </div>
        </details>

        <details class="fold-card card">
          <summary><span><Icon name="heart" size={18} /> 去听真正的音乐会</span><span class="fold-hint">6 个小礼仪</span><Icon name="chevron-down" size={17} /></summary>
          <div class="etiquette-list">
            {CONCERT_ETIQUETTE.map((tip, index) => <div class="etiquette-item"><span>{String(index + 1).padStart(2, "0")}</span><p>{tip}</p></div>)}
          </div>
        </details>
      </div>
      <div class="concert-parent-note">
        <Icon name="shield" size={17} />
        <p><strong>给家长：</strong>视频通过 YouTube 隐私增强播放器直接嵌入。YouTube 可能显示广告或推荐内容，建议先预览并与孩子一起听。音量以舒服为准。</p>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container concert-bottom">
      <div><span class="eyebrow"><Icon name="guitar" size={13} /> 听完之后</span><h2>现在，轮到你的手指<br />去讲一个故事了。</h2></div>
      <div class="btn-row">
        <a class="btn btn-primary" href={url("/practice/")}>去练习室 <Icon name="arrow-right" size={14} /></a>
        <a class="btn btn-ghost" href={url("/library/")}>找免费曲谱</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const games = Array.from(document.querySelectorAll<HTMLElement>("[data-listening-game]"));
  const pickButton = document.querySelector<HTMLButtonElement>("[data-pick-game]");
  const picked = document.querySelector<HTMLElement>("[data-picked-game]");
  let lastPicked = -1;

  pickButton?.addEventListener("click", () => {
    if (!games.length) return;
    let next = Math.floor(Math.random() * games.length);
    if (games.length > 1 && next === lastPicked) next = (next + 1) % games.length;
    lastPicked = next;
    games.forEach((game, index) => game.classList.toggle("is-picked", index === next));
    const game = games[next];
    const title = game?.getAttribute("data-listening-game") ?? "听一首";
    if (picked) {
      picked.textContent = `今天可以试试：${title}。听完说说你发现了什么。`;
      picked.animate(
        [
          { opacity: 0, transform: "translateY(5px)" },
          { opacity: 1, transform: "translateY(0)" },
        ],
        { duration: 280, easing: "ease-out" },
      );
    }
    game?.scrollIntoView({ behavior: "smooth", block: "center" });
  });
</script>

<style>
  .slug {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 20px;
  }

  .slug span {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 5px 9px;
    color: #d7caf4;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    font-size: 9.5px;
    font-weight: 700;
  }

  .slug .icon {
    color: #ffd86f;
  }

  .listening-games {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 11px;
  }

  .picked-game {
    margin: -20px 0 18px;
    color: var(--violet-700);
    font-size: 12px;
    font-weight: 700;
  }

  .listening-game {
    position: relative;
    padding: 16px;
    transition: transform 180ms var(--ease), border-color 180ms ease, background 180ms ease;
  }

  .listening-game.is-picked {
    border-color: var(--sun-500);
    background: var(--sun-wash);
    transform: translateY(-3px);
  }

  .game-number {
    position: absolute;
    right: 12px;
    top: 11px;
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 8px;
  }

  .game-icon {
    display: grid;
    place-items: center;
    width: 35px;
    height: 35px;
    margin-bottom: 10px;
    color: var(--violet-700);
    border-radius: 11px;
    background: var(--violet-wash);
  }

  .listening-game h3 {
    margin: 0 0 4px;
    color: var(--ink);
    font-size: 14px;
  }

  .listening-game p {
    margin: 0;
    color: var(--muted);
    font-size: 10.5px;
    line-height: 1.65;
  }

  .artist-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
  }

  .artist-card {
    display: flex;
    flex-direction: column;
    padding: 14px;
    background: var(--surface);
  }

  .artist-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 8px;
  }

  .artist-avatar {
    display: grid;
    place-items: center;
    width: 47px;
    height: 47px;
    color: #fff;
    border-radius: 15px;
    background: linear-gradient(145deg, #8b72ff, #4b2ab4);
    box-shadow: 0 4px 0 rgba(83, 51, 186, 0.2);
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 900;
    transform: rotate(-3deg);
  }

  .artist-sky { background: linear-gradient(145deg, #67d0fa, #216fa8); color: #08243a; }
  .artist-pink { background: linear-gradient(145deg, #ff9fda, #b43c83); }
  .artist-mint { background: linear-gradient(145deg, #7be9c4, #218a72); color: #052e27; }
  .artist-sun { background: linear-gradient(145deg, #ffe28d, #d18a2f); color: #40280b; }
  .artist-coral { background: linear-gradient(145deg, #ff9d90, #bf4b4b); }

  .artist-country {
    padding: 3px 7px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    background: var(--surface-2);
    font-size: 8px;
    white-space: nowrap;
  }

  .artist-card h3 {
    margin: 11px 0 1px;
    color: var(--ink);
    font-size: 17px;
    line-height: 1.35;
  }

  .artist-en {
    margin: 0;
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 7.5px;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .artist-keyword {
    margin: 6px 0 0;
    color: var(--violet-700);
    font-size: 10.5px;
    font-weight: 800;
    line-height: 1.5;
  }

  .artist-card details {
    margin-top: 8px;
    border: 0;
    border-top: 1px dashed var(--line);
    border-radius: 0;
    background: transparent;
  }

  .artist-card summary {
    display: flex;
    align-items: center;
    gap: 3px;
    min-height: 26px;
    padding: 7px 0 2px;
    color: var(--muted);
    font-size: 8.5px;
    font-weight: 750;
    list-style: none;
  }

  .artist-card summary::-webkit-details-marker {
    display: none;
  }

  .artist-card summary .icon {
    margin-left: auto;
    transition: transform 150ms ease;
  }

  .artist-card details[open] summary .icon {
    transform: rotate(180deg);
  }

  .artist-card details p {
    margin: 7px 0 0;
    color: var(--ink-soft);
    font-size: 9px;
    line-height: 1.65;
  }

  .artist-fun {
    display: flex;
    align-items: flex-start;
    gap: 4px;
    color: var(--muted) !important;
  }

  .artist-fun .icon {
    margin-top: 1px;
    color: var(--sun-700);
  }

  .artist-listen {
    display: flex;
    align-items: flex-start;
    gap: 4px;
    min-height: 26px;
    margin-top: auto;
    padding-top: 9px;
    color: var(--violet-700);
    font-size: 8.5px;
    font-weight: 800;
    line-height: 1.45;
    text-decoration: none;
  }

  .artist-listen:hover {
    color: var(--violet-800);
  }

  .masters-note {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 15px;
  }

  .masters-note :global(.mascot-bubble) {
    flex: 1;
  }

  .fold-grid {
    display: grid;
    gap: 10px;
  }

  .fold-card {
    padding: 0;
    overflow: hidden;
  }

  .fold-card summary {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 16px 18px;
    color: var(--ink);
    font-size: 14px;
    font-weight: 800;
    list-style: none;
  }

  .fold-card summary::-webkit-details-marker {
    display: none;
  }

  .fold-card summary > span:first-child {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .fold-card summary > .icon {
    margin-left: auto;
    color: var(--faint);
    transition: transform 150ms ease;
  }

  .fold-card[open] summary > .icon {
    transform: rotate(180deg);
  }

  .fold-hint {
    margin-left: auto;
    color: var(--faint);
    font-size: 8px;
    font-weight: 650;
  }

  .composer-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
    padding: 0 18px 18px;
  }

  .composer-card {
    padding: 11px;
    border: 1px solid var(--line);
    border-radius: 11px;
    background: var(--surface-2);
  }

  .composer-head h3 {
    margin: 0 0 1px;
    color: var(--ink);
    font-size: 12px;
  }

  .composer-head span {
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 7px;
  }

  .composer-card > p {
    margin: 7px 0 0;
    color: var(--muted);
    font-size: 9px;
    line-height: 1.6;
  }

  .composer-listen {
    display: flex;
    align-items: flex-start;
    gap: 4px;
    margin-top: 7px;
    padding-top: 6px;
    border-top: 1px dashed var(--line);
    color: var(--sun-700);
    font-size: 7.5px;
    line-height: 1.5;
  }

  .etiquette-list {
    display: grid;
    gap: 2px;
    padding: 0 18px 18px;
  }

  .etiquette-item {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    padding: 7px 0;
    border-bottom: 1px dashed var(--line);
  }

  .etiquette-item:last-child {
    border-bottom: 0;
  }

  .etiquette-item span {
    color: var(--violet-700);
    font-family: var(--font-mono);
    font-size: 8px;
    font-weight: 800;
    line-height: 1.7;
  }

  .etiquette-item p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 11px;
    line-height: 1.65;
  }

  .concert-parent-note {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin-top: 15px;
    padding: 11px 13px;
    border: 1px dashed var(--line-strong);
    border-radius: 11px;
    color: var(--muted);
    font-size: 10px;
    line-height: 1.6;
  }

  .concert-parent-note .icon {
    margin-top: 1px;
    color: var(--violet-700);
  }

  .concert-parent-note p {
    margin: 0;
  }

  .concert-parent-note strong {
    color: var(--ink-soft);
  }

  .concert-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 26px;
    padding: clamp(23px, 4vw, 34px);
    border: 1.5px solid var(--line);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(circle at 88% 18%, rgba(255, 216, 111, 0.2), transparent 25%),
      var(--surface);
    box-shadow: var(--shadow);
  }

  .concert-bottom h2 {
    margin-top: 10px;
    font-size: clamp(24px, 3vw, 32px);
  }

  @media (max-width: 1100px) {
    .artist-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .listening-games {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 850px) {
    .artist-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .composer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .listening-games,
    .artist-grid,
    .composer-grid {
      grid-template-columns: 1fr;
    }

    .masters-note,
    .concert-bottom {
      align-items: flex-start;
      flex-direction: column;
    }

    .fold-hint {
      display: none;
    }
  }
</style>
