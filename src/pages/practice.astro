---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SectionHead from "../components/SectionHead.astro";
import PracticeTimer from "../components/PracticeTimer.astro";
import Metronome from "../components/Metronome.astro";
import Tuner from "../components/Tuner.astro";
import NoteGame from "../components/NoteGame.astro";
import EarGame from "../components/EarGame.astro";
import MascotBubble from "../components/MascotBubble.astro";
import Icon from "../components/Icon.astro";
import { PRACTICE_RULES, WARMUPS } from "../data/practice";
import { url } from "../lib/url";
---

<BaseLayout
  title="练习室"
  description="给孩子的古典吉他互动练习室：15 分钟计时器、节拍器、调弦参考音、音符游戏、耳朵游戏、热身动作和可打印练习卡。"
>
  <PageHero
    kicker="Practice room · 星空练习室"
    title="今天只练一点点，<br />也<em>算数</em>。"
    lead="15 分钟、10 分钟，甚至只弹一根空弦。让手指和耳朵先玩起来，练习不是作业，是你和音乐单独相处的时间。"
  >
    <div class="slug">
      <a href="#timer">15 分钟计时</a>
      <a href="#metronome">节拍器</a>
      <a href="#strings">听六根弦</a>
      <a href="#note-game">音符游戏</a>
      <a href="#ear-game">耳朵游戏</a>
    </div>
  </PageHero>

  <nav class="tool-rail" aria-label="练习工具">
    <div class="container tool-rail-inner">
      <span class="tool-rail-label"><Icon name="timer" size={15} /> 工具台</span>
      <a href="#timer"><Icon name="timer" size={13} /> 计时器</a>
      <a href="#metronome"><Icon name="metronome" size={13} /> 节拍器</a>
      <a href="#strings"><Icon name="tuning" size={13} /> 听音调弦</a>
      <a href="#note-game"><Icon name="game" size={13} /> 音符游戏</a>
      <a href="#ear-game"><Icon name="ear" size={13} /> 耳朵游戏</a>
      <a href="#warmups"><Icon name="heart" size={13} /> 热身</a>
      <a class="rail-print" href={url("/print/weekly/")}><Icon name="printer" size={13} /> 打印练习卡</a>
    </div>
  </nav>

  <section class="section" id="timer">
    <div class="container">
      <div class="practice-tip-strip">
        <div class="tip-strip-icon"><Icon name="sparkle" size={19} /></div>
        <div>
          <span>Momo 今天的小纸条</span>
          <p data-practice-tip aria-live="polite">今天只练一个小目标，就已经很棒。</p>
        </div>
        <button type="button" class="tip-strip-refresh" data-practice-tip-refresh><Icon name="refresh" size={15} /> 换一句</button>
      </div>

      <SectionHead
        kicker="01 · A gentle timer"
        title="先选一个长度，<em>开始就好</em>"
        lead="计时器会带你走完空弦、技术、曲目和听一听。中途暂停、跳步都可以，没有“必须撑完”。"
      />
      <PracticeTimer />
    </div>
  </section>

  <section class="section section-wash" id="metronome">
    <div class="container">
      <SectionHead
        kicker="02 · Keep the pulse"
        title="节拍器，是音乐的<em>心跳</em>"
        lead="60 BPM 是散步，72 是小步走，88 是小跑。先拍手，再上琴，拍子会更容易住进身体里。"
      />
      <Metronome />

      <div class="tuner-section" id="strings">
        <SectionHead
          kicker="03 · Tune your strings"
          title="听一听，<em>六根弦</em>的标准声音"
          lead="耳朵先认识“准”的声音，手指才知道要去哪里。第一年调音请大人帮忙，别让孩子独自拧弦轴。"
        />
        <Tuner />
      </div>
    </div>
  </section>

  <section class="section" id="games">
    <div class="container">
      <SectionHead
        kicker="04 · Play & listen"
        title="练习也可以像<em>玩游戏</em>"
        lead="游戏不计成绩，只训练眼睛和耳朵。每天玩 3 分钟，认识音符和听高低会变成自然反应。"
      />
      <div class="games-stack">
        <NoteGame />
        <EarGame />
      </div>
    </div>
  </section>

  <section class="section section-wash" id="warmups">
    <div class="container">
      <SectionHead
        kicker="05 · Warm up first"
        title="先让身体<em>打个哈欠</em>"
        lead="弹琴前花 1 分钟抖抖手、放松肩膀。手不是机器，先暖起来，声音才会松。"
      />
      <div class="warmup-layout">
        <div class="warmup-list">
          {
            WARMUPS.map((warmup, index) => (
              <article class="warmup-card card">
                <span class="warmup-index">{String(index + 1).padStart(2, "0")}</span>
                <div><h3>{warmup.title}</h3><p>{warmup.body}</p></div>
                <span class="warmup-time">30 秒</span>
              </article>
            ))
          }
        </div>

        <aside class="print-preview">
          <div class="print-paper">
            <span class="paper-hole"></span><span class="paper-hole"></span>
            <div class="print-paper-head"><span>LOVE CLASSIC GUITAR</span><strong>本周练习卡</strong><small>名字：___________　本周星星：☆ ☆ ☆ ☆ ☆</small></div>
            <div class="print-lines">
              <span>周一　听一首曲子，跟着哼</span>
              <span>周二　空弦 5 分钟 + 左手 3 分钟</span>
              <span>周三　休息，给耳朵放假</span>
              <span>周四　只练最难的 2 小节</span>
              <span>周五　即兴 4 小节</span>
              <span>周六　给家人弹一次</span>
              <span>周日　回看这周，挑一颗新星星</span>
            </div>
            <div class="print-stamp">慢慢来</div>
          </div>
          <div class="print-copy">
            <span class="mini-kicker">Print & pencil</span>
            <h3>把练习卡贴在琴盒上</h3>
            <p>有时候笔和纸比屏幕更有仪式感。打印一张，让孩子自己画星星或贴贴纸。</p>
            <a class="btn btn-secondary btn-sm" href={url("/print/weekly/")}><Icon name="printer" size={14} /> 打开可打印练习卡</a>
          </div>
        </aside>
      </div>

      <div class="practice-rules">
        {
          PRACTICE_RULES.map((rule) => (
            <div class="practice-rule"><Icon name="check" size={14} /><p>{rule}</p></div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container practice-bottom">
      <MascotBubble
        who="capi"
        text="如果你今天一点都不想练，就听一首喜欢的歌。明天再摸琴，音乐不会因此跑掉。"
        tone="sun"
      />
      <div class="btn-row">
        <a class="btn btn-primary" href={url("/roadmap/")}><Icon name="map" size={15} /> 回到学习地图</a>
        <a class="btn btn-ghost" href={url("/concert/")}>去听一首</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { PRACTICE_TIPS } from "../data/practice";

  const tipEl = document.querySelector<HTMLElement>("[data-practice-tip]");
  const refresh = document.querySelector<HTMLButtonElement>("[data-practice-tip-refresh]");
  let index = new Date().getDate() % PRACTICE_TIPS.length;

  if (tipEl) tipEl.textContent = PRACTICE_TIPS[index] ?? "";
  refresh?.addEventListener("click", () => {
    index = (index + 1) % PRACTICE_TIPS.length;
    if (tipEl) {
      tipEl.textContent = PRACTICE_TIPS[index] ?? "";
      tipEl.animate(
        [
          { opacity: 0, transform: "translateY(5px)" },
          { opacity: 1, transform: "translateY(0)" },
        ],
        { duration: 260, easing: "ease-out" },
      );
    }
    refresh.classList.remove("spin");
    void refresh.offsetWidth;
    refresh.classList.add("spin");
  });
</script>

<style>
  #timer,
  #metronome,
  #strings,
  #games,
  #warmups {
    scroll-margin-top: calc(var(--header-h) + 78px);
  }

  .slug {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 20px;
  }

  .slug a {
    display: inline-flex;
    padding: 5px 9px;
    color: #d9cef6;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    font-size: 9.5px;
    font-weight: 700;
    text-decoration: none;
  }

  .slug a:hover {
    color: #fff1c9;
    background: rgba(255, 216, 111, 0.1);
  }

  .tool-rail {
    position: sticky;
    top: var(--header-h);
    z-index: 40;
    background: color-mix(in srgb, var(--bg) 91%, transparent);
    border-bottom: 1px solid var(--line);
    backdrop-filter: blur(16px);
  }

  .tool-rail-inner {
    display: flex;
    align-items: center;
    gap: 2px;
    min-height: 52px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .tool-rail-inner::-webkit-scrollbar {
    display: none;
  }

  .tool-rail-label {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    flex: 0 0 auto;
    margin-right: 7px;
    color: var(--violet-700);
    font-size: 9px;
    font-weight: 850;
  }

  .tool-rail a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    flex: 0 0 auto;
    padding: 5px 8px;
    color: var(--muted);
    border-radius: 999px;
    font-size: 9px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  .tool-rail a:hover {
    color: var(--violet-700);
    background: var(--violet-wash);
  }

  .tool-rail .rail-print {
    margin-left: auto;
    color: var(--violet-700);
    background: var(--violet-wash);
  }

  .practice-tip-strip {
    display: flex;
    align-items: center;
    gap: 11px;
    margin-bottom: 30px;
    padding: 12px 15px;
    border: 1.5px dashed var(--line-strong);
    border-radius: 15px;
    background: var(--surface);
  }

  .tip-strip-icon {
    display: grid;
    place-items: center;
    flex: 0 0 35px;
    width: 35px;
    height: 35px;
    color: #67470b;
    border-radius: 12px;
    background: var(--sun-500);
    transform: rotate(-4deg);
  }

  .practice-tip-strip > div:nth-child(2) {
    flex: 1;
  }

  .practice-tip-strip span {
    display: block;
    color: var(--sun-700);
    font-family: var(--font-mono);
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .practice-tip-strip p {
    margin: 2px 0 0;
    color: var(--ink);
    font-size: 13.5px;
    font-weight: 650;
    line-height: 1.55;
  }

  .tip-strip-refresh {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    flex: 0 0 auto;
    padding: 6px 9px;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface-2);
    font-size: 8.5px;
    font-weight: 750;
  }

  .tip-strip-refresh:hover {
    color: var(--violet-700);
  }

  .tip-strip-refresh.spin .icon {
    animation: refresh-spin 460ms var(--ease);
  }

  .tuner-section {
    margin-top: clamp(36px, 5vw, 55px);
  }

  .games-stack {
    display: grid;
    gap: 17px;
  }

  .warmup-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(290px, 0.85fr);
    gap: 22px;
    align-items: start;
  }

  .warmup-list {
    display: grid;
    gap: 7px;
  }

  .warmup-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 13px 15px;
    box-shadow: none;
  }

  .warmup-index {
    color: var(--violet-700);
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 900;
    line-height: 1;
  }

  .warmup-card div {
    flex: 1;
  }

  .warmup-card h3 {
    margin: 0 0 2px;
    color: var(--ink);
    font-size: 14px;
  }

  .warmup-card p {
    margin: 0;
    color: var(--muted);
    font-size: 11.5px;
    line-height: 1.6;
  }

  .warmup-time {
    flex: 0 0 auto;
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 8px;
  }

  .print-preview {
    display: flex;
    flex-direction: column;
    gap: 17px;
    padding: 19px;
    border: 1.5px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .print-paper {
    position: relative;
    padding: 17px 18px 14px;
    border: 1px solid #d9c9b0;
    border-radius: 5px;
    background: #fff9ec;
    color: #4a3b2b;
    box-shadow: 4px 5px 0 rgba(132, 98, 47, 0.12);
    transform: rotate(-1.2deg);
    overflow: hidden;
  }

  .paper-hole {
    position: absolute;
    top: 7px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #e8d7bc;
  }

  .paper-hole:first-child { left: 10px; }
  .paper-hole:nth-child(2) { right: 10px; }

  .print-paper-head span {
    display: block;
    color: #765c3a;
    font-family: var(--font-mono);
    font-size: 6px;
    letter-spacing: 0.08em;
  }

  .print-paper-head strong {
    display: block;
    margin-top: 2px;
    color: #4a3b2b;
    font-family: var(--font-display);
    font-size: 18px;
  }

  .print-paper-head small {
    display: block;
    margin-top: 2px;
    color: #745c40;
    font-size: 7px;
  }

  .print-lines {
    display: grid;
    gap: 4px;
    margin-top: 10px;
    padding-top: 8px;
    border-top: 1px dashed #decbb0;
  }

  .print-lines span {
    color: #7c674e;
    font-size: 7.5px;
    line-height: 1.5;
    border-bottom: 1px dotted #ebddc7;
  }

  .print-stamp {
    position: absolute;
    right: 15px;
    bottom: 11px;
    color: #8a6227;
    border: 1px solid #d5b07a;
    border-radius: 4px;
    padding: 2px 5px;
    font-family: var(--font-display);
    font-size: 8px;
    transform: rotate(-8deg);
  }

  .print-copy h3 {
    margin: 3px 0 5px;
    color: var(--ink);
    font-size: 19px;
  }

  .print-copy p {
    margin: 0 0 12px;
    color: var(--muted);
    font-size: 11.5px;
    line-height: 1.65;
  }

  .mini-kicker {
    display: block;
    color: var(--violet-700);
    font-family: var(--font-mono);
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .practice-rules {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 7px;
    margin-top: 22px;
    padding: 15px;
    border: 1px dashed var(--line-strong);
    border-radius: 14px;
    background: var(--surface);
  }

  .practice-rule {
    display: flex;
    align-items: flex-start;
    gap: 5px;
    color: var(--muted);
  }

  .practice-rule .icon {
    margin-top: 2px;
    color: var(--mint-500);
  }

  .practice-rule p {
    margin: 0;
    font-size: 10px;
    line-height: 1.6;
  }

  .practice-bottom {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .practice-bottom :global(.mascot-bubble) {
    flex: 1;
  }

  @keyframes refresh-spin {
    to { transform: rotate(360deg); }
  }

  @media (max-width: 900px) {
    .warmup-layout {
      grid-template-columns: 1fr;
    }

    .print-preview {
      max-width: 540px;
    }

    .print-copy {
      max-width: 460px;
    }
  }

  @media (max-width: 700px) {
    .practice-tip-strip {
      align-items: flex-start;
      flex-wrap: wrap;
    }

    .practice-tip-strip > div:nth-child(2) {
      flex-basis: calc(100% - 51px);
    }

    .tip-strip-refresh {
      margin-left: 46px;
    }

    .practice-rules {
      grid-template-columns: 1fr;
    }

    .practice-bottom {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 520px) {
    .tool-rail {
      top: calc(var(--header-h) - 1px);
    }

    .tool-rail-label {
      display: none;
    }

    .tool-rail .rail-print {
      margin-left: 0;
    }

    .print-preview {
      padding: 14px;
    }

    .print-paper {
      transform: none;
    }
  }
</style>
