---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SectionHead from "../components/SectionHead.astro";
import PracticeTimer from "../components/PracticeTimer.astro";
import Metronome from "../components/Metronome.astro";
import Tuner from "../components/Tuner.astro";
import NoteGame from "../components/NoteGame.astro";
import EarGame from "../components/EarGame.astro";
import Icon from "../components/Icon.astro";
import { WARMUPS } from "../data/practice";
import { url } from "../lib/url";
---

<BaseLayout
  title="练习室"
  description="给孩子的古典吉他互动练习室：15 分钟计时器、节拍器、调弦参考音、音符游戏、耳朵游戏、热身动作和可打印练习卡。"
>
  <PageHero
    kicker="Practice room · 星空练习室"
    title="今天只练一点点，<br />也<em>算数</em>。"
    lead="15 分钟、10 分钟，甚至只弹一根空弦。让手指和耳朵先玩起来。"
  />

  <nav class="tool-rail" aria-label="练习工具">
    <div class="container tool-rail-inner">
      <span class="tool-rail-label"><Icon name="timer" size={15} /> 工具台</span>
      <a href="#timer"><Icon name="timer" size={13} /> 计时器</a>
      <a href="#metronome"><Icon name="metronome" size={13} /> 节拍器</a>
      <a href="#strings"><Icon name="tuning" size={13} /> 听音调弦</a>
      <a href="#note-game"><Icon name="game" size={13} /> 音符游戏</a>
      <a href="#ear-game"><Icon name="ear" size={13} /> 耳朵游戏</a>
      <a href="#warmups"><Icon name="heart" size={13} /> 热身</a>
      <a class="rail-print" href={url("/print/weekly/")}><Icon name="printer" size={13} /> 打印练习卡</a>
    </div>
  </nav>

  <section class="section" id="timer">
    <div class="container">
      <div class="practice-tip-strip">
        <div class="tip-strip-icon"><Icon name="sparkle" size={19} /></div>
        <div>
          <span>Momo 今天的小纸条</span>
          <p>今天只练一个小目标，就已经很棒。</p>
        </div>
      </div>

      <SectionHead
        title="先选一个长度，<em>开始就好</em>"
        lead="选 10、15 或 20 分钟，跟着走就好。"
      />
      <PracticeTimer />
    </div>
  </section>

  <section class="section section-wash" id="metronome">
    <div class="container">
      <SectionHead
        title="节拍器，是音乐的<em>心跳</em>"
        lead="先拍手，再上琴。60 BPM 像散步。"
      />
      <Metronome />

      <div class="tuner-section" id="strings">
        <SectionHead
          title="听一听，<em>六根弦</em>的标准声音"
          lead="第一年调音请大人帮忙。"
        />
        <Tuner />
      </div>
    </div>
  </section>

  <section class="section" id="games">
    <div class="container">
      <SectionHead
        title="练习也可以像<em>玩游戏</em>"
        lead="每天玩 3 分钟，认识音符和高低。"
      />
      <div class="games-stack">
        <NoteGame />
        <EarGame />
      </div>
    </div>
  </section>

  <section class="section section-wash" id="warmups">
    <div class="container">
      <SectionHead
        title="先让身体<em>打个哈欠</em>"
        lead="弹琴前花 1 分钟放松肩膀和手。"
      />
      <div class="warmup-layout">
        <div class="warmup-list">
          {
            WARMUPS.map((warmup, index) => (
              <article class="warmup-card card">
                <span class="warmup-index">{String(index + 1).padStart(2, "0")}</span>
                <div><h3>{warmup.title}</h3><p>{warmup.body}</p></div>
                <span class="warmup-time">30 秒</span>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container practice-bottom">
      <div class="btn-row">
        <a class="btn btn-primary" href={url("/roadmap/")}><Icon name="map" size={15} /> 回到学习地图</a>
        <a class="btn btn-ghost" href={url("/concert/")}>去听一首</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  #timer,
  #metronome,
  #strings,
  #games,
  #warmups {
    scroll-margin-top: calc(var(--header-h) + 78px);
  }

  .slug {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 20px;
  }

  .slug a {
    display: inline-flex;
    padding: 5px 9px;
    color: #d9cef6;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    font-size: 9.5px;
    font-weight: 700;
    text-decoration: none;
  }

  .slug a:hover {
    color: #fff1c9;
    background: rgba(255, 216, 111, 0.1);
  }

  .tool-rail {
    position: sticky;
    top: var(--header-h);
    z-index: 40;
    background: color-mix(in srgb, var(--bg) 91%, transparent);
    border-bottom: 1px solid var(--line);
    backdrop-filter: blur(16px);
  }

  .tool-rail-inner {
    display: flex;
    align-items: center;
    gap: 2px;
    min-height: 52px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .tool-rail-inner::-webkit-scrollbar {
    display: none;
  }

  .tool-rail-label {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    flex: 0 0 auto;
    margin-right: 7px;
    color: var(--violet-700);
    font-size: 11px;
    font-weight: 850;
  }

  .tool-rail a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    flex: 0 0 auto;
    min-height: 34px;
    padding: 6px 10px;
    color: var(--muted);
    border-radius: 999px;
    font-size: 11px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  .tool-rail a:hover {
    color: var(--violet-700);
    background: var(--violet-wash);
  }

  .tool-rail .rail-print {
    margin-left: auto;
    color: var(--violet-700);
    background: var(--violet-wash);
  }

  .practice-tip-strip {
    display: flex;
    align-items: center;
    gap: 11px;
    margin-bottom: 30px;
    padding: 12px 15px;
    border: 1.5px dashed var(--line-strong);
    border-radius: 15px;
    background: var(--surface);
  }

  .tip-strip-icon {
    display: grid;
    place-items: center;
    flex: 0 0 35px;
    width: 35px;
    height: 35px;
    color: #67470b;
    border-radius: 12px;
    background: var(--sun-500);
    transform: rotate(-4deg);
  }

  .practice-tip-strip > div:nth-child(2) {
    flex: 1;
  }

  .practice-tip-strip span {
    display: block;
    color: var(--sun-700);
    font-family: var(--font-mono);
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .practice-tip-strip p {
    margin: 2px 0 0;
    color: var(--ink);
    font-size: 13.5px;
    font-weight: 650;
    line-height: 1.55;
  }

  .tip-strip-refresh {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    flex: 0 0 auto;
    padding: 6px 9px;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface-2);
    font-size: 8.5px;
    font-weight: 750;
  }

  .tip-strip-refresh:hover {
    color: var(--violet-700);
  }

  .tip-strip-refresh.spin .icon {
    animation: refresh-spin 460ms var(--ease);
  }

  .tuner-section {
    margin-top: clamp(36px, 5vw, 55px);
  }

  .games-stack {
    display: grid;
    gap: 17px;
  }

  .warmup-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 22px;
    align-items: start;
  }

  .warmup-list {
    display: grid;
    gap: 7px;
  }

  .warmup-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 13px 15px;
    box-shadow: none;
  }

  .warmup-index {
    color: var(--violet-700);
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 900;
    line-height: 1;
  }

  .warmup-card div {
    flex: 1;
  }

  .warmup-card h3 {
    margin: 0 0 2px;
    color: var(--ink);
    font-size: 14px;
  }

  .warmup-card p {
    margin: 0;
    color: var(--muted);
    font-size: 11.5px;
    line-height: 1.6;
  }

  .warmup-time {
    flex: 0 0 auto;
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 8px;
  }

  .print-preview {
    display: flex;
    flex-direction: column;
    gap: 17px;
    padding: 19px;
    border: 1.5px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .print-paper {
    position: relative;
    padding: 17px 18px 14px;
    border: 1px solid #d9c9b0;
    border-radius: 5px;
    background: #fff9ec;
    color: #4a3b2b;
    box-shadow: 4px 5px 0 rgba(132, 98, 47, 0.12);
    transform: rotate(-1.2deg);
    overflow: hidden;
  }

  .paper-hole {
    position: absolute;
    top: 7px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #e8d7bc;
  }

  .paper-hole:first-child { left: 10px; }
  .paper-hole:nth-child(2) { right: 10px; }

  .print-paper-head span {
    display: block;
    color: #765c3a;
    font-family: var(--font-mono);
    font-size: 6px;
    letter-spacing: 0.08em;
  }

  .print-paper-head strong {
    display: block;
    margin-top: 2px;
    color: #4a3b2b;
    font-family: var(--font-display);
    font-size: 18px;
  }

  .print-paper-head small {
    display: block;
    margin-top: 2px;
    color: #745c40;
    font-size: 7px;
  }

  .print-lines {
    display: grid;
    gap: 4px;
    margin-top: 10px;
    padding-top: 8px;
    border-top: 1px dashed #decbb0;
  }

  .print-lines span {
    color: #7c674e;
    font-size: 7.5px;
    line-height: 1.5;
    border-bottom: 1px dotted #ebddc7;
  }

  .print-stamp {
    position: absolute;
    right: 15px;
    bottom: 11px;
    color: #8a6227;
    border: 1px solid #d5b07a;
    border-radius: 4px;
    padding: 2px 5px;
    font-family: var(--font-display);
    font-size: 8px;
    transform: rotate(-8deg);
  }

  .print-copy h3 {
    margin: 3px 0 5px;
    color: var(--ink);
    font-size: 19px;
  }

  .print-copy p {
    margin: 0 0 12px;
    color: var(--muted);
    font-size: 11.5px;
    line-height: 1.65;
  }

  .mini-kicker {
    display: block;
    color: var(--violet-700);
    font-family: var(--font-mono);
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .practice-rules {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 7px;
    margin-top: 22px;
    padding: 15px;
    border: 1px dashed var(--line-strong);
    border-radius: 14px;
    background: var(--surface);
  }

  .practice-rule {
    display: flex;
    align-items: flex-start;
    gap: 5px;
    color: var(--muted);
  }

  .practice-rule .icon {
    margin-top: 2px;
    color: var(--mint-500);
  }

  .practice-rule p {
    margin: 0;
    font-size: 10px;
    line-height: 1.6;
  }

  .practice-bottom {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
  }

  .practice-bottom :global(.mascot-bubble) {
    flex: 1;
  }

  @keyframes refresh-spin {
    to { transform: rotate(360deg); }
  }

  @media (max-width: 900px) {
    .warmup-layout {
      grid-template-columns: 1fr;
    }

    .print-preview {
      max-width: 540px;
    }

    .print-copy {
      max-width: 460px;
    }
  }

  @media (max-width: 700px) {
    .practice-tip-strip {
      align-items: flex-start;
      flex-wrap: wrap;
    }

    .practice-tip-strip > div:nth-child(2) {
      flex-basis: calc(100% - 51px);
    }

    .tip-strip-refresh {
      margin-left: 46px;
    }

    .practice-rules {
      grid-template-columns: 1fr;
    }

    .practice-bottom {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 520px) {
    .tool-rail {
      top: calc(var(--header-h) - 1px);
    }

    .tool-rail-label {
      display: none;
    }

    .tool-rail .rail-print {
      margin-left: 0;
    }

    .print-preview {
      padding: 14px;
    }

    .print-paper {
      transform: none;
    }
  }
</style>
