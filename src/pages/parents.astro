<script>
  const STORAGE_KEY = "lcg.parentCheck.v1";
  const checks = Array.from(document.querySelectorAll<HTMLInputElement>("[data-parent-check]"));
  const status = document.querySelector<HTMLElement>("[data-parent-check-status]");

  function read(): string[] {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      const parsed = raw ? JSON.parse(raw) : [];
      return Array.isArray(parsed) ? parsed.filter((item): item is string => typeof item === "string") : [];
    } catch {
      return [];
    }
  }

  function update(): void {
    const done = checks.filter((check) => check.checked).length;
    if (status) status.textContent = done === checks.length ? "这周已经做得很好了，剩下的交给音乐。" : `${done} / ${checks.length} 件小事`;
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(checks.filter((check) => check.checked).map((check) => check.dataset.parentCheck)));
    } catch {
      // Storage is optional; the checklist still works in this session.
    }
  }

  const saved = read();
  checks.forEach((check) => {
    check.checked = saved.includes(check.dataset.parentCheck ?? "");
    check.addEventListener("change", update);
  });
  update();
</script>

