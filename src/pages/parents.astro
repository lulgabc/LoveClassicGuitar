<script>
  const parentFolds = Array.from(document.querySelectorAll<HTMLDetailsElement>("[data-parent-fold]"));
  if (parentFolds.length) {
    const openParentFold = () => {
      const id = location.hash.replace("#", "");
      if (!id) return;
      parentFolds.forEach((fold) => {
        if (fold.closest("section")?.id === id) fold.open = true;
      });
    };
    openParentFold();
    window.addEventListener("hashchange", openParentFold);
  }
</script>
