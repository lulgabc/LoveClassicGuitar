---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SectionHead from "../components/SectionHead.astro";
import MascotBubble from "../components/MascotBubble.astro";
import Icon from "../components/Icon.astro";
import { MILESTONES } from "../data/roadmap";
import { url } from "../lib/url";

const vitals = [
  { value: "10–15", unit: "分钟", label: "每次练习的舒服长度", icon: "clock" as const },
  { value: "3–5", unit: "次 / 周", label: "稳定比“每天”更现实", icon: "calendar" as const },
  { value: "1", unit: "个重点", label: "一次只纠正一件事", icon: "check" as const },
  { value: "0", unit: "次比较", label: "只和昨天的自己比", icon: "heart" as const },
];

const startCards = [
  {
    icon: "guitar" as const,
    title: "琴：合身比“能用到长大”重要",
    body: "7 岁常见 1/2 或 3/4 尺寸，但年龄只是参考。坐好后琴头大约到眼睛或肩膀高度，左臂能轻松够到第 1 品，琴身不挡脸。尼龙弦、合适的弦距，比品牌和价格更影响第一年的体验。",
    note: "不要为了“多用几年”买全尺寸。过大的琴会逼出坏姿势，也可能让孩子以为“我不适合弹琴”。",
  },
  {
    icon: "users" as const,
    title: "老师：一双能看见细节的眼睛",
    body: "视频可以教知识，但很难看见孩子的手腕是不是紧、琴是不是滑、按弦有没有碰到旁边的弦。一个好的启蒙老师会先看姿势、放松和声音，而不是急着让你买教材、考级或弹很难的曲子。",
    note: "不需要每天上课。稳定的一周一次或两周一次，配合清晰的家庭练习，通常比“想起来才上一次”更有效。",
  },
  {
    icon: "heart" as const,
    title: "期待：第一年，先喜欢上这件乐器",
    body: "音乐学习不是直线。孩子可能这周很爱弹，下周只想听。7 岁的手还在发育，注意力也短。能完整弹一首短曲、能听出自己有没有弹错、愿意在家里表演，都是很真实的进步。",
    note: "不要用“别人家孩子几岁考几级”当坐标。每个孩子的身体、兴趣和家庭节奏都不同。",
  },
];

const practiceSteps = [
  { time: "2 分钟", title: "坐好，听空弦", body: "不急着按弦。每根弦拨 4 次，听声音从响到消失。" },
  { time: "4 分钟", title: "一个技术小任务", body: "i–m 交替、左手落指或靠弦。只做一个小目标。" },
  { time: "6 分钟", title: "曲子慢练", body: "只练最难的 2–4 小节。连续弹对 3 次，再往前接。" },
  { time: "3 分钟", title: "完整弹一遍 / 听一首", body: "让音乐完整地发生一次。结束在好听的地方，而不是错误上。" },
];

const sayInstead = [
  { avoid: "“你怎么又弹错了？”", instead: "“我们看看是哪一小节卡住了。”" },
  { avoid: "“别人都学到第几级了。”", instead: "“今天的低音比上周稳了。”" },
  { avoid: "“再弹十遍！”", instead: "“这一小段连续对三次，我们就休息。”" },
  { avoid: "“你怎么一点都不想练？”", instead: "“今天想先听一首，还是先弹一根空弦？”" },
  { avoid: "“手型又塌了！”", instead: "把老师说的一个要点变成一个游戏，例如“指尖站小山”。" },
];

const motivation = [
  { title: "两分钟规则", body: "不想练时，只约定“坐下来两分钟”。通常开始后，孩子会愿意多弹一会儿；两分钟到了也可以真的停。" },
  { title: "给她选择", body: "“先练空弦还是先练曲子？”“今天弹给水豚听还是给爸爸听？”选择感会减少对抗。" },
  { title: "换成听、唱、画", body: "不碰琴也算音乐时间。听一首曲子、画出旋律、跟着打拍子，都能保持连接。" },
  { title: "邀请一位观众", body: "毛绒玩具、家里的猫、视频通话里的爷爷奶奶都可以是观众。演出感会让练习有目的。" },
  { title: "别用奖励绑架", body: "“弹完就有糖”会把音乐变成交换。可以庆祝努力，但不要让孩子觉得只有换到礼物才值得弹。" },
  { title: "检查身体和环境", body: "累、饿、琴太大、弦太高、房间太吵，都会让练习变难。先排除这些，再谈“毅力”。" },
  { title: "允许停一天", body: "休息不会让音乐跑掉。真正需要警惕的是长期焦虑、疼痛和恐惧，而不是某一天不想弹。" },
  { title: "把错误变成寻宝", body: "让孩子当“声音侦探”，找出哪里不一样。错误不再是“被批评”，而是下一个线索。" },
];

const teacherQuestions = [
  "您主要教古典吉他吗？会教 6–8 岁的孩子吗？",
  "第一节课会检查琴的尺寸、弦距和坐姿吗？",
  "如果孩子手疼或姿势不舒服，通常怎么处理？",
  "您希望我们每周练几次、每次多久？会不会给家长清晰的练习说明？",
  "可以使用什么教材？为什么选它？有免费或图书馆能借的替代吗？",
  "家长可以旁听或录音吗？如果不能，怎样知道孩子在家练得对不对？",
  "您怎样看待考级、比赛和表演？如果孩子只想慢慢学，可以吗？",
  "孩子弹错或不想练时，您通常怎么反馈？",
  "是否有机会参加小型合奏、学生音乐会或家庭演出？",
  "如果孩子和老师不合适，怎样沟通换老师或暂停？",
];

const redFlags = [
  "让孩子忍着明显的疼痛继续弹，或把“疼”当成不努力。",
  "只用考级、比赛和排名评价孩子，忽略声音、姿势和兴趣。",
  "不允许家长提问，也不解释为什么这样练。",
  "第一节课就要求买昂贵设备、参加很多付费项目。",
  "课堂缺少安全检查和放松提醒，只强调“多练、再用力”。",
  "孩子长期害怕上课、出现明显焦虑或身体不适，却被要求坚持。",
];

const privacyPoints = [
  "本站没有账号、登录、评论、广告或访问统计，不主动收集姓名、邮箱和设备信息。",
  "名字、任务勾选和练习记录只保存在浏览器的 localStorage 中，换设备或清理浏览器数据后会消失。",
  "首页和音乐厅直接嵌入 YouTube 隐私增强播放器（youtube-nocookie.com）；滚动到播放器时即会加载视频，之后适用 YouTube 的隐私政策。外部链接会离开本站。",
  "请不要在公开网络上传孩子的正脸、学校、住址、课表或练琴视频，除非你已认真考虑隐私并取得孩子同意。",
  "视频平台可能有广告、评论和自动推荐。建议家长先预览，开启儿童模式，并避免把自动播放当作“陪练”。",
  "本站内容是学习与陪伴参考，不替代专业老师、医生或心理支持。出现持续疼痛、麻木或焦虑时，请寻求专业帮助。",
];

const faqs = [
  {
    q: "7 岁开始学古典吉他，会不会太晚或太早？",
    a: "7 岁是常见的启蒙年龄之一，但关键是注意力、手指条件和兴趣，不是生日。能安静坐 10 分钟、愿意听指令、手能抱住合适的琴，就可以开始。更小也可以用游戏和听音乐启蒙，不必急着按弦。",
  },
  {
    q: "每天都必须练吗？",
    a: "不必。每周 3–5 次、每次 10–15 分钟，通常足以建立习惯。练习频率比单次时长更重要，但休息、生病和家庭安排都应该被允许。",
  },
  {
    q: "一定要找老师吗？可以看视频自学吗？",
    a: "视频适合补充和激发兴趣，但初学者非常需要有人检查琴的尺寸、姿势、手型和声音。至少找老师做几次入门检查，或定期上一次课，会更安全。",
  },
  {
    q: "手指疼是正常的吗？",
    a: "初期指尖可能有轻微压痛，但不应该出现刺痛、麻木、关节痛或持续疼痛。检查琴弦高度、按弦位置和练习时长；如果疼痛持续，请暂停并让老师或有经验的琴行检查，必要时咨询专业人士。",
  },
  {
    q: "家长不懂音乐，能陪练吗？",
    a: "能。你不需要纠正手型，只要帮孩子调好音、留出时间、听她弹完、夸具体细节。老师负责技术，家长负责环境和情绪，这已经是很大的支持。",
  },
  {
    q: "什么时候可以买更大的琴？",
    a: "不要按年龄盲目升级。看孩子坐好后左臂是否仍能轻松够到第 1 品、琴身是否挡住视线、手指是否能舒服地按弦。每次换琴都请老师或有经验的琴行检查。",
  },
  {
    q: "要不要考级？",
    a: "考级可以提供目标和曲目库，但不是必需品。如果它会带来持续焦虑、跳过基础或牺牲兴趣，就不值得。先和老师讨论孩子为什么学琴，再决定。",
  },
  {
    q: "孩子想放弃，应该坚持吗？",
    a: "先区分“今天不想练”和“持续不快乐”。前者可以用两分钟规则、换材料、休息来处理；后者要认真听孩子的感受，检查老师、琴、身体和压力来源。放弃一项活动不等于失败，强迫也可能伤害亲子关系。",
  },
];
---

<BaseLayout
  title="给爸爸妈妈"
  description="给琴童家长的古典吉他陪伴指南：怎样选琴、找老师、安排 15 分钟练习、面对不想练、保护隐私与听力安全。"
>
  <PageHero
    kicker="For grown-ups · 给爸爸妈妈"
    title="你不需要懂吉他，<br />也能陪她<em>走很远</em>。"
    lead="7 岁学琴，最珍贵的不是进度，是她还愿意坐下来，和琴待一会儿。这里有一份不焦虑的陪伴指南，也有需要认真对待的安全边界。"
  >
  </PageHero>

  <section class="section-tight">
    <div class="container">
      <div class="vitals-grid">
        {
          vitals.map((vital) => (
            <div class="vital-card card">
              <span class="vital-icon"><Icon name={vital.icon} size={19} /></span>
              <div><strong>{vital.value}<small>{vital.unit}</small></strong><p>{vital.label}</p></div>
            </div>
          ))
        }
      </div>
      <div class="parent-manifesto">
        <span class="manifesto-mark">“</span>
        <p>陪练不是监工。你是帮她调好音的人、在她弹完时还在听的人、告诉她“慢慢来也没关系”的人。</p>
        <span class="manifesto-heart"><Icon name="heart" size={18} /></span>
      </div>
    </div>
  </section>

  <section class="section" id="start">
    <div class="container">
      <SectionHead
        kicker="01 · Before you start"
        title="开始之前，先把<em>三件事</em>放好"
        lead="合适的琴、合适的人、合适的期待。它们比“买最贵的教材”更能决定孩子能不能长期喜欢音乐。"
      />
      <div class="start-grid">
        {
          startCards.map((card, index) => (
            <article class="start-card card">
              <span class="start-number">{String(index + 1).padStart(2, "0")}</span>
              <span class="start-icon"><Icon name={card.icon} size={22} /></span>
              <h3>{card.title}</h3>
              <p>{card.body}</p>
              <div class="start-note"><Icon name="lightbulb" size={13} /> {card.note}</div>
            </article>
          ))
        }
      </div>

      <div class="size-guide">
        <div class="size-copy">
          <span class="mini-kicker">Instrument fit</span>
          <h3>一个非常粗略的尺寸参考</h3>
          <p>下面只是常见范围，不能代替试琴。每个孩子的身高、臂长和坐姿不同，琴的桶型也不同。</p>
        </div>
        <div class="size-table">
          <div><strong>1/2</strong><span>约 5–8 岁</span><small>常见入门尺寸，仍要试抱</small></div>
          <div><strong>3/4</strong><span>约 8–11 岁</span><small>不是“越大越好”</small></div>
          <div><strong>4/4</strong><span>约 11 岁+</span><small>以坐姿和臂长为准</small></div>
        </div>
        <p class="size-caveat"><Icon name="info" size={14} /> 如果坐好后必须伸长左臂、琴身挡住下巴，或右手肘耸得很高，这很可能不是合适尺寸。请老师或琴行帮忙看一次。</p>
      </div>

      <div class="first-lesson">
        <div class="first-lesson-head"><span class="mini-kicker">The first lessons</span><h3>第一节到第四节课，通常会发生什么？</h3></div>
        <div class="first-lesson-steps">
          <div><span>01</span><p>认识琴、坐姿、脚凳和放松，不急着弹很难的东西。</p></div>
          <div><span>02</span><p>空弦、右手拨弦、听声音，可能连谱子都还没有翻开。</p></div>
          <div><span>03</span><p>第一个音、第一个节奏，老师开始示范“怎样听自己”。</p></div>
          <div><span>04</span><p>一条短旋律或小练习，开始有可以带回家的目标。</p></div>
        </div>
        <p class="first-lesson-note">如果老师第一节课就让孩子长时间按弦、追求声音很大，或完全不看姿势，值得再观察一下。好的开头通常是慢的。</p>
      </div>
    </div>
  </section>

  <section class="section section-wash" id="daily">
    <div class="container">
      <SectionHead
        kicker="02 · The daily 15"
        title="每天 15 分钟，<em>怎么陪</em>？"
        lead="不用坐在旁边盯着每个手指。把练习变成一个有开始、有结束的小仪式，孩子会更容易自己走进去。"
      />
      <div class="daily-layout">
        <div class="daily-timeline">
          {practiceSteps.map((step, index) => (
            <article class="daily-step">
              <span class="daily-time">{step.time}</span>
              <span class="daily-dot">{index + 1}</span>
              <div><h3>{step.title}</h3><p>{step.body}</p></div>
            </article>
          ))}
        </div>
        <aside class="daily-side card">
          <span class="mini-kicker">Parent script</span>
          <h3>陪练时，换一种说法</h3>
          <div class="say-list">
            {
              sayInstead.map((item) => (
                <div class="say-item">
                  <span class="say-avoid">✕ {item.avoid}</span>
                  <span class="say-instead">✓ {item.instead}</span>
                </div>
              ))
            }
          </div>
          <div class="daily-side-note">
            <Icon name="info" size={14} />
            <p>除非老师特别交代，家长不需要自己纠正手型。你最了解孩子，但技术细节交给老师，避免家里出现两个互相矛盾的标准。</p>
          </div>
        </aside>
      </div>

      <div class="ritual-box">
        <div class="ritual-head"><Icon name="sparkle" size={19} /><h3>一个可复制的“练琴仪式”</h3></div>
        <div class="ritual-steps">
          <span>调好音</span><i>→</i><span>喝口水</span><i>→</i><span>说今天的一个小目标</span><i>→</i><span>15 分钟</span><i>→</i><span>完整弹一次</span><i>→</i><span>收琴、击掌</span>
        </div>
        <p>仪式越固定，孩子越不需要每天重新决定“要不要练”。但仪式不是铁律，偶尔打破也没关系。</p>
      </div>
    </div>
  </section>

  <section class="section" id="motivation">
    <div class="container">
      <SectionHead
        kicker="03 · When practice gets hard"
        title="当她说“<em>我不想练</em>”"
        lead="先别把这句话当成挑战。它可能只是累了、难了、想被看见，或者今天真的需要休息。"
      />
      <div class="motivation-grid">
        {
          motivation.map((item, index) => (
            <article class="motivation-card card">
              <span class="motivation-index">{String(index + 1).padStart(2, "0")}</span>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))
        }
      </div>
      <div class="motivation-note">
        <MascotBubble who="capi" text="如果孩子连续几周都害怕练琴，先停下来听她说。音乐应该让她更像自己，而不是更怕犯错。" tone="pink" />
        <a class="btn btn-ghost" href="#privacy">看看屏幕与安全建议 <Icon name="arrow-right" size={13} /></a>
      </div>
    </div>
  </section>

  <section class="section section-wash" id="teacher">
    <div class="container">
      <details class="content-fold" data-parent-fold>
        <summary>怎样找到一个合适的老师</summary>
        <div class="content-fold-body">
      <SectionHead
        kicker="04 · Finding a teacher"
        title="怎样找到一个<em>合适的老师</em>"
        lead="不是找“最厉害”的老师，而是找能看见你孩子、能把要求说清楚、愿意和家长合作的老师。"
      />
      <div class="teacher-layout">
        <div class="teacher-questions card">
          <div class="teacher-card-head"><span class="mini-kicker">Ask these</span><h3>试课时可以问的 10 个问题</h3></div>
          <ol>{teacherQuestions.map((question) => <li>{question}</li>)}</ol>
        </div>
        <aside class="teacher-side">
          <div class="red-flag-card">
            <div class="red-flag-head"><span class="red-flag-icon"><Icon name="shield" size={19} /></span><div><span class="mini-kicker">Careful</span><h3>需要警惕的信号</h3></div></div>
            <ul>{redFlags.map((flag) => <li><Icon name="close" size={12} /> {flag}</li>)}</ul>
          </div>
          <div class="teacher-tip">
            <Icon name="lightbulb" size={15} />
            <p><strong>试课不只看老师弹得多好。</strong>看老师有没有先问孩子的名字、有没有蹲下来听她说话、有没有在纠正前先示范和鼓励。</p>
          </div>
        </aside>
      </div>

      <div class="where-teacher">
        <h3>去哪里找线索？</h3>
        <div class="where-grid">
          <div><Icon name="users" size={17} /><strong>音乐学校 / 琴行</strong><p>优先问是否有古典吉他专门的老师，而不是所有吉他都用同一套教法。</p></div>
          <div><Icon name="music" size={17} /><strong>音乐学院 / 大学生</strong><p>古典吉他专业的学生可能更愿意教初学者，费用也相对友好。试课前确认教学经验。</p></div>
          <div><Icon name="heart" size={17} /><strong>家长口碑</strong><p>问其他琴童家长“老师是否让孩子害怕”“是否允许提问”，比只问考了几级更有用。</p></div>
          <div><Icon name="headphones" size={17} /><strong>线上课</strong><p>可以作为补充，但对 7 岁孩子，设备和机位要求高。初次入门仍建议至少有一次线下姿势检查。</p></div>
        </div>
      </div>
    
        </div>
