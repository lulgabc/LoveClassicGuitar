---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import SectionHead from "../../components/SectionHead.astro";
import Jukebox from "../../components/Jukebox.astro";
import RepertoireLibrary from "../../components/RepertoireLibrary.astro";
import MascotBubble from "../../components/MascotBubble.astro";
import Icon from "../../components/Icon.astro";
import { ARTISTS_FR, COMPOSERS_FR, ETIQUETTE_FR, LISTENING_GAMES_FR, PERFORMANCES_FR } from "../../data/fr/concert";
import { REPERTOIRE } from "../../data/repertoire";
import { url } from "../../lib/url";

const artistAccents: Record<string, string> = {
  violet: "var(--violet-500)",
  sky: "var(--sky-500)",
  pink: "var(--pink-500)",
  mint: "var(--mint-500)",
  sun: "var(--sun-500)",
  coral: "var(--coral-500)",
};
---

<BaseLayout
  lang="fr"
  title="La salle de concert"
  description="Une salle de concert pour enfants : 18 pièces jouables dans la page, une bibliothèque de 200 pièces à filtrer par époque et niveau, des missions d'écoute et des portraits de guitaristes."
>
  <PageHero
    kicker="Salle de concert · Sous les étoiles"
    title="Un clic, et<br />la musique <em>commence</em>."
    lead="Pas besoin de changer de page. Choisis une pièce, appuie sur play, et laisse tes oreilles voyager."
  >
  </PageHero>

  <section class="section" id="listen">
    <div class="container">
      <div class="listen-modes" role="group" aria-label="Choisir une façon d'écouter">
        <button class="listen-mode is-active" type="button" data-listen-mode="now" aria-pressed="true">
          <Icon name="play" size={18} />
          <span><strong>Écouter maintenant</strong><small>18 pièces · un clic suffit</small></span>
        </button>
        <button class="listen-mode" type="button" data-listen-mode="library" aria-pressed="false">
          <Icon name="book" size={18} />
          <span><strong>Explorer 200 pièces</strong><small>Par époque, niveau, mot-clé</small></span>
        </button>
      </div>

      <div class="listen-panel" id="jukebox" data-listen-panel="now">
        <div class="section-head-row">
          <SectionHead kicker="Écouter maintenant" title="Le programme de ce soir" lead={`Chaque soir, six pièces choisies parmi ${PERFORMANCES_FR.length}. Tire à nouveau ou ouvre toute la liste.`} />
          <a class="btn btn-ghost" href="#artists">Les guitaristes <Icon name="chevron-down" size={14} /></a>
        </div>
        <Jukebox items={PERFORMANCES_FR} lang="fr" daily dailySize={6} />
        <div class="rep-jump-row">
          <button class="btn btn-ghost btn-sm" type="button" data-open-library><Icon name="book" size={14} /> Explorer les 200 pièces <Icon name="arrow-right" size={13} /></button>
        </div>
      </div>

      <div class="listen-panel" id="repertoire" data-listen-panel="library" hidden>
        <div class="section-head-row">
          <SectionHead
            kicker="La bibliothèque · 200 pièces"
            title="Une bibliothèque à <em>explorer</em>."
            lead="De la Renaissance à aujourd'hui : cherche par époque, niveau ou mot-clé. Les 18 pièces jouables ramènent à « Écouter maintenant » ; les autres ouvrent YouTube."
          />
          <button class="btn btn-ghost" type="button" data-open-now>Retour à l'écoute <Icon name="arrow-up" size={13} /></button>
        </div>
        <RepertoireLibrary pieces={REPERTOIRE} lang="fr" />
      </div>
    </div>
  </section>

  <section class="section section-wash">
    <div class="container">
      <SectionHead kicker="Missions d'écoute" title="Écouter, c'est déjà <em>jouer</em>" lead="Pas de théorie. Choisis une mission et écoute deux minutes." />
      <div class="missions">
        {LISTENING_GAMES_FR.map((game, index) => (
          <article class="mission card">
            <span class="mission-num">{String(index + 1).padStart(2, "0")}</span>
            <span class="mission-icon"><Icon name={game.icon} size={20} /></span>
            <h3>{game.title}</h3>
            <p>{game.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="artists">
    <div class="container">
      <SectionHead kicker="Les guitaristes" title="Leurs doigts racontent <em>une histoire</em>" lead="Ouvre un portrait si tu veux en savoir plus, ou écoute simplement la pièce proposée." />
      <div class="artist-grid">
        {ARTISTS_FR.map((artist) => (
          <article
            class:list={["artist-card", "card", { "has-photo": Boolean(artist.photo) }]}
            style={artist.photo ? `--artist-photo:url(${url(artist.photo)}); --artist-accent:${artistAccents[artist.color]}` : undefined}
          >
            <div class="artist-top">
              {!artist.photo && <span class:list={["artist-avatar", `artist-${artist.color}`]}>{artist.initials}</span>}
              <span class="artist-country">{artist.country}</span>
            </div>
            <h3>{artist.name}</h3>
            <p class="artist-keyword">« {artist.keyword} »</p>
            <details>
              <summary>Le petit portrait <Icon name="chevron-down" size={14} /></summary>
              <p>{artist.bio}</p>
              <p class="artist-fun"><Icon name="sparkle" size={12} /> {artist.fun}</p>
            </details>
            <a class="artist-listen" href={`https://www.youtube.com/watch?v=${artist.videoId}`} target="_blank" rel="noopener noreferrer"><Icon name="headphones" size={13} /> {artist.piece}</a>
          </article>
        ))}
      </div>
      <div class="artist-note">
        <MascotBubble who="momo" title="Momo te dit" text="Tu n'as pas besoin de ressembler à ces guitaristes. Tu peux devenir la première version de toi-même." tone="pink" />
        <a class="btn btn-ghost" href="#top">Retour au lecteur <Icon name="arrow-up" size={13} /></a>
      </div>
      <details class="artist-credits">
        <summary>Crédits photos</summary>
        <ul>
          {ARTISTS_FR.map((artist) => (
            <li>
              <strong>{artist.name}</strong> :{" "}
              <a href={artist.photoUrl} target="_blank" rel="noopener noreferrer">{artist.photoCredit}</a>
              {" "}({artist.photoLicense})
            </li>
          ))}
        </ul>
        <p>Photos utilisées pour présenter les guitaristes. Certaines viennent de Wikimedia Commons, d'autres des vidéos correspondantes ; les vignettes restent la propriété de leurs chaînes.</p>
      </details>
    </div>
  </section>

  <section class="section section-wash">
    <div class="container folds">
      <details class="fold card">
        <summary><span><Icon name="book" size={18} /> Les compositeurs</span><span class="fold-hint">8 portraits</span><Icon name="chevron-down" size={17} /></summary>
        <div class="composer-grid">
          {COMPOSERS_FR.map((composer) => (
            <article class="composer-card">
              <h3>{composer.name}</h3>
              <span>{composer.years} · {composer.country}</span>
              <p>{composer.fact}</p>
              <small><Icon name="headphones" size={12} /> {composer.listening}</small>
            </article>
          ))}
        </div>
      </details>
      <details class="fold card">
        <summary><span><Icon name="heart" size={18} /> Au vrai concert</span><span class="fold-hint">6 conseils</span><Icon name="chevron-down" size={17} /></summary>
        <div class="etiquette">
          {ETIQUETTE_FR.map((tip, index) => <p><b>{String(index + 1).padStart(2, "0")}</b> {tip}</p>)}
        </div>
      </details>
    </div>
    <p class="privacy-note container"><Icon name="shield" size={15} /> Le lecteur utilise YouTube en mode confidentialité renforcée. Un adulte peut vérifier le volume et les réglages. YouTube peut afficher des recommandations ou des publicités.</p>
  </section>

  <section class="section-tight">
    <div class="container concert-bottom">
      <div><span class="eyebrow"><Icon name="guitar" size={13} /> Après l'écoute</span><h2>À ton tour de raconter<br />une histoire.</h2></div>
      <div class="btn-row"><a class="btn btn-primary" href={url("/fr/practice/")}>Aller au studio <Icon name="arrow-right" size={14} /></a><a class="btn btn-ghost" href={url("/fr/library/")}>Trouver des partitions</a></div>
    </div>
  </section>
</BaseLayout>

<script>
  const listenSection = document.querySelector<HTMLElement>("#listen");
  const modeButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-listen-mode]"));
  const listenPanels = Array.from(document.querySelectorAll<HTMLElement>("[data-listen-panel]"));

  function setListenMode(mode: string, scroll = false): void {
    modeButtons.forEach((button) => {
      const active = button.dataset.listenMode === mode;
      button.classList.toggle("is-active", active);
      button.setAttribute("aria-pressed", String(active));
    });
    listenPanels.forEach((panel) => {
      panel.hidden = panel.dataset.listenPanel !== mode;
    });
    if (scroll) listenSection?.scrollIntoView({ behavior: "smooth", block: "start" });
  }

  modeButtons.forEach((button) => {
    button.addEventListener("click", () => setListenMode(button.dataset.listenMode ?? "now", true));
  });

  document.querySelectorAll<HTMLButtonElement>("[data-open-library]").forEach((button) => {
    button.addEventListener("click", () => setListenMode("library", true));
  });

  document.querySelectorAll<HTMLButtonElement>("[data-open-now]").forEach((button) => {
    button.addEventListener("click", () => setListenMode("now", true));
  });

  function applyListenHash(): void {
    if (location.hash === "#repertoire") {
      setListenMode("library");
      requestAnimationFrame(() => listenSection?.scrollIntoView({ block: "start" }));
    } else if (location.hash === "#jukebox" || location.hash === "#listen") {
      setListenMode("now");
      requestAnimationFrame(() => listenSection?.scrollIntoView({ block: "start" }));
    }
  }

  applyListenHash();
  window.addEventListener("hashchange", applyListenHash);
  document.addEventListener("concert:listen", () => setListenMode("now"));
</script>

<style>
  .slug {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 20px;
  }

  .slug span {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 5px 9px;
    color: #d7caf4;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    font-size: 9.5px;
    font-weight: 700;
  }

  .slug .icon { color: #ffd86f; }

  #listen {
    scroll-margin-top: calc(var(--header-h) + 18px);
  }

  .listen-modes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin-bottom: 26px;
  }

  .listen-mode {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 64px;
    padding: 12px 16px;
    color: var(--muted);
    border: 2px solid var(--ink);
    border-radius: var(--radius);
    background: var(--surface);
    text-align: left;
    cursor: pointer;
    transition: border-color 160ms ease, background 160ms ease, color 160ms ease;
  }

  .listen-mode .icon {
    flex: 0 0 auto;
    color: var(--violet-700);
  }

  .listen-mode span {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .listen-mode strong {
    color: var(--ink);
    font-size: 16px;
    line-height: 1.3;
  }

  .listen-mode small {
    color: var(--faint);
    font-size: 11px;
    line-height: 1.4;
  }

  .listen-mode:hover {
    border-color: var(--ink);
    background: var(--sun-wash);
  }

  .listen-mode.is-active {
    color: var(--ink);
    border-color: var(--ink);
    background: var(--sun-200);
    box-shadow: 0 3px 0 var(--ink);
  }

  .listen-mode.is-active .icon { color: var(--violet-700); }

  .missions {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 9px;
  }

  .mission {
    position: relative;
    padding: 15px;
    background: var(--surface);
  }

  .mission-num { position: absolute; right: 11px; top: 10px; color: var(--faint); font-family: var(--font-mono); font-size: 10px; }
  .mission-icon { display: grid; place-items: center; width: 34px; height: 34px; margin-bottom: 10px; color: var(--violet-700); border-radius: 11px; background: var(--violet-wash); }
  .mission h3 { margin: 0 0 4px; color: var(--ink); font-size: 15px; }
  .mission p { margin: 0; color: var(--muted); font-size: 11px; line-height: 1.6; }

  .artist-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }

  .artist-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 280px;
    padding: 18px;
    overflow: hidden;
    border-top: 3px solid var(--artist-accent, var(--violet-500));
    background: var(--surface);
  }

  .artist-card.has-photo::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: var(--artist-photo);
    background-position: center;
    background-size: cover;
    transform: scale(1.02);
    transition: transform 500ms ease;
    pointer-events: none;
  }

  .artist-card.has-photo:hover::before {
    transform: scale(1.06);
  }

  .artist-card.has-photo::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(10, 7, 28, 0.28) 0%, rgba(10, 7, 28, 0.62) 45%, rgba(10, 7, 28, 0.96) 100%),
      linear-gradient(90deg, rgba(10, 7, 28, 0.55) 0%, rgba(10, 7, 28, 0.12) 72%);
    pointer-events: none;
  }

  .artist-card > * {
    position: relative;
    z-index: 1;
  }

  .artist-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 8px;
  }

  .artist-card.has-photo .artist-top {
    justify-content: flex-end;
  }

  .artist-avatar {
    display: grid;
    place-items: center;
    width: 45px;
    height: 45px;
    color: #fff;
    border-radius: 14px;
    background: linear-gradient(145deg, #8b72ff, #4b2ab4);
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 900;
    transform: rotate(-3deg);
  }

  .artist-sky { color: #08243a; background: linear-gradient(145deg, #67d0fa, #216fa8); }
  .artist-pink { background: linear-gradient(145deg, #ff9fda, #b43c83); }
  .artist-mint { color: #052e27; background: linear-gradient(145deg, #7be9c4, #218a72); }
  .artist-sun { color: #40280b; background: linear-gradient(145deg, #ffe28d, #d18a2f); }
  .artist-coral { background: linear-gradient(145deg, #ff9d90, #bf4b4b); }

  .artist-country {
    padding: 3px 8px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    background: var(--surface-2);
    font-size: 10px;
    white-space: nowrap;
  }

  .artist-card.has-photo .artist-country {
    color: #fffaf0;
    border-color: rgba(255, 255, 255, 0.3);
    background: rgba(10, 7, 28, 0.45);
  }

  .artist-card h3 {
    margin: 11px 0 2px;
    color: var(--ink);
    font-size: 19px;
    line-height: 1.35;
  }

  .artist-card.has-photo h3 {
    color: #fffaf0;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.65);
  }

  .artist-keyword {
    margin: 0;
    color: var(--violet-700);
    font-size: 12px;
    font-weight: 800;
    line-height: 1.5;
  }

  .artist-card.has-photo .artist-keyword {
    color: #ffe7a8;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.6);
  }

  .artist-card details {
    margin-top: 8px;
    border: 0;
    border-top: 1px dashed var(--line);
    background: transparent;
  }

  .artist-card.has-photo details {
    border-top-color: rgba(255, 255, 255, 0.25);
  }

  .artist-card summary {
    display: flex;
    align-items: center;
    gap: 3px;
    min-height: 32px;
    padding: 8px 0 2px;
    color: var(--muted);
    font-size: 11px;
    font-weight: 750;
    list-style: none;
  }

  .artist-card.has-photo summary {
    color: rgba(255, 245, 230, 0.88);
  }

  .artist-card summary::-webkit-details-marker { display: none; }
  .artist-card summary .icon { margin-left: auto; transition: transform 150ms ease; }
  .artist-card details[open] summary .icon { transform: rotate(180deg); }

  .artist-card details p {
    margin: 7px 0 0;
    color: var(--ink-soft);
    font-size: 12px;
    line-height: 1.6;
  }

  .artist-card.has-photo details p {
    color: rgba(255, 245, 230, 0.92);
  }

  .artist-fun {
    display: flex;
    align-items: flex-start;
    gap: 4px;
    color: var(--muted) !important;
  }

  .artist-fun .icon {
    margin-top: 1px;
    color: var(--sun-700);
  }

  .artist-card.has-photo .artist-fun {
    color: rgba(255, 245, 230, 0.75) !important;
  }

  .artist-listen {
    min-height: 32px;
    margin-top: auto;
    padding-top: 10px;
    color: var(--violet-700);
    font-size: 11.5px;
    font-weight: 800;
    text-decoration: none;
  }

  .artist-card.has-photo .artist-listen {
    color: #ffd86f;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.65);
  }

  .artist-listen:hover {
    color: var(--violet-800);
  }

  .artist-card.has-photo .artist-listen:hover {
    color: #fff;
  }

  .artist-credits {
    margin-top: 16px;
    color: var(--muted);
    font-size: 10.5px;
    line-height: 1.55;
  }

  .artist-credits summary {
    cursor: pointer;
    color: var(--violet-700);
    font-weight: 800;
  }

  .artist-credits ul {
    display: grid;
    gap: 4px;
    margin: 8px 0 0;
    padding-left: 18px;
  }

  .artist-credits li {
    line-height: 1.5;
  }

  .artist-credits a {
    color: var(--violet-700);
    text-decoration: underline;
  }

  .artist-credits p {
    margin: 8px 0 0;
  }

  .artist-note { display: flex; align-items: center; gap: 15px; margin-top: 14px; }
  .artist-note :global(.mascot-bubble) { flex: 1; }

  #jukebox,
  #repertoire {
    scroll-margin-top: calc(var(--header-h) + 18px);
  }

  .rep-jump-row {
    display: flex;
    justify-content: flex-end;
    margin-top: 10px;
  }

  .rep-fold-body {
    padding: 0 18px 18px;
  }

  .folds { display: grid; gap: 9px; }
  .fold { padding: 0; overflow: hidden; background: var(--surface); }
  .fold summary { display: flex; align-items: center; gap: 8px; padding: 15px 17px; color: var(--ink); font-size: 14px; font-weight: 800; list-style: none; }
  .fold summary::-webkit-details-marker { display: none; }
  .fold summary > span:first-child { display: inline-flex; align-items: center; gap: 6px; }
  .fold summary > .icon { margin-left: auto; color: var(--faint); transition: transform 150ms ease; }
  .fold[open] summary > .icon { transform: rotate(180deg); }
  .fold-hint { margin-left: auto; color: var(--faint); font-size: 10px; }
  .composer-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 7px; padding: 0 17px 17px; }
  .composer-card { padding: 10px; border: 1px solid var(--line); border-radius: 10px; background: var(--surface-2); }
  .composer-card h3 { margin: 0; color: var(--ink); font-size: 13px; }
  .composer-card > span { color: var(--faint); font-family: var(--font-mono); font-size: 10px; }
  .composer-card p { margin: 6px 0 0; color: var(--muted); font-size: 10.5px; line-height: 1.55; }
  .composer-card small { display: flex; align-items: flex-start; gap: 3px; margin-top: 6px; padding-top: 5px; border-top: 1px dashed var(--line); color: var(--sun-700); font-size: 10px; line-height: 1.4; }
  .etiquette { display: grid; gap: 5px; padding: 0 17px 17px; }
  .etiquette p { display: flex; align-items: flex-start; gap: 8px; margin: 0; padding: 7px 0; border-bottom: 1px dashed var(--line); color: var(--ink-soft); font-size: 11px; line-height: 1.55; }
  .etiquette p:last-child { border-bottom: 0; }
  .etiquette b { color: var(--violet-700); font-family: var(--font-mono); font-size: 10px; }
  .privacy-note { display: flex; align-items: flex-start; gap: 5px; margin-top: 13px; color: var(--faint); font-size: 10.5px; line-height: 1.55; }
  .privacy-note .icon { margin-top: 1px; color: var(--violet-700); }
  .concert-bottom { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: clamp(22px, 4vw, 32px); border: 1.5px solid var(--line); border-radius: var(--radius-lg); background: var(--surface); box-shadow: var(--shadow); }
  .concert-bottom h2 { margin-top: 10px; font-size: clamp(23px, 3vw, 31px); }

  @media (max-width: 1100px) {
    .artist-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .missions { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 850px) {
    .artist-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .composer-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 600px) {
    .listen-modes { grid-template-columns: 1fr; }
    .missions, .artist-grid, .composer-grid { grid-template-columns: 1fr; }
    .artist-note, .concert-bottom { align-items: flex-start; flex-direction: column; }
    .fold-hint { display: none; }
  }

  html[data-theme="night"] .listen-mode {
    border-color: rgba(255, 246, 234, 0.2);
  }

  html[data-theme="night"] .listen-mode.is-active {
    border-color: rgba(255, 246, 234, 0.3);
    background: var(--sun-500);
    color: #2b2030;
    box-shadow: 0 3px 0 rgba(0, 0, 0, 0.3);
  }

  html[data-theme="night"] .listen-mode.is-active strong,
  html[data-theme="night"] .listen-mode.is-active .icon {
    color: #2b2030;
  }

  html[data-theme="night"] .listen-mode.is-active small {
    color: rgba(43, 32, 48, 0.72);
  }
</style>
