---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import SectionHead from "../../components/SectionHead.astro";
import MascotBubble from "../../components/MascotBubble.astro";
import Icon from "../../components/Icon.astro";
import { SITE } from "../../data/site";
---

<BaseLayout
  lang="fr"
  title="À propos"
  description="À propos de Love Classic Guitar : origine du projet, sources, confidentialité, droits et accessibilité."
>
  <PageHero
    kicker="À propos"
    title="Un petit monde<br />fait pour <em>une musicienne</em>."
    lead="Ce n'est pas une école officielle ni une plateforme payante. C'est un endroit calme, fabriqué pour une enfant de 7 ans et les adultes qui l'accompagnent."
  >
  </PageHero>

  <section class="section">
    <div class="container about-grid">
      <div>
        <SectionHead kicker="Pourquoi" title="Pourquoi ce site existe" lead="Les bons cours ne manquent pas, mais ils sont souvent dispersés, en anglais et un peu intimidants pour une enfant." />
        <p>Ici, on commence par une corde, un son, une posture confortable. Momo et Capi rappellent qu'on peut avancer sans se presser.</p>
        <p>Le parcours, les exercices et les ressources s'inspirent de méthodes publiques et de pratiques courantes. Chaque enfant reste différent : un professeur doit adapter la taille, le rythme et les morceaux.</p>
        <MascotBubble who="momo" title="Le mot de Momo" text="Si ce site t'aide seulement à pincer une corde aujourd'hui, il aura déjà fait son travail." tone="violet" />
      </div>
      <div class="about-card card">
        <h3>Les principes</h3>
        <ul>
          <li>Pas de classement, pas de publicité, pas de pression.</li>
          <li>Des outils interactifs avant de longs discours.</li>
          <li>Le son et l'écoute avant la performance.</li>
          <li>Une place pour les adultes, sans leur demander de devenir guitaristes.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section-wash">
    <div class="container">
      <SectionHead kicker="Confidentialité & droits" title="Simple et transparent" />
      <div class="columns">
        <div class="info card">
          <h3>Confidentialité</h3>
          <p>Pas de compte, de commentaire, d'analyse d'audience ni de suivi entre sites. Le prénom, les missions et les séances restent dans le stockage local du navigateur.</p>
          <p>Les vidéos sont lues dans un lecteur YouTube intégré (youtube-nocookie.com). Le navigateur se connecte à YouTube lorsque le lecteur arrive à l'écran ; les règles de confidentialité de YouTube s'appliquent ensuite, et des recommandations ou publicités peuvent apparaître.</p>
        </div>
        <div class="info card">
          <h3>Droits</h3>
          <p>Les textes, illustrations, fiches et interactions originales sont sous licence CC BY-NC-SA 4.0. Le code est sous licence MIT.</p>
          <p>Les vidéos, méthodes, partitions et marques externes appartiennent à leurs auteurs. Le site ne distribue pas de PDF commercial protégé.</p>
        </div>
        <div class="info card">
          <h3>Accessibilité</h3>
          <p>Navigation au clavier, libellés explicites, contrastes vérifiés de jour comme de nuit, animations réduites si le système le demande.</p>
          <p>Ce n'est pas une certification officielle. Si quelque chose ne va pas, le dépôt GitHub est ouvert aux retours.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead kicker="Sources" title="Quelques ressources de référence" lead="Les liens sont des portes vers les auteurs ; ils ne valent pas approbation." />
      <div class="sources">
        <a href="https://www.thisisclassicalguitar.com/" target="_blank" rel="noopener noreferrer">This is Classical Guitar <Icon name="external" size={11} /></a>
        <a href="https://classicalguitarshed.com/" target="_blank" rel="noopener noreferrer">Classical Guitar Shed <Icon name="external" size={11} /></a>
        <a href="https://www.classicalguitarcorner.com/" target="_blank" rel="noopener noreferrer">Classical Guitar Corner <Icon name="external" size={11} /></a>
        <a href="https://imslp.org/wiki/Category:For_guitar" target="_blank" rel="noopener noreferrer">IMSLP <Icon name="external" size={11} /></a>
        <a href="https://www.mutopiaproject.org/" target="_blank" rel="noopener noreferrer">Mutopia Project <Icon name="external" size={11} /></a>
        <a href={SITE.repo} target="_blank" rel="noopener noreferrer">GitHub <Icon name="external" size={11} /></a>
      </div>
      <p class="updated">Mise à jour : {SITE.updated} · Site réalisé avec Astro, hébergé sur GitHub Pages.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .slug { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 20px; }
  .slug span { display: inline-flex; align-items: center; gap: 4px; padding: 5px 9px; color: #d7caf4; border: 1px solid rgba(255, 255, 255, 0.14); border-radius: 999px; background: rgba(255, 255, 255, 0.06); font-size: 9.5px; font-weight: 700; }
  .slug .icon { color: #ffd86f; }

  .about-grid { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(280px, 0.8fr); gap: 30px; align-items: start; }
  .about-grid > div > p { margin: 0 0 10px; color: var(--ink-soft); font-size: 12px; line-height: 1.8; }
  .about-grid :global(.mascot-bubble) { margin-top: 15px; }
  .about-card { padding: 20px; background: var(--surface); }
  .about-card h3 { margin: 0 0 10px; color: var(--ink); font-size: 18px; }
  .about-card ul { display: grid; gap: 7px; margin: 0; padding: 0; list-style: none; }
  .about-card li { padding-left: 12px; color: var(--ink-soft); font-size: 10px; line-height: 1.6; position: relative; }
  .about-card li::before { content: "✦"; position: absolute; left: 0; top: 0; color: var(--violet-500); font-size: 7px; }

  .columns { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
  .info { padding: 18px; background: var(--surface); }
  .info h3 { margin: 0 0 7px; color: var(--ink); font-size: 16px; }
  .info p { margin: 0 0 9px; color: var(--muted); font-size: 9.5px; line-height: 1.7; }
  .info p:last-child { margin-bottom: 0; }

  .sources { display: flex; flex-wrap: wrap; gap: 8px; }
  .sources a { display: inline-flex; align-items: center; gap: 4px; padding: 6px 9px; color: var(--violet-700); border: 1px solid var(--line); border-radius: 999px; background: var(--surface); font-size: 9px; font-weight: 750; text-decoration: none; }
  .sources a:hover { background: var(--violet-wash); }
  .updated { margin-top: 13px; color: var(--faint); font-size: 8px; }

  @media (max-width: 900px) {
    .about-grid { grid-template-columns: 1fr; }
    .columns { grid-template-columns: 1fr; }
  }
</style>
