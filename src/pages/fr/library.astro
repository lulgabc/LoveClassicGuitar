---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import SectionHead from "../../components/SectionHead.astro";
import MascotBubble from "../../components/MascotBubble.astro";
import Icon from "../../components/Icon.astro";
import {
  BOOKS_FR,
  CHANNELS_FR,
  CHOOSE_TIPS_FR,
  EXAM_BOARDS_FR,
  FR_KINDS,
  RESOURCES_FR,
  SHEET_SOURCES_FR,
  STARTER_PATHS_FR,
} from "../../data/fr/library";
import { url } from "../../lib/url";
---

<BaseLayout
  lang="fr"
  title="Les ressources"
  description="Cours de guitare gratuits, chaînes YouTube, partitions du domaine public, livres et examens : une sélection pour débuter sans se perdre."
>
  <PageHero
    kicker="La bibliothèque"
    title="Des portes,<br />pas une <em>montagne</em>."
    lead="Cours gratuits, chaînes YouTube, méthodes, partitions et examens réunis au même endroit. Choisis une seule porte, le reste viendra plus tard."
  >
  </PageHero>

  <section class="section">
    <div class="container">
      <div class="starter-paths">
        {
          STARTER_PATHS_FR.map((path) => (
            <a class:list={["starter-path", "card", "card-hover", `starter-${path.color}`]} href={path.href} target="_blank" rel="noopener noreferrer">
              <span class="starter-icon"><Icon name={path.icon} size={21} /></span>
              <span class="starter-label">{path.label}</span>
              <h2>{path.title}</h2>
              <p>{path.text}</p>
              <span class="starter-link">Commencer ici <Icon name="external" size={12} /></span>
            </a>
          ))
        }
      </div>

      <div class="library-intro-note">
        <MascotBubble
          who="momo"
          title="Momo te dit"
          text="Une bibliothèque pleine ne fait pas avancer plus vite. Aujourd'hui, choisis un lien, regarde cinq minutes, puis va pincer une corde."
          tone="violet"
        />
        <div class="library-legend">
          <span><span class="pill pill-free">Gratuit</span> sans payer</span>
          <span><span class="pill pill-paid">Payant</span> achat ou abonnement</span>
          <span><Icon name="external" size={12} /> site externe / YouTube</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-wash" id="resources">
    <div class="container">
      <SectionHead
        kicker="01 · Cours & sites"
        title="Choisis d'abord <em>une seule</em> porte"
        lead="Filtre par type, langue ou gratuité. La recherche accepte aussi « enfant », « partition » ou « chinois »."
      />
      <div class="library-toolbar">
        <label class="search-box"><Icon name="search" size={17} /><span class="sr-only">Chercher une ressource</span><input type="search" placeholder="Cours, partition, chaîne…" data-fr-search /></label>
        <label class="free-toggle"><input type="checkbox" data-fr-free /><span class="toggle-track"><span></span></span><span>Gratuit seulement</span></label>
        <span class="result-count"><strong data-fr-count>{RESOURCES_FR.length}</strong> résultats</span>
      </div>
      <div class="kind-filters" role="group" aria-label="Filtrer par type">
        {FR_KINDS.map((kind, index) => <button type="button" class:list={["kind-chip", { "is-active": index === 0 }]} data-fr-kind={kind} aria-pressed={index === 0 ? "true" : "false"}>{kind}</button>)}
      </div>
      <div class="resource-grid">
        {RESOURCES_FR.map((resource) => (
          <a
            class="resource-card card card-hover"
            href={resource.url}
            target="_blank"
            rel="noopener noreferrer"
            data-fr-resource
            data-kind={resource.kind}
            data-free={resource.price !== "Payant" ? "true" : "false"}
            data-search={`${resource.name} ${resource.description} ${resource.tags.join(" ")} ${resource.level}`.toLowerCase()}
          >
            <div class="resource-top"><span class="kind-icon"><Icon name={resource.kind === "YouTube" ? "youtube" : resource.kind === "Partitions" ? "book" : resource.kind === "Examens" ? "trophy" : resource.kind === "Écoute" ? "headphones" : "compass"} size={18} /></span><span class:list={["pill", resource.price === "Payant" ? "pill-paid" : "pill-free"]}>{resource.price}</span></div>
            <span class="resource-kind">{resource.kind} · {resource.lang}</span>
            <h3>{resource.name}</h3>
            <p>{resource.description}</p>
            <div class="resource-tags">{resource.tags.map((tag) => <span>{tag}</span>)}</div>
            {resource.note && <p class="resource-note"><Icon name="info" size={11} /> {resource.note}</p>}
            <span class="resource-cta">Ouvrir <Icon name="external" size={11} /></span>
          </a>
        ))}
      </div>
      <p class="empty" data-fr-empty hidden>Aucun résultat. Essaie un mot plus court ou enlève le filtre.</p>
    </div>
  </section>

  <section class="section" id="channels">
    <div class="container">
      <SectionHead
        kicker="02 · Chaînes YouTube"
        title="Des chaînes gratuites <em>à suivre</em>"
        lead="Pas besoin de tout suivre. Une chaîne principale, une chaîne de concerts, et au maximum une chaîne pour enfants."
      />
      <details class="content-fold">
        <summary>Ouvrir les {CHANNELS_FR.length} chaînes gratuites</summary>
        <div class="content-fold-body">
          <div class="channels-grid">
            {CHANNELS_FR.map((channel) => (
              <a class="channel-card card card-hover" href={channel.url} target="_blank" rel="noopener noreferrer">
                <div class="channel-top">
                  <span class="channel-icon"><Icon name="youtube" size={20} /></span>
                  <span class:list={["pill", channel.price === "Gratuit" ? "pill-free" : "pill-paid"]}>{channel.price}</span>
                  {channel.featured && <span class="channel-star"><span class="sr-only">Sélection</span><Icon name="star" size={13} /></span>}
                </div>
                <span class="channel-focus">{channel.focus}</span>
                <h3>{channel.name}</h3>
                <p class="channel-handle">{channel.handle} · {channel.lang}</p>
                <p class="channel-desc">{channel.description}</p>
                <p class="channel-best"><strong>Pour :</strong> {channel.bestFor}</p>
                {channel.note && <p class="channel-note"><Icon name="info" size={12} /> {channel.note}</p>}
                <span class="channel-link">Voir la chaîne <Icon name="external" size={12} /></span>
              </a>
            ))}
          </div>
          <div class="channels-note">
            <Icon name="info" size={15} />
            <p>YouTube peut afficher des publicités et des recommandations selon les pays. Un adulte peut accompagner l'enfant ou activer un mode adapté ; évite la lecture automatique comme fond sonore.</p>
          </div>
        </div>
      </details>
    </div>
  </section>

  <section class="section section-wash" id="books">
    <div class="container">
      <SectionHead
        kicker="03 · Livres & méthodes"
        title="Un seul livre, <em>bien travaillé</em>"
        lead="Des méthodes du domaine public et des ouvrages modernes pour les parents ou le professeur. Aucun lien d'affiliation."
      />
      <details class="content-fold">
        <summary>Ouvrir les {BOOKS_FR.length} livres</summary>
        <div class="content-fold-body">
          <div class="books-grid">
            {BOOKS_FR.map((book) => (
              <article class="book-card card book-violet">
                <div class="book-top">
                  <span class="book-kind">Livre</span>
                  <span class={book.free ? "pill pill-free" : "pill pill-paid"}>{book.free ? "Libre / gratuit" : "Achat / emprunt"}</span>
                </div>
                <h3>{book.title}</h3>
                <p class="book-author">{book.author} · {book.level}</p>
                <p class="book-desc">{book.description}</p>
                <p class="book-why"><strong>Pourquoi le lire :</strong>{book.note}</p>
                {book.link ? (
                  <a class="book-link" href={book.link} target="_blank" rel="noopener noreferrer">Ouvrir la partition libre <Icon name="external" size={12} /></a>
                ) : (
                  <span class="book-where">À chercher en bibliothèque ou en librairie spécialisée</span>
                )}
              </article>
            ))}
          </div>
          <div class="copyright-note">
            <Icon name="shield" size={18} />
            <div><strong>À propos des méthodes et des partitions</strong><p>Les œuvres du domaine public peuvent être lues et imprimées sur IMSLP, mais les éditions modernes, doigtés, traductions et méthodes commerciales restent protégés. Ne diffuse pas de PDF pirate. Si un professeur demande un livre, achète-le ou emprunte-le.</p></div>
          </div>
        </div>
      </details>
    </div>
  </section>

  <section class="section" id="scores">
    <div class="container">
      <SectionHead
        kicker="04 · Partitions"
        title="La bonne façon d'ouvrir <em>une partition gratuite</em>"
        lead="Vérifie d'abord les droits et l'édition, puis demande au professeur d'adapter la difficulté et les doigtés. Une partition du web n'est pas toujours faite pour de petites mains."
      />
      <div class="sheet-grid">
        {
          SHEET_SOURCES_FR.map((source, index) => (
            <a class="sheet-card card card-hover" href={source.url} target="_blank" rel="noopener noreferrer">
              <span class="sheet-number">{String(index + 1).padStart(2, "0")}</span>
              <div class="sheet-copy"><h3>{source.name}</h3><p>{source.description}</p><div class="sheet-tags">{source.tags.map((tag) => <span>{tag}</span>)}</div></div>
              <Icon name="external" size={14} />
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-wash" id="exams">
    <div class="container">
      <SectionHead
        kicker="05 · Examens (facultatif)"
        title="Un examen est un repère, <em>pas un trophée</em>"
        lead="Si l'enfant aime les objectifs clairs, un examen peut donner un répertoire et un cap. Ce n'est ni obligatoire ni un remplacement des bases, du plaisir et de la santé."
      />
      <details class="content-fold">
        <summary>Ouvrir les {EXAM_BOARDS_FR.length} systèmes d'examen</summary>
        <div class="content-fold-body">
          <div class="exam-grid">
            {
              EXAM_BOARDS_FR.map((exam, index) => (
                <article class="exam-card card">
                  <span class="exam-number">{String(index + 1).padStart(2, "0")}</span>
                  <span class="exam-label">MUSIQUE GRADUÉE</span>
                  <h3>{exam.name}</h3>
                  <p class="exam-what">{exam.what}</p>
                  <p class="exam-why"><strong>Bénéfices possibles :</strong>{exam.why}</p>
                  <p class="exam-caveat"><Icon name="info" size={12} /> {exam.caveat}</p>
                  <a href={exam.url} target="_blank" rel="noopener noreferrer">Voir le site <Icon name="external" size={12} /></a>
                </article>
              ))
            }
          </div>
          <div class="exam-note">
            <MascotBubble who="capi" title="Capi te rappelle" text="Si l'examen te donne envie de ne plus toucher la guitare, ne le passe pas. La musique est longue ; un certificat ne remplace pas l'écoute." tone="sun" />
            <a class="btn btn-ghost" href={url("/fr/parents/#teacher")}>Parler des objectifs avec le professeur <Icon name="arrow-right" size={13} /></a>
          </div>
        </div>
      </details>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Bien choisir"
        title="Cette ressource est-elle <em>pour nous ?</em>"
        lead="Gratuit n'est pas le seul critère, et cher ne garantit rien. Ces six questions valent mieux qu'une recommandation."
      />
      <div class="choose-grid">
        {CHOOSE_TIPS_FR.map((tip, index) => <div class="choose-item"><span>{String(index + 1).padStart(2, "0")}</span><p>{tip}</p></div>)}
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container library-bottom">
      <div><span class="eyebrow"><Icon name="sparkle" size={13} /> Tu as choisi ?</span><h2>Ferme les favoris,<br />va pincer ta première corde.</h2></div>
      <div class="btn-row"><a class="btn btn-primary" href={url("/fr/practice/")}>Aller au studio <Icon name="arrow-right" size={14} /></a><a class="btn btn-ghost" href={url("/fr/roadmap/")}>Voir le parcours</a></div>
    </div>
  </section>
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>("[data-fr-resource]")?.closest("section");
  if (root) {
    const search = root.querySelector<HTMLInputElement>("[data-fr-search]");
    const free = root.querySelector<HTMLInputElement>("[data-fr-free]");
    const chips = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-fr-kind]"));
    const items = Array.from(root.querySelectorAll<HTMLElement>("[data-fr-resource]"));
    const count = root.querySelector<HTMLElement>("[data-fr-count]");
    const empty = root.querySelector<HTMLElement>("[data-fr-empty]");
    let kind = "Tous";

    function apply(): void {
      const query = (search?.value ?? "").trim().toLowerCase();
      const onlyFree = free?.checked ?? false;
      let visible = 0;
      items.forEach((item) => {
        const show = (kind === "Tous" || item.dataset.kind === kind) && (!onlyFree || item.dataset.free === "true") && (!query || (item.dataset.search ?? "").includes(query));
        item.hidden = !show;
        if (show) visible += 1;
      });
      if (count) count.textContent = String(visible);
      if (empty) empty.hidden = visible !== 0;
    }

    chips.forEach((chip) => chip.addEventListener("click", () => {
      kind = chip.dataset.frKind ?? "Tous";
      chips.forEach((item) => {
        const active = item === chip;
        item.classList.toggle("is-active", active);
        item.setAttribute("aria-pressed", String(active));
      });
      apply();
    }));
    search?.addEventListener("input", apply);
    free?.addEventListener("change", apply);
    apply();
  }
</script>

<style>
  .slug {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 20px;
  }

  .slug span {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 5px 9px;
    color: #d7caf4;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    font-size: 9.5px;
    font-weight: 700;
  }

  .slug .icon { color: #ffd86f; }

  .starter-paths {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .starter-path {
    display: flex;
    flex-direction: column;
    padding: 20px;
    color: var(--ink);
    text-decoration: none;
    background:
      radial-gradient(circle at 95% 0%, var(--starter-soft), transparent 28%),
      var(--surface);
  }

  .starter-path:hover { color: var(--ink); }

  .starter-icon {
    display: grid;
    place-items: center;
    width: 43px;
    height: 43px;
    color: var(--starter-ink);
    border-radius: 14px;
    background: var(--starter-bg);
    box-shadow: 0 3px 0 var(--starter-shadow);
    transform: rotate(-3deg);
  }

  .starter-label {
    margin-top: 17px;
    color: var(--starter-ink);
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .starter-path h2 {
    margin: 3px 0 5px;
    color: var(--ink);
    font-size: 21px;
  }

  .starter-path p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 12px;
    line-height: 1.65;
  }

  .starter-link {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    margin-top: auto;
    padding-top: 14px;
    color: var(--starter-ink);
    font-size: 10.5px;
    font-weight: 850;
  }

  .starter-violet { --starter-ink: var(--violet-700); --starter-bg: var(--violet-wash); --starter-soft: rgba(116, 87, 242, 0.1); --starter-shadow: rgba(102, 74, 215, 0.16); }
  .starter-sky { --starter-ink: var(--sky-700); --starter-bg: var(--sky-wash); --starter-soft: rgba(93, 202, 250, 0.1); --starter-shadow: rgba(65, 165, 205, 0.16); }
  .starter-coral { --starter-ink: #a44538; --starter-bg: var(--coral-wash); --starter-soft: rgba(255, 139, 123, 0.1); --starter-shadow: rgba(194, 86, 71, 0.16); }

  html[data-theme="night"] .starter-coral { --starter-ink: var(--coral-500); }

  .library-intro-note {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-top: 15px;
  }

  .library-intro-note :global(.mascot-bubble) { flex: 1; }

  .library-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 7px 13px;
    flex: 0 0 auto;
    max-width: 260px;
    color: var(--faint);
    font-size: 10px;
  }

  .library-legend span {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .library-toolbar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 9px;
    margin-bottom: 10px;
  }

  .search-box {
    display: flex;
    align-items: center;
    gap: 7px;
    flex: 1 1 280px;
    min-width: 0;
    min-height: 44px;
    padding: 0 13px;
    color: var(--muted);
    border: 1.5px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
  }

  .search-box:focus-within { border-color: var(--violet-500); box-shadow: 0 0 0 3px var(--violet-wash); }
  .search-box input { flex: 1; min-width: 0; min-height: 39px; padding: 0; color: var(--ink); border: 0; outline: 0; background: transparent; font-size: 12px; }
  .search-box input::placeholder { color: var(--faint); }

  .free-toggle { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; color: var(--muted); font-size: 11px; font-weight: 700; cursor: pointer; }
  .free-toggle input { position: absolute; width: 1px; height: 1px; opacity: 0; }
  .toggle-track { position: relative; width: 31px; height: 18px; border-radius: 999px; background: var(--surface-3); transition: background 150ms ease; }
  .toggle-track span { position: absolute; left: 2px; top: 2px; width: 14px; height: 14px; border-radius: 50%; background: var(--surface); box-shadow: 0 1px 3px rgba(35, 19, 80, 0.22); transition: transform 150ms ease; }
  .free-toggle input:checked + .toggle-track { background: var(--mint-500); }
  .free-toggle input:checked + .toggle-track span { transform: translateX(13px); }
  .free-toggle input:focus-visible + .toggle-track { outline: 3px solid var(--sun-500); outline-offset: 2px; }
  .result-count { margin-left: auto; color: var(--faint); font-family: var(--font-mono); font-size: 10.5px; }
  .result-count strong { color: var(--violet-700); }

  .kind-filters { display: flex; flex-wrap: wrap; gap: 4px; margin-bottom: 15px; }
  .kind-chip { min-height: 44px; padding: 5px 11px; color: var(--muted); border: 1px solid var(--line); border-radius: 999px; background: var(--surface); font-size: 11px; font-weight: 750; }
  .kind-chip.is-active { color: #fff; border-color: #5b3fd4; background: #5b3fd4; }

  .resource-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
  .resource-card { display: flex; flex-direction: column; padding: 16px; color: var(--ink); text-decoration: none; background: var(--surface); }
  .resource-card:hover { color: var(--ink); }
  .resource-top { display: flex; align-items: center; gap: 7px; }
  .kind-icon { display: grid; place-items: center; width: 36px; height: 36px; color: var(--violet-700); border-radius: 12px; background: var(--violet-wash); }
  .resource-top .pill { margin-left: auto; }
  .resource-kind { margin-top: 10px; color: var(--violet-700); font-family: var(--font-mono); font-size: 10px; font-weight: 800; text-transform: uppercase; }
  .resource-card h3 { margin: 3px 0 6px; color: var(--ink); font-size: 15px; line-height: 1.4; }
  .resource-card > p { margin: 0; color: var(--muted); font-size: 11px; line-height: 1.6; }
  .resource-tags { display: flex; flex-wrap: wrap; gap: 3px; margin-top: 8px; }
  .resource-tags span { padding: 2px 5px; color: var(--faint); background: var(--surface-2); border-radius: 999px; font-size: 10px; }
  .resource-note { display: flex; align-items: flex-start; gap: 3px; margin-top: 7px !important; color: var(--faint) !important; font-size: 10px !important; line-height: 1.5 !important; }
  .resource-cta { display: inline-flex; align-items: center; gap: 3px; margin-top: auto; padding-top: 11px; color: var(--violet-700); font-size: 10.5px; font-weight: 850; }
  .empty { padding: 25px 0; color: var(--muted); text-align: center; font-size: 12px; }

  .channels-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 11px;
  }

  .channel-card {
    display: flex;
    flex-direction: column;
    padding: 16px;
    color: var(--ink);
    text-decoration: none;
    height: 100%;
    background:
      radial-gradient(circle at 95% 0%, rgba(255, 139, 123, 0.1), transparent 26%),
      var(--surface);
  }

  .channel-card:hover { color: var(--ink); }
  .channel-top { display: flex; align-items: center; gap: 6px; }
  .channel-icon { display: grid; place-items: center; flex: 0 0 37px; width: 37px; height: 37px; color: #a53d34; border-radius: 12px; background: var(--coral-wash); transform: rotate(-3deg); }
  .channel-star { margin-left: auto; color: var(--sun-700); }
  .channel-focus { display: block; margin-top: 12px; color: var(--coral-500); font-family: var(--font-mono); font-size: 10px; font-weight: 800; letter-spacing: 0.05em; text-transform: uppercase; }
  .channel-card h3 { margin: 3px 0 1px; color: var(--ink); font-size: 17px; line-height: 1.4; }
  .channel-handle { margin: 0; color: var(--faint); font-family: var(--font-mono); font-size: 10.5px; line-height: 1.5; }
  .channel-desc { margin: 8px 0 0; color: var(--ink-soft); font-size: 12px; line-height: 1.65; }
  .channel-best { margin: 8px 0 0; color: var(--muted); font-size: 11px; line-height: 1.55; }
  .channel-best strong { color: var(--ink-soft); }
  .channel-note { display: flex; align-items: flex-start; gap: 4px; margin: 8px 0 0; color: var(--faint); font-size: 10.5px; line-height: 1.55; }
  .channel-note .icon { margin-top: 1px; }
  .channel-link { display: inline-flex; align-items: center; gap: 4px; margin-top: auto; padding-top: 11px; color: #a53d34; font-size: 11.5px; font-weight: 850; }

  html[data-theme="night"] .channel-link,
  html[data-theme="night"] .channel-icon { color: var(--coral-500); }

  .channels-note {
    display: flex;
    align-items: flex-start;
    gap: 7px;
    margin-top: 14px;
    padding: 10px 13px;
    border: 1px dashed var(--line-strong);
    border-radius: 11px;
    color: var(--muted);
    font-size: 10.5px;
